@using Nop.Plugin.Misc.Nexport.Models.Wholesale

@model Nop.Plugin.Misc.Nexport.Models.Wholesale.RedeemProduct.CustomerStepListSearchModel

<div class="section">
    <h4>
        Select a customer from the list below to redeem instantly for
    </h4>
    <input asp-for="SearchEmail" type="hidden" />
    <button id="search-nexport-users" type="button" style="display:none">test</button>
</div>
<div class="section">
    @await Html.PartialAsync("~/Plugins/Misc.Nexport/Views/Shared/Table.cshtml", new DataTablesModel
    {
        Name = "matching-users-grid",
        UrlRead = new DataUrl(Url.Action("GetMatchingUsers", "NexportWholesale")),
        Length = Model.PageSize,
        LengthMenu = Model.AvailablePageSizes,
        SearchButtonId = "search-nexport-users",
        Filters = new List<FilterParameter>
        {
            new FilterParameter(nameof(Model.SearchEmail)),
        },
        ColumnCollection = new List<ColumnProperty>
        {
            new ColumnProperty(nameof(NexportUserModel.UserId))
            {
                Encode=false,
                Render = new RenderCustom("RenderRadio")
            },
            new ColumnProperty(nameof(NexportUserModel.FirstName))
            {
                Title = "Name",
                Encode = false,
                Render = new RenderCustom("RenderName")
            },
            new ColumnProperty(nameof(NexportUserModel.Email))
            {
                Title = "Email",
                Encode = false
            },
            new ColumnProperty(nameof(NexportUserModel.OwnerOrg))
            {
                Title = "Owner Org",
                Encode = false
            }
        }
    })
</div>
<div class="section">
    <h4>Or check the box below to allow the customer to redeem via email </h4>
    <input type="checkbox" asp-for="CustomerStepSendViaEmail" onclick="SendViaEmailClicked(this)"  />
    <span asp-validation-for="CustomerStepSendViaEmail" style="margin-top: 20px"></span>
    <input type="hidden" asp-for="SelectedUserId" />
    <input type="hidden" asp-for="SelectedUserFirstName" />
    <input type="hidden" asp-for="SelectedUserLastName" />
</div>
<script>
    function SendViaEmailClicked(box)
    {
        if(box.checked){
            $("input:radio[name='select-nexport-user']").each(function (i) {
                this.checked = false;
            });
            $("#SelectedUserId").val(null);
        }
    }
    function SelectedUserClicked(radio)
    {
        if(radio.checked){
            $("#CustomerStepSendViaEmail").prop("checked", false);
            $("#SelectedUserId").val(radio.dataset.userId);
            $("#SelectedUserFirstName").val(radio.dataset.firstName);
            $("#SelectedUserLastName").val(radio.dataset.lastName);
        }
    }
    function RenderName(data, type, row, meta) {
        if ("@Model.UserLinkUri".includes("Account/Info.nex?user="))
        {
            return "<a title=\"Nexport user id:"+row.UserId+"\" target=\"_blank\" href=\"" + "@(Model.UserLinkUri)"+row.UserId+"\">"+row.FirstName + " " + row.LastName+"</a>";
        }

       return "";
    }
    function RenderRadio(data, type, row, meta) {
        return "<input type=\"radio\" name=\"select-nexport-user\" onclick=\"SelectedUserClicked(this)\" data-control=\"nexport-user-selection\" data-user-id=\"" + row.UserId + "\" data-first-name=\"" + row.FirstName + "\" data-last-name=\"" + row.LastName + "\">"
    }
    

</script>