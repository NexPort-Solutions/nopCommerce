@model Nop.Plugin.Misc.Nexport.Models.Organization.OrganizationListModel

@{
    var orgs = Model.Organizations.Select(organization => new SelectListItem
    {
        Text = $"{organization.Name} ({organization.ShortName})",
        Value = organization.OrgId.ToString(CultureInfo.InvariantCulture)
    }).ToList();
    orgs.Insert(0, new SelectListItem
    {
        Text = "Select the organization to view the catalogs",
        Value = null
    });
}

<div class="form-group row">
    <div class="col-md-12 organization-selection">
        <div class="float-left" style="padding-right: 1em;">
            <label style="padding-top: 9px;">
                Organization
            </label>
        </div>
        <nop-select asp-for-name="nexport-organization-list" asp-items="@orgs" style="width: 100%; max-width: 350px;" />
    </div>
</div>