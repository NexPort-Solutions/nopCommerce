@using Nop.Plugin.Misc.Nexport.Areas.Admin.Controllers;
@using Nop.Plugin.Misc.Nexport.Domain.Enums
@using Nop.Plugin.Misc.Nexport.Extensions;

@model Nop.Plugin.Misc.Nexport.Models.Stores.StoreModel

@if (Model.Id > 0)
{
    NopHtml.AddScriptParts(ResourceLocation.Footer, "~/Plugins/Misc.Nexport/Scripts/bootstrap3-typeahead.js", "", true);

    <div class="card card-default">
        <div class="card-header">
            NexPort Integration Configuration
        </div>
        <div class="card-body">
            <div class="card card-default">
                <div class="card-header">
                    NexPort Product Display Configuration
                </div>
                <div class="card-body">
                    <div class="form-group row">
                        <div class="col-md-3">
                            <nop-label asp-for="HideSectionCEUsInProductPage" />
                        </div>
                        <div class="col-md-9">
                            <nop-editor asp-for="HideSectionCEUsInProductPage" asp-required="false" />
                        </div>
                    </div>
                    <div class="form-group row">
                        <div class="col-md-3">
                            <nop-label asp-for="HideAddToCartForIneligibleProducts" />
                        </div>
                        <div class="col-md-9">
                            <nop-editor asp-for="HideAddToCartForIneligibleProducts" asp-required="false" />
                        </div>
                    </div>
                </div>
            </div>

            <div class="card card-default">
                <div class="card-header">
                    NexPort Repurchasing Configuration
                </div>
                <div class="card-body">
                    <div class="form-group row">
                        <div class="col-md-3">
                            <nop-label asp-for="AllowRepurchaseFailedCourses" />
                        </div>
                        <div class="col-md-9">
                            <nop-editor asp-for="AllowRepurchaseFailedCourses" asp-required="false" />
                        </div>
                    </div>
                    <div class="form-group row">
                        <div class="col-md-3">
                            <nop-label asp-for="AllowRepurchasePassedCourses" />
                        </div>
                        <div class="col-md-9">
                            <nop-editor asp-for="AllowRepurchasePassedCourses" asp-required="false" />
                        </div>
                    </div>

                </div>
            </div>
        </div>
        <div class="card-footer text-right">
            <button id="saveStoreConfig" name="savenexportstoreconfig" class="btn btn-info">
                Save
            </button>
        </div>
    </div>

    <div class="card card-default">
        <div class="card-header">
            NexPort Organization Subscription
        </div>
        <div class="card-body">
            <div class="form-group row">
                <div class="col-md-3">
                    <nop-label asp-for="SubscriptionOrgId" />
                </div>
                <div class="col-md-9">
                    <div class="input-group">
                        <nop-editor asp-for="SubscriptionOrgId" asp-required="false" asp-render-form-control-class="true"
                                    asp-template="GuidNullable"/>
                        <div class="input-group-append">
                            <button id="setSubscriptionOrgId" name="setsubscriptionorgid" class="btn btn-info">
                                Set
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
        $(document).ready(function () {
            $.fn.bootstrapTypeahead = $.fn.typeahead.noConflict();

            window.query_cache = {};

            $("#SubscriptionOrgId").bootstrapTypeahead({
                source: function(query, process) {
                    if (query_cache[query]) {
                        process(query_cache[query]);
                        return;
                    }

                    if (typeof searching != "undefined") {
                        clearTimeout(searching);
                        process([]);
                    }

                    var url = "@Url.Action(nameof(IntegrationController.SearchDirectory), ViewUtilities.GetControllerName<IntegrationController>())";
                    searching = setTimeout(function() {
                        return $.getJSON(
                            url,
                            { searchTerm: query },
                            function(data) {
                                // save result to cache, remove next line if you don't want to use cache
                                query_cache[query] = data;
                                // only search if stop typing for 300ms aka fast typers
                                return process(data);
                            }
                        );
                    }, 300);
                },
                matcher: function(item) {
                    var orgName = item.name;
                    var orgShortName = item.short_name;
                    var isMatch = orgName.toLowerCase().indexOf(this.query.toLowerCase());
                    if (~isMatch)
                        return true;

                    return ~orgShortName.toLowerCase().indexOf(this.query.toLowerCase());
                },
                autoSelect: false,
                fitToElement: true,
                displayText: function(item) {
                    return item.name;
                },
                afterSelect: function(selectedItem) {
                    $("#SubscriptionOrgId").val(selectedItem.id);
                }
            });
        });
    </script>
}