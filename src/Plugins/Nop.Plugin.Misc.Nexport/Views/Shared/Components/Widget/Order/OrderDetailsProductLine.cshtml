@using Nop.Plugin.Misc.Nexport.Services
@using Nop.Services.Orders
@using Nop.Core.Domain.Orders

@inject IOrderService orderService
@inject InvoiceService invoiceService
@inject IStoreContext storeContext

@model Nop.Web.Models.Order.OrderDetailsModel.OrderItemModel

@if (Model is { Id: > 0 }
    && await orderService.GetOrderItemByIdAsync(Model.Id) is { } orderItem
    && await orderService.GetOrderByIdAsync(orderItem.OrderId) is { OrderStatus: OrderStatus.Complete }
    && await invoiceService.FindOrderInvoiceItem(orderItem.OrderId, orderItem.Id) is { } orderInvoice)
{
    var popupTitle = "";
    if (orderInvoice.UtcDateRedemption is not null)
    {
        <a href="javascript:void(0);" data-id="view-redemption-link" data-nexport-order-invoice-id="@orderInvoice.Id">
            (@T("Plugins.Misc.Nexport.Order.ViewRedemption"))
        </a>
        popupTitle = T("Plugins.Misc.Nexport.Order.ViewRedemption").Text;
    }
    else
    {
        <input type="hidden" id="redeemCompleted" data-redeemed=false />
        <a href="javascript:void(0);" data-id="view-redemption-link" data-nexport-order-invoice-id="@orderInvoice.Id">
            (@T("Plugins.Misc.Nexport.Order.Redeem"))
        </a>
        <a href="javascript:void(0);" data-id="refreshLink" style="display: none;">(Check the redemption)</a>
        popupTitle = T("Plugins.Misc.Nexport.Order.Redeem").Text;
    }
    <div data-id="redemption-view-popup" data-nexport-order-invoice-id="@orderInvoice.Id" title="@popupTitle" style="display: none;">
        @await Html.PartialAsync("~/Plugins/Misc.Nexport/Views/_RedeemOrViewOrder.cshtml", orderInvoice)
    </div>
    <script asp-location="Footer">
        $(document).ready(function () {
            $("[data-id=view-redemption-link][data-nexport-order-invoice-id=@orderInvoice.Id]").on("click", function () {
                var targetWidth = 550;
                var maxHeight = $(window).height() - 20;

                $("[data-id=redemption-view-popup][data-nexport-order-invoice-id=@orderInvoice.Id]").dialog({
                    width: targetWidth,
                    maxHeight: maxHeight,
                    close: function(event, ui) {
                        if ($("#redeemCompleted").data("redeemed")) {
                            $("[data-id=view-redemption-link]").hide();
                            $("[data-id=refreshLink]").click(function(e) {
                                location.reload();
                            }).show();
                        }
                    }
                });
            });
        });
    </script>
}
