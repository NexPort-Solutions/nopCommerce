@using Nop.Plugin.Misc.Nexport.Domain.Enums
@using Nop.Plugin.Misc.Nexport.Extensions

@{
    var hasAdminRole = ViewData["HasAdminRole"];
    var adminView = ViewData["AdminView"];
}

<script>
    var isAdminRole = @Json.Serialize(hasAdminRole);
    var isAdminView = @Json.Serialize(adminView);

    function renderCustomerDetails(data, type, row, meta) {
        if (row.Name !== null && row.Email !== null) {
            var emailTextDetails = row.Email;
            if (isAdminRole && isAdminView && row.CustomerId)            {

                var link = "@(Url.Action("Edit", "Customer"))/" + row.CustomerId;
                emailTextDetails = "<a href=\"" + link + "\">" + row.Email + "</a>";
            }

            var customerDetails = row.Name + " (" + emailTextDetails + ")";
            return customerDetails;
        }

        return "";
    }

    function renderPurchasedByCustomerDetails(data, type, row, meta) {
        if (row.PurchasedByCustomerName !== null) {
            var emailTextDetails = row.PurchasedByCustomerEmail;
            if (isAdminView)
            {
                var link = "@(Url.Action("Edit", "Customer"))/" + row.PurchasedByCustomerId;
                emailTextDetails = "<a href=\"" + link + "\">" + row.PurchasedByCustomerEmail + "</a>";
            }

            var purchasedByCustomerDetails = row.PurchasedByCustomerName + " (" + emailTextDetails + ")";
            return purchasedByCustomerDetails;
        }

        return "";
    }

    function renderStatus(data, type, row, meta) {
        var textRenderer = $.fn.dataTable.render.text().display;

        if (isAdminView && data === "Refunded" && row.HasRefundRequest) {
            return textRenderer(data) + "<a class=\"ml-1 refund-note\" tabindex=\"0\" data-trigger=\"focus\" data-content=\"" + row.RefundNote + "\" data-container=\"body\" data-toggle=\"popover\" data-placement=\"top\" data-id=\"refund-status\" style=\"color: rgb(43, 43, 43);\"><i class=\"fa-solid fa-circle-info fa-1x\"></i></a>";
        }

        return textRenderer(data);
    }

    function renderRefundRedemption(data, type, row, meta) {
        if (row.InvoiceItemId != null) {
            var buttonFunction = "";
            var buttonIcon = "";
            var buttonText = "";
            var buttonDisabledState = false;
            var url = "";

            if (row.Status === "@(NexportOrderInvoiceItemRedemptionStatus.Assigned.GetDisplayName())") {
                if (!row.HasRefundRequest) {
                    buttonFunction = "requestRefundRedemption('" + row.InvoiceItemId + "')";
                }

                buttonIcon = "fa-solid fa-rotate-exclamation";
                buttonText = "@T("Plugins.Misc.Nexport.Group.Product.Redemption.Button.RequestRefund")";
                buttonDisabledState = row.HasRefundRequest;
            } else if (row.Status === "@(NexportOrderInvoiceItemRedemptionStatus.Refunded.GetDisplayName())") {
                if (isAdminView) {
                    if (row.HasRefundRequest) {
                        url = "@Url.Content("~/Admin/ReturnRequest/Nexport/Edit/")" + row.RefundRequestId;
                        return renderCustomLinkTag(url, null, "fa-solid fa-file-magnifying-glass", "@T("Plugins.Misc.Nexport.Group.Product.Redemption.Button.ViewRefundRequest")");
                    } else {
                        buttonDisabledState = true;

                        buttonIcon = "fa-solid fa-rotate-left";
                        buttonText = "@T("Plugins.Misc.Nexport.Group.Product.Redemption.Button.Refund")";
                    }
                } else {
                    buttonDisabledState = true;

                    buttonIcon = "fa-solid fa-rotate-exclamation";
                    buttonText = "@T("Plugins.Misc.Nexport.Group.Product.Redemption.Button.RequestRefund")";
                }
            } else if (row.Status === "@(NexportOrderInvoiceItemRedemptionStatus.ProcessingRefund.GetDisplayName())") {
                if (isAdminView) {
                    url = "@Url.Content("~/Admin/ReturnRequest/Nexport/Edit/")" + row.RefundRequestId;
                    return renderCustomLinkTag(url, null, "fa-solid fa-file-magnifying-glass", "@T("Plugins.Misc.Nexport.Group.Product.Redemption.Button.ViewRefundRequest")");
                } else {
                    buttonDisabledState = true;

                    buttonIcon = "fa-solid fa-rotate-exclamation";
                    buttonText = "@T("Plugins.Misc.Nexport.Group.Product.Redemption.Button.RequestRefund")";
                }
            } else {
                if (isAdminView) {
                    buttonFunction = "refundRedemption('" + row.InvoiceItemId + "')";
                    buttonIcon = "fa-solid fa-rotate-left";
                    buttonText = "@T("Plugins.Misc.Nexport.Group.Product.Redemption.Button.Refund")";
                } else {
                    buttonFunction = "requestRefundRedemption('" + row.InvoiceItemId + "')";
                    buttonIcon = "fa-solid fa-rotate-exclamation";
                    buttonText = "@T("Plugins.Misc.Nexport.Group.Product.Redemption.Button.RequestRefund")";
                }
            }

            return renderCustomButton(buttonFunction, buttonIcon, buttonText, buttonDisabledState);
        }

        return "";
    }

    function renderModifyGroupProductRedemptions(data, type, row, meta) {
        if (row.InvoiceItemId != null) {
            var buttonFunction = "";
            var buttonIcon = "";
            var buttonText = "";
            var buttonDisabledState = false;

            if (row.Status === "@(NexportOrderInvoiceItemRedemptionStatus.Assigned.GetDisplayName())") {
                if (isAdminRole) {
                    buttonFunction = "unassignRedemption('" + row.InvoiceItemId + "')";
                    buttonIcon = "fa-solid fa-square-minus";
                    buttonText = "@T("Plugins.Misc.Nexport.Group.Product.Redemption.Button.Unassign")";
                } else {
                    buttonFunction = "requestUnassignment('" + row.InvoiceItemId + "', " + row.CustomerId + ")";
                    buttonIcon =  "fa-solid fa-square-info";
                    buttonText = "@T("Plugins.Misc.Nexport.Group.Product.Redemption.Button.RequestUnassignment")";
                }
            } else if (row.Status === "@(NexportOrderInvoiceItemRedemptionStatus.Available.GetDisplayName())") {
                buttonFunction = "assignRedemption('" + row.InvoiceItemId + "')";
                buttonIcon = "fa-solid fa-square-plus";
                buttonText = "@T("Plugins.Misc.Nexport.Group.Product.Redemption.Button.Assign")";
            } else if (row.Status === "@(NexportOrderInvoiceItemRedemptionStatus.Awaiting.GetDisplayName())") {
                buttonFunction = "cancelAwaitingRedemption('" + row.InvoiceItemId + "')";
                buttonIcon = "fa-solid fa-square-xmark";
                buttonText = "@T("Plugins.Misc.Nexport.Group.Product.Redemption.Button.CancelAwaiting")";
            } else {
                buttonDisabledState = true;
                if (row.CustomerId != null) {
                    if (isAdminRole) {
                        buttonIcon = "fa-solid fa-square-minus";
                        buttonText = "@T("Plugins.Misc.Nexport.Group.Product.Redemption.Button.Unassign")";
                    } else {
                        buttonIcon =  "fa-solid fa-square-info";
                        buttonText ="@T("Plugins.Misc.Nexport.Group.Product.Redemption.Button.RequestUnassignment")";
                    }
                } else {
                    buttonIcon = "fa-solid fa-square-plus";
                    buttonText = "@T("Plugins.Misc.Nexport.Group.Product.Redemption.Button.Assign")";
                }
            }

            return renderCustomButton(buttonFunction, buttonIcon, buttonText, buttonDisabledState);
        }

        return "";
    }

    function renderViewRedemptionAuditLog(data, type, row, meta) {
        if (row.InvoiceItemId != null && isAdminRole) {
            var url = "@Url.Action("RedemptionAuditLogList", "NexportWholesale")" + "?invoiceItemId=" + row.InvoiceItemId;
            var buttonFunction = "javascript:OpenWindow('" + url + "', 1024, 800, true); return false;";

            return renderCustomButton(buttonFunction, "fa-solid fa-clipboard-list", "Log");
        }

        return "";
    }

    function refundRedemption(invoiceItemId) {
        if (confirm('Do you want to refund this redemption?')) {
            var postData = {
                invoiceItemId: invoiceItemId
            };
            addAntiForgeryToken(postData);

            $.ajax({
                cache: false,
                type: "POST",
                url: "@Url.Action("RefundInvoiceItem", "NexportWholesale")",
                data: postData,
                dataType: "json",
                success: function (data, textStatus, jqXHR) {
                    location.reload();
                },
                error: function (jqXHR, textStatus, errorThrown) {
                    alert("@T("Plugins.Misc.Nexport.Group.Product.Redemption.Refund.Failed")");
                    console.log(errorThrown);
                }
            });
        }
    }

    function requestRefundRedemption(invoiceItemId) {
        var url = "@Url.Action("RequestRefund", "NexportWholesale")";

        if (isAdminView) {
            url += "?invoiceItemId=" + invoiceItemId;
            OpenWindow(url, 800, 800, true);
        } else {
            url += "?InvoiceItemId=" + invoiceItemId;
            window.location.href = url;
        }
    }

    function viewRefundRequest(refundRequestId) {
        if (!refundRequestId)
            return;

        var url = "@Url.Content("~/Admin/ReturnRequest/Nexport/Edit/")" + refundRequestId;
        window.location.href = url;
    }

    function unassignRedemption(invoiceItemId) {
        if (confirm('@T("Plugins.Misc.Nexport.Group.Product.Redemptions.Unassign.Confirmation")')) {
            var postData = {
                invoiceItemId: invoiceItemId
            };
            addAntiForgeryToken(postData);

            $.ajax({
                cache: false,
                type: "POST",
                url: "@Url.Action("InvoiceItemUnassign", "NexportWholesale")",
                data: postData,
                dataType: "json",
                success: function (data, textStatus, jqXHR) {
                    if (data.result === "@(NexportOrderInvoiceItemRedemptionStatus.ProcessingAvailable.GetDisplayName())") {
                        location.reload();
                    }
                },
                error: function (jqXHR, textStatus, errorThrown) {
                    alert("@T("Plugins.Misc.Nexport.Group.Product.Redemption.Unassign.Failed")");
                    console.log(errorThrown);
                }
            });
        }
    }

    function cancelAwaitingRedemption(invoiceItemId) {
        if (confirm('@T("Plugins.Misc.Nexport.Group.Product.Redemption.CancelAwaiting.Confirm")')) {
            var postData = {
                invoiceItemId: invoiceItemId
            };
            addAntiForgeryToken(postData);

            $.ajax({
                cache: false,
                type: "POST",
                url: "@Url.Action("InvoiceItemCancelAwaiting", "NexportWholesale")",
                data: postData,
                dataType: "json",
                success: function (data, textStatus, jqXHR) {
                    if (data.result === "@(NexportOrderInvoiceItemRedemptionStatus.Available)") {
                        location.reload();
                    }
                },
                error: function (jqXHR, textStatus, errorThrown) {
                    alert("@T("Plugins.Misc.Nexport.Group.Product.Redemption.CancelAwaiting.Failed")");
                    console.log(errorThrown);
                }
            });
        }
    }
</script>