@model Nop.Plugin.Misc.Nexport.Models.Customer.NexportTrainingListModel

@{
    NopHtml.AddScriptParts(ResourceLocation.Footer, "~/js/admin.table.js", excludeFromBundle: true);
    NopHtml.AddScriptParts(ResourceLocation.Footer, "~/lib_npm/moment/min/moment-with-locales.min.js", "", true);
    NopHtml.AddScriptParts(ResourceLocation.Footer, "~/Plugins/Misc.Nexport/Scripts/bootstrap.bundle.min.js", "", true);
    NopHtml.AddScriptParts(ResourceLocation.Footer, "~/Plugins/Misc.Nexport/Scripts/datatables-custom.min.js");
    NopHtml.AddScriptParts(ResourceLocation.Footer, "~/Plugins/Misc.Nexport/Scripts/nexport_plugin_common.js", "", true);
    NopHtml.AddScriptParts(ResourceLocation.Footer, "~/js/admin.common.js", "", true);
    NopHtml.AddCssFileParts("~/Plugins/Misc.Nexport/Content/bootstrap/bootstrap-custom.min.css");
    NopHtml.AddCssFileParts("~/Plugins/Misc.Nexport/Content/datatables-custom.min.css");
    NopHtml.AddCssFileParts("~/Plugins/Misc.Nexport/Content/nexport.css");

    var organizations = Model?.Organizations;
}

@if (organizations is { Count: > 0 })
{
    <div class="nexport-training-list nex-plugin">
        <div id="nexport-training-antiforgery" class="d-none">
            @Html.AntiForgeryToken()
        </div>

        <div class="accordion accordion-flush" id="organization-list-selection">
            @foreach (var org in organizations)
            {
                var headingId = $"organization-heading-{org.OrgId}";
                var collapseId = $"enrollment-listing-container-{org.OrgId}";
                <div class="accordion-item" data-org-id="@org.OrgId">
                    <div class="accordion-header d-flex align-items-center" id="@headingId">
                        <div class="accordion-button collapsed" role="button" data-bs-toggle="collapse" data-bs-target="#@collapseId" aria-expanded="false" aria-controls="@collapseId">
                            <h3 class="w-100">
                                @org.OrgName (@org.OrgShortName)
                            </h3>
                            <a href="javascript:void(0);" class="text-nowrap mx-2" data-org-id="@org.OrgId" data-function="viewTrainingLink">View Training</a>
                        </div>
                    </div>
                    <div id="@collapseId" class="accordion-collapse collapse" aria-labelledby="@headingId" data-bs-parent="#organization-list-selection" data-org-id="@org.OrgId">
                        <div class="accordion-body w-100" data-id="enrollment-listing">
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
}

<script asp-location="Footer">
    function navigateToNexportOrganization(element) {
        var orgId = $(element).data("org-id");
        if (orgId) {
            var url = "@Url.Action("GoToNexportOrg", "NexportIntegration")";
            url += "?orgId=" + encodeURIComponent(orgId);

            navigateToNexport(url);
        }

        return false;
    }

    function launchNexportClassroom(enrollmentId) {
        if (enrollmentId) {
            var url = "@Url.Action("GoToNexportClassroom", "NexportIntegration")";
            url += "?enrollmentId=" + encodeURIComponent(enrollmentId);

            navigateToNexport(url);
        }

        return false;
    }

    function navigateToNexportClassroom(element) {
        var enrollmentId = $(element).data("enrollment-id");
        if (enrollmentId) {
            launchNexportClassroom(enrollmentId);
        }
    }

    function navigateToNexport(url) {
        var nexportWindow = window.open("about:blank", "_blank");

        $.ajax({
            url: url,
            type: "GET",
            success: function (result) {
                if (result && result.RedirectUrl) {
                    if (nexportWindow) {
                        nexportWindow.location.href = result.RedirectUrl;
                    } else {
                        window.location.href = result.RedirectUrl;
                    }
                }
            },
            error: function (xhr) {
                var response = xhr.responseJSON;
                if (nexportWindow) {
                    nexportWindow.close();
                }

                if (response && response.Error) {
                    displayBarNotification(response.Error, "error");
                }
            }
        });
    }

    $(document).ready(function() {
        $(document).on("click", "[data-function='viewTrainingLink']", function(e) {
            e.stopPropagation();
            e.stopImmediatePropagation();
            e.preventDefault();

            navigateToNexportOrganization(e.currentTarget);
            return false;
        });

        var orgListSelection = document.getElementById("organization-list-selection");
        if (!orgListSelection) {
            return;
        }

        orgListSelection.addEventListener("show.bs.collapse", function(e) {
            var currentElement = $(e.target);
            var orgId = currentElement.attr("data-org-id");
            var listing = currentElement.find("[data-id='enrollment-listing']");
            if (!orgId || listing.data("loaded")) {
                return;
            }

            $.ajax({
                url: "@(Url.Action("ListNexportUserEnrollments", "NexportIntegration"))",
                data: {
                    organizationId: orgId
                },
                success: function(data) {
                    listing.html(data).data("loaded", true);
                },
                error: function() {
                    displayBarNotification("Unable to load enrollments right now. Please try again.", "error");
                }
            });
        });
    });
</script>
