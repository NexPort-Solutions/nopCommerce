@model Nop.Plugin.Misc.Nexport.Models.ProductMappings.NexportProductMappingListSearchModel

@{
    const string hideNexportMappingsBlockAttributeName = "ProductPage.HideNexportMappingsBlock";
    var hideNexportMappingsBlock = await genericAttributeService.GetAttributeAsync<bool>(await workContext.GetCurrentCustomerAsync(), hideNexportMappingsBlockAttributeName);
    
}
<nop-card asp-name="nexport-mapping-list" asp-icon="fas fa-paperclip" asp-title="Nexport Product Mappings"
           asp-hide-block-attribute-name="@hideNexportMappingsBlockAttributeName" asp-hide="@hideNexportMappingsBlock" asp-advanced="false">
    <div class="card-body">
        
        <div class="card-group" id="product-mapping-container">
            @* ReSharper disable once Mvc.PartialViewNotResolved *@
            @await Html.PartialAsync("~/Plugins/Misc.Nexport/Views/ProductMappingTable.cshtml", Model)
        </div>
    </div>
</nop-card>