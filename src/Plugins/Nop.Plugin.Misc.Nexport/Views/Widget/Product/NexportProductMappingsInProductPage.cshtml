@model Nop.Plugin.Misc.Nexport.Models.ProductMappings.NexportProductMappingListSearchModel

@{
    const string hideNexportMappingsBlockAttributeName = "ProductPage.HideNexportMappingsBlock";
    const string hideSearchNexportMappingsBlockAttributeName = "ProductPage.HideSearchNexportMappingsBlock";
    var hideNexportMappingsBlock = await genericAttributeService.GetAttributeAsync<bool>(await workContext.GetCurrentCustomerAsync(), hideNexportMappingsBlockAttributeName);
    var hideSearchNexportMappingsBlock = await genericAttributeService.GetAttributeAsync<bool>(await workContext.GetCurrentCustomerAsync(), hideSearchNexportMappingsBlockAttributeName);
}
<nop-card asp-icon="fa fa-search" asp-title="Search Product Mappings" asp-name="SearchBoxViewComponent-mappings-card" asp-hide="@hideSearchNexportMappingsBlock" asp-hide-block-attribute-name="@hideSearchNexportMappingsBlockAttributeName">
    <div class="card-body">
        <div class="row mapping-search-div">
            <div class="col-md-5">
                <div class="form-group row">
                    <div class="col-md-5">
                        <nop-label asp-for="SearchStoreName"/>
                    </div>
                    <div class="col-md-7">
                        <nop-editor asp-for="SearchStoreName"/>
                    </div>
                </div>
                <div class="form-group row">
                    <div class="col-md-5">
                        <nop-label asp-for="NexportProductType"/>
                    </div>
                    <div class="col-md-7">
                        <nop-select asp-for="NexportProductType" asp-items="Model.AvailableNexportProductTypes"/>
                    </div>
                </div>
            </div>
            <div class="col-md-7">
                <div class="form-group row">
                    <div class="col-md-5">
                     <nop-label asp-for="SearchNexportProductName"/>
                </div>
                    <div class="col-md-7">
                        <nop-editor asp-for="SearchNexportProductName"/>
                    </div>
                </div>
            </div>
        </div>
            <div class="form-group row">
            <div class="text-center col-12">
                <button type="button" id="search-mappings" class="btn btn-primary btn-search"><i class="fas fa-search"></i>@T("Admin.Common.Search")</button>
            </div>
        </div>
    </div>
</nop-card>
<nop-card asp-name="nexport-mapping-list" asp-icon="fas fa-paperclip" asp-title="Nexport Product Mappings"
           asp-hide-block-attribute-name="@hideNexportMappingsBlockAttributeName" asp-hide="@hideNexportMappingsBlock" asp-advanced="false">
    <div class="card-body">
        <div class="card-group" id="product-mapping-container">
            @* ReSharper disable once Mvc.PartialViewNotResolved *@
            @await Html.PartialAsync("~/Plugins/Misc.Nexport/Views/ProductMappingTable.cshtml", Model)
        </div>
    </div>
</nop-card>