@{
    bool showNexportWholesalePurchases = (bool)(ViewData["ShowNexportWholesalePurchases"]??false);
    string? customerName = ViewData["CustomerName"] as string;
}

<li>
    <a href="@Url.RouteUrl("Plugin.Misc.Nexport.MyTraining")" class="ico-nexport-training">@(customerName + " " + T("Plugins.Misc.Nexport.Navigation.MyTrainings"))</a>
</li>
@if (showNexportWholesalePurchases)
{
    <li>
        <a href="@Url.RouteUrl("Plugin.Misc.Nexport.Customer.Groups")" class="ico-nexport-groups">
            @T("Plugins.Misc.Nexport.Navigation.Groups")
        </a>
    </li>
}