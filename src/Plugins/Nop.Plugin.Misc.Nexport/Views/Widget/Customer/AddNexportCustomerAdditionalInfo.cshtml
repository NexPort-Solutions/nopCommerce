@using Nop.Services.Common

@inject IGenericAttributeService genericAttributeService
@inject IWorkContext workContext

@model Nop.Plugin.Misc.Nexport.Models.Customer.AddNexportCustomerAdditionalInfoModel

@if (Model is { CustomerId: 0 })
{
    var currentCustomer = await workContext.GetCurrentCustomerAsync();
    const string hideAddNexportCustomerRegistrationFieldsBlockAttributeName = "CustomerPage.AddNexportCustomerRegistrationFieldsBlock";
    var hideAddNexportCustomerRegistrationFieldsBlock =
        await genericAttributeService.GetAttributeAsync<bool>(currentCustomer, hideAddNexportCustomerRegistrationFieldsBlockAttributeName);

    <nop-card asp-name="nexport-customer-registration-fields" asp-icon="fa fa-id-card-o"
               asp-title="Nexport Registration Fields"
               asp-hide-block-attribute-name="@hideAddNexportCustomerRegistrationFieldsBlockAttributeName"
               asp-hide="@hideAddNexportCustomerRegistrationFieldsBlock" asp-advanced="false">
        <div class="card-body">
            <nop-select asp-for="StoreId" asp-items="@Model.AvailableStores" asp-multiple="false" title="Select store" asp-required="false" />
            <div id="nexport-registration-field-answers-container" style="margin-top: 5px"></div>
        </div>
        <script>
            $(document).ready(function() {
                $("#@Html.IdFor(model => model.StoreId)").on("change",
                    function(e) {
                        e.preventDefault();

                        loadRegistrationFieldsForStore($(e.target).val());
                    });

                $("#@Html.IdFor(model => model.StoreId)").rules("remove", "required");
            });

            function loadRegistrationFieldsForStore(storeId) {
                var postData = {
                    storeId: storeId
                };
                addAntiForgeryToken(postData);

                $.ajax({
                    url: "@Url.Action("LoadRegistrationFieldAnswersByStore", "NexportIntegration")",
                    data: postData,
                    success: function(result, textStatus, jqXHR) {
                        if (result !== undefined) {
                            $("#nexport-registration-field-answers-container").html(result);
                        }
                    },
                    error:function(jqXHR, textStatus, errorThrown) {
                        alert(errorThrown);
                    }
                });
            }

            //# sourceURL=add_nexport_customer_additional_info.js
        </script>
    </nop-card>
}