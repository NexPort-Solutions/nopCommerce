@using Nop.Services.Common
@using Nop.Plugin.Misc.Nexport.Domain.Enums
@using Nop.Plugin.Misc.Nexport.Extensions
@using Nop.Plugin.Misc.Nexport.Models.SupplementalInfo
@using System.Net
@using Nop.Plugin.Misc.Nexport.Models
@using Nop.Plugin.Misc.Nexport.Models.RegistrationField.Customer
@using Nop.Services.Stores

@inject NexportSettings _nexportSettings
@inject IStoreService storeService

@model Nop.Plugin.Misc.Nexport.Models.Customer.NexportCustomerAdditionalInfoModel

<script src="~/Plugins/Misc.Nexport/Scripts/nexport_plugin_common.js"></script>
<script src="~/Plugins/Misc.Nexport/Scripts/dataTables.rowGroup.min.js"></script>
<link rel="stylesheet" href="~/Plugins/Misc.Nexport/Content/rowGroup.dataTables.min.css" />

@if (Model is {Editable: true })
{
    var customer = await workContext.GetCurrentCustomerAsync();
    const string hideNexportCustomerDetailsBlockAttributeName = "CustomerPage.HideNexportCustomerDetailsBlock";
    var hideNexportCustomerDetailsBlock = await genericAttributeService.GetAttributeAsync<bool>(customer, hideNexportCustomerDetailsBlockAttributeName);

    const string hideNexportSupplementalInfoAnswersBlockAttributeName = "CustomerPage.HideNexportSupplementalInfoAnswersBlock";
    var hideNexportSupplementalInfoAnswersBlock = await genericAttributeService.GetAttributeAsync<bool>(customer, hideNexportSupplementalInfoAnswersBlockAttributeName);

    const string hideNexportCustomerRegistrationFieldAnswersBlockAttributeName = "CustomerPage.HideNexportCustomerRegistrationFieldAnswersBlock";
    var hideNexportCustomerRegistrationFieldAnswersBlock = genericAttributeService.GetAttribute<bool>(workContext.CurrentCustomer, hideNexportCustomerRegistrationFieldAnswersBlockAttributeName);

    <nop-panel asp-name="nexport-customer-details" asp-icon="fa fa-sticky-note-o" asp-title="Nexport Customer Info"
               asp-hide-block-attribute-name="@hideNexportCustomerDetailsBlockAttributeName" asp-hide="@hideNexportCustomerDetailsBlock" asp-advanced="false">
        <div class="panel-body">
            <div class="form-group">
                <div class="col-md-3">
                    <nop-label asp-for="NexportUserId" />
                </div>
                <div class="col-md-9">
                    <div class="input-group">
                        <nop-editor asp-for="NexportUserId" asp-render-form-control-class="true" />
                        <div class="input-group-btn">
                            <button id="setNexportUserId" class="btn btn-info">
                                Set user Id
                            </button>
                        </div>
                    </div>
                </div>
            </div>
            @if (Model.NexportUserId.HasValue)
            {
                if (!string.IsNullOrEmpty(Model.NexportUserFullName))
                {
                    <div class="form-group">
                        <div class="col-md-3">
                            <nop-label asp-for="NexportUserFullName" />
                        </div>
                        <div class="col-md-9">
                            <div class="form-text-row">@Model.NexportUserFullName</div>
                        </div>
                    </div>
                }
                if (!string.IsNullOrEmpty(Model.NexportEmail))
                {
                    <div class="form-group">
                        <div class="col-md-3">
                            <nop-label asp-for="NexportEmail" />
                        </div>
                        <div class="col-md-9">
                            <div class="form-text-row">@Model.NexportEmail</div>
                        </div>
                    </div>
                }
                if (Model.OwnerOrgId != null)
                {
                    <div class="form-group">
                        <div class="col-md-3">
                            <nop-label asp-for="OwnerOrgId" />
                        </div>
                        <div class="col-md-9">
                            <div class="form-text-row">@Model.OwnerOrgId</div>
                        </div>
                    </div>
                    <div class="form-group">
                        <div class="col-md-3">
                            <nop-label asp-for="OwnerOrgShortName" />
                        </div>
                        <div class="col-md-9">
                            <div class="form-text-row">@Model.OwnerOrgShortName</div>
                        </div>
                    </div>
                }
                var userInfoUrlCreated = Uri.TryCreate(new Uri(_nexportSettings.Url.TrimEnd('/')), $"Account/Info.nex?user={Model.NexportUserId}", out var userInfoUrl);
                if (userInfoUrlCreated && userInfoUrl != null)
                {
                    <div class="form-group">
                        <div class="col-md-3">
                        </div>
                        <div class="col-md-9">
                            <a class="btn bg-blue" target="_blank" href="@userInfoUrl.AbsoluteUri">View user info in Nexport</a>
                        </div>
                    </div>
                }
            }
        </div>
    </nop-panel>
    <nop-panel asp-name="nexport-customer-supplemental-info-answers" asp-icon="fa fa-sticky-note-o"
               asp-title="Nexport Supplemental Info Answers"
               asp-hide-block-attribute-name="@hideNexportSupplementalInfoAnswersBlockAttributeName"
               asp-hide="@hideNexportSupplementalInfoAnswersBlock" asp-advanced="false">
        <div class="panel-body">
            @await Html.PartialAsync("~/Plugins/Misc.Nexport/Views/Shared/Table.cshtml", new NexportDataTablesModel()
            {
               Name = "nexport-customer-supplemental-info-questions",
               UrlRead = new DataUrl("GetCustomerSupplementalInfoQuestions", "NexportIntegration",
                        new RouteValueDictionary {
                            {
                                "customerId", Model.CustomerId
                            }}),
               Length = Model.NexportCustomerSupplementalInfoAnsweredQuestionListSearchModel.PageSize,
               LengthMenu = Model.NexportCustomerSupplementalInfoAnsweredQuestionListSearchModel.AvailablePageSizes,
               PrimaryKeyColumn = nameof(NexportCustomerSupplementalInfoAnsweredQuestionModel.Id),
               ColumnCollection = new List<ColumnProperty>
               {
                    new ColumnProperty(null)
                    {
                        Render = new RenderChildCaret(),
                        Width = "5px",
                        Searchable = false,
                        ClassName = NopColumnClassDefaults.ChildControl,
                        AutoWidth = false
                    },
                    new ColumnProperty(nameof(NexportCustomerSupplementalInfoAnsweredQuestionModel.QuestionText))
                    {
                        Title = "Question",
                        Width = "100"
                    }
                },
                ChildTable = new NexportDataTablesModel
                {
                    Name = "nexport-customer-supplemental-info-answers-list",
                    UrlRead = new DataUrl("GetCustomerSupplementalInfoAnswers", "NexportIntegration",
                                new RouteValueDictionary {
                                    { "customerId", Model.CustomerId }
                                }),
                    IsChildTable = true,
                    Length = Model.NexportSupplementalInfoAnswerListSearchModel.PageSize,
                    LengthMenu = Model.NexportSupplementalInfoAnswerListSearchModel.AvailablePageSizes,
                    Filters = new List<FilterParameter>
                    {
                        new FilterParameter(nameof(NexportSupplementalInfoAnswerModel.QuestionId),
                            nameof(NexportCustomerSupplementalInfoAnsweredQuestionModel.Id), true)
                    },
                    RowGrouping = true,
                    RowGroupingColumn = nameof(NexportSupplementalInfoAnswerModel.StoreName),
                    CustomRowStartRender = "renderCustomGroupingRow",
                    ColumnCollection = new List<ColumnProperty>
                    {
                        new ColumnProperty(nameof(NexportSupplementalInfoAnswerModel.OptionText))
                        {
                            Title = "Option",
                            Width = "100"
                        },
                        new ColumnProperty(nameof(NexportSupplementalInfoAnswerModel.Status))
                        {
                            Title = "Status",
                            Width = "50",
                            Render = new RenderCustom("renderSupplementalInfoAnswerStatusInfo")
                        },
                        new ColumnProperty(nameof(NexportSupplementalInfoAnswerModel.NexportMemberships))
                        {
                            Title = "Membership Id",
                            Width = "100"
                        },
                        new ColumnProperty(nameof(NexportSupplementalInfoAnswerModel.UtcDateModified))
                        {
                            Title = "Modified Date",
                            Width = "100",
                            Render = new RenderCustom("renderLocalDateForTableEntry")
                        },
                        new ColumnProperty(nameof(NexportSupplementalInfoAnswerModel.UtcDateCreated))
                        {
                            Title = "Created Date",
                            Width = "100",
                            Render = new RenderCustom("renderLocalDateForTableEntry")
                        },
                        new ColumnProperty(nameof(NexportCustomerSupplementalInfoAnsweredQuestionModel.Id))
                        {
                            Width = "50",
                            Render = new RenderCustom("renderDeleteCustomerSupplementalInfoAnswer"),
                            ClassName = NopColumnClassDefaults.Button,
                            AutoWidth = false
                        }
                    }
                }
            })

            <input type="submit" id="btnRefreshAnswerList" style="display: none">
        </div>
    </nop-panel>
    <nop-panel asp-name="nexport-customer-registration-field-answers" asp-icon="fa fa-id-card-o"
               asp-title="Nexport Registration Field Answers"
               asp-hide-block-attribute-name="@hideNexportCustomerRegistrationFieldAnswersBlockAttributeName"
               asp-hide="@hideNexportCustomerRegistrationFieldAnswersBlock" asp-advanced="false">
        <div class="panel-body">
            <div style="display: flex;">
                <div style="flex-grow: 1;">
                    <nop-select asp-for="@Model.NexportCustomerRegistrationFieldWithAnswersListSearchModel.StoreId"
                                asp-items="@Model.NexportCustomerRegistrationFieldWithAnswersListSearchModel.AvailableStores"
                                asp-multiple="false" />
                </div>
                <div style="margin-left: 8px">
                    <button type="button" id="addRegistrationFieldAnswers" class="btn bg-blue">Add field answers</button>
                </div>
            </div>
            
            @await Html.PartialAsync("~/Plugins/Misc.Nexport/Views/Shared/Table.cshtml", new NexportDataTablesModel
            {
                Name = "nexport-customer-registration-fields",
                UrlRead = new DataUrl("GetNexportRegistrationFieldsForCustomer", "NexportIntegration",
                    new RouteValueDictionary
                    {
                        {
                            "customerId", Model.CustomerId
                        }
                    }),
                Length = Model.NexportCustomerRegistrationFieldWithAnswersListSearchModel.PageSize,
                LengthMenu = Model.NexportCustomerRegistrationFieldWithAnswersListSearchModel.AvailablePageSizes,
                Filters = new List<FilterParameter>
                {
                    new FilterParameter(
                        nameof(Model.NexportCustomerRegistrationFieldWithAnswersListSearchModel.StoreId), 
                        nameof(Model.NexportCustomerRegistrationFieldWithAnswersListSearchModel))
                },
                PrimaryKeyColumn = nameof(NexportCustomerRegistrationFieldWithAnswersModel.Id),
                ColumnCollection = new List<ColumnProperty>
                {
                    new ColumnProperty(null)
                    {
                        Render = new RenderChildCaret(),
                        Width = "5",
                        Searchable = false,
                        ClassName = NopColumnClassDefaults.ChildControl,
                        AutoWidth = false
                    },
                    new ColumnProperty(nameof(NexportCustomerRegistrationFieldWithAnswersModel.FieldName))
                    {
                        Title = "Name",
                        Width = "200"
                    },
                    new ColumnProperty(nameof(NexportCustomerRegistrationFieldWithAnswersModel.FieldType))
                    {
                        Title = "Type",
                        Width = "100"
                    },
                    new ColumnProperty(nameof(NexportCustomerRegistrationFieldWithAnswersModel.NexportCustomProfileFieldKey))
                    {
                        Title = "Custom profile field",
                        Width = "200"
                    },
                    new ColumnProperty(nameof(NexportCustomerRegistrationFieldWithAnswersModel.Id))
                    {
                        Width = "50",
                        Render = new RenderCustom("renderEditCustomerRegistrationFieldAnswer"),
                        ClassName = NopColumnClassDefaults.Button,
                        AutoWidth = false
                    },
                },
                ChildTable = new NexportDataTablesModel
                {
                    Name = "nexport-customer-registration-field-answers",
                    UrlRead = new DataUrl("GetNexportRegistrationFieldAnswersForCustomer", "NexportIntegration",
                        new RouteValueDictionary
                        {
                            { "customerId", Model.CustomerId }
                        }),
                    IsChildTable = true,
                    Length = Model.NexportCustomerRegistrationFieldAnswerListSearchModel.PageSize,
                    LengthMenu = Model.NexportCustomerRegistrationFieldAnswerListSearchModel.AvailablePageSizes,
                    Filters = new List<FilterParameter>
                    {
                        new FilterParameter(nameof(NexportCustomerRegistrationFieldAnswerModel.FieldId),
                            nameof(NexportCustomerRegistrationFieldWithAnswersModel.Id), true)
                    },
                    CustomRowStartRender = "renderCustomerRegistrationFieldGroupingRow",
                    ColumnCollection = new List<ColumnProperty>
                    {
                        new ColumnProperty(nameof(NexportCustomerRegistrationFieldAnswerModel.FieldValue))
                        {
                            Title = "Value"
                        }
                    }
                }
            })
            <input type="submit" id="btnRefreshRegistrationAnswerList" style="display: none">
        </div>
    </nop-panel>
    <script>
        $(document).ready(function() {
            jQuery.validator.addMethod("dotnet-guid",
                function(value, element) {
                    return this.optional(element) || /[a-f0-9]{8}(?:-[a-f0-9]{4}){3}-[a-f0-9]{12}/i.test(value);
                }, "Please input the correct GUID format: xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx");

            $("#btnRefreshAnswerList").click(function() {
                // Refresh child grid
                $("table[id*=nexport-customer-supplemental-info-answers-list]").DataTable().draw(false);

                // Return false to don't reload a page
                return false;
            });

            $("#btnRefreshRegistrationAnswerList").click(function() {
                // Refresh child grid
                $("table[id*=nexport-customer-registration-fields]").DataTable().draw(false);

                // Return false to don't reload a page
                return false;
            });

            canSetNexportUserId("@Model.CustomerId");

            $("#setNexportUserId").on("click",
                function(e) {
                    e.preventDefault();

                    var userIdElement = $("#@Html.IdFor(model => model.NexportUserId)");
                    userIdElement.rules("add", { "dotnet-guid": true });

                    setNexportUserId(userIdElement);
                });

            $("#@Html.IdFor(model => model.NexportCustomerRegistrationFieldWithAnswersListSearchModel.StoreId)").on("change",
                function(e) {
                    $("#nexport-customer-registration-fields").DataTable().draw(false);
                });

            $("#addRegistrationFieldAnswers").on("click",
                function(e) {
                    addRegistrationFieldAnswers($("#@Html.IdFor(model => model.NexportCustomerRegistrationFieldWithAnswersListSearchModel.StoreId)").val());
                });
        });

        function canSetNexportUserId(customerId) {
            var postData = {
                customerId: customerId
            };
            addAntiForgeryToken(postData);

            $.ajax({
                url: "@Url.Action("CanSetNexportUser", "NexportIntegration")",
                type: "POST",
                dataType: "json",
                data: postData,
                success: function(result, textStatus, jqXHR) {
                    if (result !== undefined && typeof result === "boolean") {
                        $("#setNexportUserId").prop("disabled", !result);
                        if (!result) {
                            $("#setNexportUserId").off("click");
                            $("#@Html.IdFor(model => model.NexportUserId)").prop("disabled", true);
                        }
                    }
                },
                error:function(jqXHR, textStatus, errorThrown) {
                    alert(errorThrown);
                }
            });
        }

        function setNexportUserId(element) {
            var userId = element.val();
            if (element.valid()) {
                var getUserDetailData = {
                    nexportUserId: userId
                };
                addAntiForgeryToken(getUserDetailData);

                $.ajax({
                    url: "@Url.Action("GetNexportUserDetails", "NexportIntegration")",
                    type: "POST",
                    dataType: "json",
                    data: getUserDetailData,
                    success: function(userDetail, textStatus, jqXHR) {
                        if (userDetail !== undefined && userDetail) {
                            if (confirm("Are you sure you want to assign the user " + userDetail.firstName + " " + userDetail.lastName + " (" + userDetail.id + ")" + " for this customer?")) {
                                var postData = {
                                    customerId: @Model.CustomerId,
                                    nexportUserId: userId
                                };
                                addAntiForgeryToken(postData);

                                $.ajax({
                                    url: "@Url.Action("SetNexportUser", "NexportIntegration")",
                                    type: "POST",
                                    dataType: "json",
                                    data: postData,
                                    success: function(data, textStatus, jqXHR) {
                                        if (data !== undefined && data && data.redirectUrl) {
                                            window.location.href = data.redirectUrl;
                                        }
                                    },
                                    error: function(jqXHR, textStatus, errorThrown) {
                                        alert(errorThrown);
                                    }
                                });
                            }
                        }
                    },
                    error:function(jqXHR, textStatus, errorThrown) {
                        alert(errorThrown);
                    }
                });

                
            } else{
                element.rules("remove", "dotnet-guid");
                alert("Please input the correct GUID format (xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx) for Nexport user Id!");
            }
        }

        function renderSupplementalInfoAnswerStatusInfo(data, type, row, meta) {
            if (data === +"@((int) NexportSupplementalInfoAnswerStatus.NotProcessed)") {
                return "@NexportSupplementalInfoAnswerStatus.NotProcessed.GetDisplayName()";
            } else if (data === +"@((int) NexportSupplementalInfoAnswerStatus.Processed)") {
                return "@NexportSupplementalInfoAnswerStatus.Processed.GetDisplayName()";
            } else if (data === +"@((int) NexportSupplementalInfoAnswerStatus.Modified)") {
                return "@NexportSupplementalInfoAnswerStatus.Modified.GetDisplayName()";
            } else {
                return "";
            }
        }

        function renderCustomGroupingRow(rows, group, level) {
            var rowData = rows.data();
            if (rowData.count() < 1)
                return "";

            var questionId = rowData.pluck("QuestionId")[0];
            var storeId = rowData.pluck("StoreId")[0];

            var buttonFunction = "editCustomerSupplementalInfoQuestion('" + questionId + "'" + ", '" + storeId + "');return false;";

            var element = "Store - " + rowData.pluck("StoreName")[0] + "<button class=\"btn btn-default\" style=\"margin-left: 5px; margin-top: 1px; margin-bottom: 1px; padding: 5px 12px;\"" +
                " onclick=\"" + buttonFunction + "\"";
            element += "><i class=\"fa fa-pencil\"></i>Edit</button>";

            return element;
        }

        function editCustomerSupplementalInfoQuestion(questionId, storeId) {
            if (questionId < 1) {
                alert("Invalid question Id");
                return;
            }

            if (storeId < 1) {
                alert("Invalid store Id");
                return;
            }

            var url = "@Url.Action("EditCustomerSupplementalInfoAnsweredQuestion", "NexportIntegration")";
            url += "?customerId=@Model.CustomerId";
            url += "&questionId=" + questionId;
            url += "&storeId=" + storeId;
            url += "&containerId=nexport-customer-supplemental-info-answers&btnId=btnRefreshAnswerList";

            OpenWindow(url, 800, 800, true);
        }

        function renderDeleteCustomerSupplementalInfoAnswer(data, type, row, meta) {
            if (!row.Id)
                return "";

            var buttonFunction = "deleteCustomerSupplementalInfoAnswer('" + data + "');return false;";

            return renderCustomButton(buttonFunction, "fa fa-delete", "Delete");
        }

        function deleteCustomerSupplementalInfoAnswer(answerId) {
            if (answerId < 1) {
                alert("Invalid supplermental info answer Id");
                return;
            }

            if (confirm("@T("Admin.Common.DeleteConfirmation")")) {
                var postData = {
                    answerId: answerId
                };
                addAntiForgeryToken(postData);

                $.ajax({
                    url: "@Url.Action("DeleteCustomerSupplementalInfoAnswer", "NexportIntegration")",
                    type: "@WebRequestMethods.Http.Post",
                    dataType: "json",
                    data: postData,
                    success: function(data, textStatus, jqXHR) {
                        // Display error if returned
                        if (data) {
                            display_nop_error(data);
                        }
                        // Refresh grid
                        $("table[id*=nexport-customer-supplemental-info-answers-list]").DataTable().draw(false);
                    },
                    error: function(jqXHR, textStatus, errorThrown) {
                        alert(errorThrown);
                    }
                });
            }

            return;
        }

        function renderEditCustomerRegistrationFieldAnswer(data, type, row, meta) {
            if (!row.Id)
                return "";

            var buttonFunction = "editRegistrationFieldAnswer('" + data + "');return false;";

            return renderCustomButton(buttonFunction, "fa fa-pencil", "Edit");
        }

        function editRegistrationFieldAnswer(fieldId) {
            if (fieldId < 1) {
                alert("Invalid field Id");
                return;
            }

            var url = "@Url.Action("EditCustomerRegistrationFieldAnswers", "NexportIntegration")";
            url += "?customerId=@Model.CustomerId";
            url += "&fieldId=" + fieldId;
            url += "&containerId=nexport-customer-registration-field-answers&btnId=btnRefreshRegistrationAnswerList";

            OpenWindow(url, 800, 800, true);
        }

        function addRegistrationFieldAnswers(storeId) {
            if (storeId < 1) {
                alert("Invalid store Id");
                return;
            }

            var url = "@Url.Action("AddCustomerRegistrationFieldAnswers", "NexportIntegration")";
            url += "?customerId=@Model.CustomerId";
            url += "&storeId=" + storeId;
            url += "&containerId=nexport-customer-registration-field-answers&btnId=btnRefreshRegistrationAnswerList";

            OpenWindow(url, 800, 800, true);
        }

        //# sourceURL=nexport_customer_details.js
    </script>
}
