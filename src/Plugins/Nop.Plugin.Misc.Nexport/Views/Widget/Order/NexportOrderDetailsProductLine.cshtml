@using Nop.Plugin.Misc.Nexport.Services
@using Nop.Services.Orders
@using Nop.Core.Domain.Orders
@using Nop.Plugin.Misc.Nexport.Domain.Enums

@inject IOrderService orderService
@inject NexportService nexportService
@inject IWorkContext workContext

@model Nop.Web.Models.Order.OrderDetailsModel.OrderItemModel

@{
    NopHtml.AddScriptParts(ResourceLocation.Footer, "~/Plugins/Misc.Nexport/Scripts/nexport_common.js");
    var currentCustomer = await workContext.GetCurrentCustomerAsync();
    var nexportCustomer = await nexportService.FindUserMappingByCustomerId(currentCustomer.Id);
}

<style>
    .button-1, .button-2 {
        min-width: 30px;
        border: none;
        padding: 10px 15px;
        text-align: center;
        font-size: 15px;
        color: #fff;
        text-transform: uppercase;
    }

    .button-1 {
        background-color: #4ab2f1;
    }

    .button-2 {
        background-color: #aaa;
    }

    .button-link {
        color: #6898e3 !important;
        text-decoration: underline !important;
    }

        .button-link:hover {
            color: #3081ff !important
        }

    .redemption-links {
        display: flex;
        margin: 0.75em 1em;
    }

        .redemption-links::before {
            content: "\221F";
        }
</style>
@if (Model is { Id: > 0 })
{
    var orderItem = await orderService.GetOrderItemByIdAsync(Model.Id);
    if (orderItem != null)
    {
        var order = await orderService.GetOrderByIdAsync(orderItem.OrderId);
        if (order?.OrderStatus == OrderStatus.Complete)
        {
            var nexportOrderInvoiceItems = await nexportService.FindNexportOrderInvoiceItems(orderItem.OrderId, orderItem.Id);
            if (nexportOrderInvoiceItems is { Count: > 0 })
            {
                var orderInfo = await nexportService.GetWholesaleOrderInfoForOrderItemAsync(orderItem.OrderId, orderItem.Id);
                var mapping = await nexportService.GetProductMappingByNopProductId(orderItem.ProductId, order.StoreId) ?? await nexportService.GetProductMappingByNopProductId(orderItem.ProductId);

                var nexportOrderInvoice = nexportOrderInvoiceItems[0];


                @if (nexportOrderInvoice.RedemptionStatus == NexportOrderInvoiceItemRedemptionStatus.Assigned)
                {
                    if (nexportOrderInvoice.RedeemingUserId == nexportCustomer.NexportUserId)
                    {
                        <div class="redemption-links">
                            <a href="javascript:void(0);" class="button-link" data-id="view-training-link" data-nexport-order-invoice-id="@nexportOrderInvoice.Id">
                                @T("Plugins.Misc.Nexport.Order.ViewRedemption")
                            </a>

                            <div data-id="launch-training-popup" data-nexport-order-invoice-id="@nexportOrderInvoice.Id" title="Launch training" style="display: none;">
                                <div id="redemption-options" style="">
                                    <div style="margin-bottom: 1em;">
                                        <a type="button" class="button-link" href="javascript:void(0);" onclick="navigateToNexportClassroom(this); return false;" data-id="launch-training" data-nexport-order-invoice-id="@nexportOrderInvoice.Id">Click here to view the training in Nexport.</a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="redemption-links">
                        <span style="font-weight: bolder">
                            <a href="javascript:void(0);" class="button-link" data-id="view-redemption-link" data-nexport-order-invoice-id="@nexportOrderInvoice.Id">
                                @T("Plugins.Misc.Nexport.Order.Redeem")
                            </a>
                            <a href="javascript:void(0);" class="button-link" data-id="refreshLink" style="display: none;">Check the redemption</a>
                            <input type="hidden" id="redeemCompleted" data-redeemed=false />

                            <div data-id="redemption-view-popup" data-nexport-order-invoice-id="@nexportOrderInvoice.Id" title="@T("Plugins.Misc.Nexport.Order.Redeem").Text" style="display: none;">
                                <div id="redemption-options" style="">
                                    <div style="margin-bottom: 1em;">
                                        Are you sure you would like to redeem this product?
                                    </div>
                                    <div>
                                        <input type="button" class="button-1 redemption-submit-btn" id="redemption-submit" value="Yes" style="margin-right:1em">
                                        <input type="button" class="button-2 redemption-submit-btn" id="redemption-cancel" value="No">
                                    </div>
                                </div>
                            </div>

                            @if (orderInfo != null)
                            {
                                if (mapping is { AutoRedeem: false })
                                {
                                    <text>&nbsp;/&nbsp;</text>
                                    var urlRef = $"{Url.Action("RedeemProduct", "NexportWholesale")}?GroupId={orderInfo.NexportGroupId}&InvoiceItemId={nexportOrderInvoice.InvoiceItemId}&ProductId={orderItem.ProductId}";
                                    <a href="@urlRef" class="button-link" data-id="assign-redemption-link" data-order-id="orderItem.OrderId">
                                        @T("Plugins.Misc.Nexport.Order.Assign")
                                    </a>
                                }
                            }
                        </span>
                    </div>
                }

                <script asp-location="Footer">
                    function navigateToNexportClassroom(element) {
                        var orderInvoiceItemId = $(element).data("nexport-order-invoice-id");
                        if (orderInvoiceItemId) {
                            var url = "@Url.Action("GoToNexport", "NexportIntegration")";
                            url += "?orderInvoiceItemId=" + orderInvoiceItemId;

                            navigateToNexport(url);
                        }
                    }

                    $(document).ready(function () {
                        $("[data-id=view-redemption-link][data-nexport-order-invoice-id=@nexportOrderInvoice.Id]").on("click", function (e) {
                            var targetWidth = 300;
                            var maxHeight = $(window).height() - 20;

                            $("[data-id=redemption-view-popup][data-nexport-order-invoice-id=@nexportOrderInvoice.Id]").dialog({
                                width: targetWidth,
                                maxHeight: maxHeight,
                                close: function (event, ui) {
                                    if ($("#redeemCompleted").data("redeemed")) {
                                        $("[data-id=view-redemption-link]").hide();
                                        $("[data-id=assign-redemption-link]").hide();
                                        $("[data-id=refreshLink]").show();
                                    }
                                }
                            });
                        });

                        $("[data-id=view-training-link][data-nexport-order-invoice-id=@nexportOrderInvoice.Id]").on("click", function (e) {
                            var targetWidth = 300;
                            var maxHeight = $(window).height() - 20;

                            $("[data-id=launch-training-popup][data-nexport-order-invoice-id=@nexportOrderInvoice.Id]").dialog({
                                width: targetWidth,
                                maxHeight: maxHeight
                            });
                        });

                        $("[data-id=refreshLink]").on("click", function (e) {
                            location.reload();
                        });

                        $("#redemption-cancel").on("click",function (e) {
                            $("[data-id=redemption-view-popup][data-nexport-order-invoice-id=@nexportOrderInvoice.Id]").dialog("close");
                        });

                        $("#redemption-submit").on("click",function (e) {
                            // Call redemption action
                            var postData = {
                                orderItemInvoiceId: "@nexportOrderInvoice.Id"
                            };

                            addAntiForgeryToken(postData);

                            $.ajax({
                                url: "@Url.RouteUrl("Plugin.Misc.Nexport.RedeemOrder")",
                                type: "POST",
                                data: postData,
                                success: function (result) {
                                    $("#redeemCompleted").data("redeemed", true);
                                    $("[data-id=redemption-view-popup][data-nexport-order-invoice-id=@nexportOrderInvoice.Id]").dialog("close");
                                }
                            });
                        });
                    });
                </script>
            }
        }
    }
}