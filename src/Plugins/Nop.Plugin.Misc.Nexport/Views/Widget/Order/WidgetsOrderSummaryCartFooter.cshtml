@using Nop.Core.Domain.Discounts
@using System.Web
@model Nop.Plugin.Misc.Nexport.Models.Order.OrderSummaryCartFooterModel

@{
    var discounts = ViewData["DiscountList"] as List<Discount>;
}

<link rel="stylesheet" href="~/Plugins/Misc.Nexport/Content/nexport.css" />

@if (Model.ShowPurchasingGroupArea)
{
    if (!Model.TogglePurchasingGroupText)
    {
        <div class="cart-collaterals">
            <div class="deals">
                <div class="coupon-box">
                    <div class="title">
                        <strong>
                            Purchasing group
                        </strong>
                    </div>
                    <div>
                        @{
                            var currentPurchasingGroupDisplay = Model.PurchasingGroup == null ? "display: none;" : "";
                        }
                        <div id="current-purchasing-group-container" style="@currentPurchasingGroupDisplay">
                            <text>Current group: <span data-id="current-purchasing-group-name">@Model.PurchasingGroup?.Name</span></text>
                            <span style="margin-left: 5px;">
                                <button type="button" class="delete-btn" onclick="removePurchasingGroupSelection();"></button>
                            </span>
                        </div>
                        <div class="hint">
                            Select the group you would like to purchase for
                        </div>
                        <div>
                            <input id="search-customer-groups" type="text" autocomplete="on" class="form-control" />
                            @Html.TextBoxFor(model => model.PurchasingGroupId, new { style = "display:none" })
                        </div>
                    </div>
                </div>
                <div class="coupon-box">
                    <div class="title">
                        <strong>
                            Funding pool
                        </strong>
                    </div>
                    <div>
                        @{
                            var currentFundingPoolDisplay = Model.FundingPool == null ? "display: none;" : "";
                        }
                        <div id="current-funding-pool-container" style="@currentFundingPoolDisplay">
                            <text>Current funding pool: <span data-id="current-funding-pool-name">@Model.FundingPool?.Name</span></text>
                            <span style="margin-left: 5px;">
                                <button type="button" class="delete-btn" onclick="removeFundingPoolSelection();"></button>
                            </span>
                        </div>
                        <div class="hint">
                            Select the funding pool that will be associated with the purchase
                        </div>
                        <div>
                            <input id="search-funding-pools" type="text" autocomplete="on" class="form-control" />
                            @Html.TextBoxFor(model => model.FundingPoolId, new { style = "display:none" })
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div style="margin: 1em;">
            <div id="selected-purchasing-group" style="display: flex; flex-direction: column; font-weight: bold; color:#444">
            </div>

            <div id="selected-funding-pool" style="display: flex; flex-direction: column; font-weight: bold; color:#444">
            </div>
        </div>
    }

    <script asp-location="Footer">
        function removePurchasingGroupSelection() {
            var postData = { };

            addAntiForgeryToken(postData);

            $.ajax({
                cache: false,
                type: "POST",
                url: "@Url.Action("RemovePurchaseGroupForCustomer", "NexportWholesale")",
                data: postData,
                success: function (data, textStatus, jqXHR) {
                    var container = $("#current-purchasing-group-container");
                    container.fadeOut(600, function() {
                        container.hide();
                    });
                },
                error: function (jqXHR, textStatus, errorThrown) {
                }
            });
        }

        function removeFundingPoolSelection() {
            var postData = { };

            addAntiForgeryToken(postData);

            $.ajax({
                cache: false,
                type: "POST",
                url: "@Url.Action("RemovePurchaseFundingPoolForCustomer", "NexportWholesale")",
                data: postData,
                success: function (data, textStatus, jqXHR) {
                    var container = $("#current-funding-pool-container");
                    container.fadeOut(600, function() {
                        container.hide();
                    });
                },
                error: function (jqXHR, textStatus, errorThrown) {
                }
            });
        }

        $(document).ready(function () {
            var purchasingGroupText = "@(Model.TogglePurchasingGroupText && Model.PurchasingGroup != null ? "Purchasing for group: " + HttpUtility.JavaScriptStringEncode(Model.PurchasingGroup?.Name) : "")";
            $("#selected-purchasing-group").html(purchasingGroupText);

            var fundingPoolText = "@(Model.TogglePurchasingGroupText && Model.FundingPool != null ? "Funding pool: " + HttpUtility.JavaScriptStringEncode(Model.FundingPool?.Name) : "")";
            $("#selected-funding-pool").html(fundingPoolText);

            var source = @Html.Raw(Json.Serialize(Model.AvailableGroups.Select(group => new { label = group.Name, value = group })));
            $("#search-customer-groups").autocomplete({
                delay: 0,
                minLength: 0,
                source: source,
                create: function (event, ui) {
                    var selectedGroup = source.find(x => x.value.Id === "@(Model.PurchasingGroup?.OrganizationId)");
                    if (selectedGroup) {
                        $("#search-customer-groups").data("ui-autocomplete")._trigger("select", "autocompleteselect", { item: { label: selectedGroup.label, value: selectedGroup.value } });
                    }
                    return false;
                },
                select: function (event, ui) {
                    if (ui.item) {
                        //$("#search-customer-groups").val(ui.item.label);
                        $("#@Html.IdFor(model => model.PurchasingGroup)").val(ui.item.value);

                        var postData = {
                            groupSelected: JSON.stringify(ui.item.value)
                        };

                        addAntiForgeryToken(postData);

                        $.ajax({
                            cache: false,
                            type: "POST",
                            url: "@Url.Action("SetPurchaseGroupForCustomer", "NexportWholesale")",
                            data: postData,
                            success: function (data, textStatus, jqXHR) {
                                var container = $("#current-purchasing-group-container");
                                if (container.is(":visible")) {
                                    $("[data-id='current-purchasing-group-name']").html(ui.item.label);
                                    $("#search-customer-groups").val("").blur();
                                } else {
                                    $("[data-id='current-purchasing-group-name']").html(ui.item.label);
                                    container.fadeIn(600, function() {
                                        $("#search-customer-groups").val("").blur();
                                    });
                                }
                            },
                            error: function (jqXHR, textStatus, errorThrown) {
                            }
                        });

                        return false;
                    }
                },
                @* change: function (event, ui) {
                    if (ui.item) {
                        var postData = {
                            groupSelected: JSON.stringify(ui.item.value)
                        };

                        addAntiForgeryToken(postData);

                        $.ajax({
                            cache: false,
                            type: "POST",
                            url: "@Url.Action("SetPurchaseGroupForCustomer", "NexportWholesale")",
                            data: postData,
                            success: function (data, textStatus, jqXHR) {
                            },
                            error: function (jqXHR, textStatus, errorThrown) {
                            }
                        });
                    }
                    else {
                        $("#selected-purchasing-group").html("");
                    }

                    return false;
                } *@
            });

            var fundingPoolData = @Html.Raw(Json.Serialize(Model.AvailableFundingPools.Select(x => new { label = x.Name, value = x })));
            $("#search-funding-pools").autocomplete({
                delay: 0,
                minLength: 0,
                source: fundingPoolData,
                create: function (event, ui) {
                    var selectedItem = source.find(x => x.value.Id === "@(Model.FundingPool?.Id)");
                    if (selectedItem) {
                        $("#search-funding-pools").data("ui-autocomplete")._trigger("select", "autocompleteselect", { item: { label: selectedItem.label, value: selectedItem.value } });
                    }
                    return false;
                },
                select: function (event, ui) {
                    if (ui.item) {
                        //$("#search-funding-pools").val(ui.item.label);
                        $("#@Html.IdFor(model => model.FundingPool)").val(ui.item.value);

                        var postData = {
                            fundingPoolId: JSON.stringify(ui.item.value.Id)
                        };

                        addAntiForgeryToken(postData);

                        $.ajax({
                            cache: false,
                            type: "POST",
                            url: "@Url.Action("SetPurchaseFundingPoolForCustomer", "NexportWholesale")",
                            data: postData,
                            success: function (data, textStatus, jqXHR) {
                                var container = $("#current-funding-pool-container");
                                if (container.is(":visible")) {
                                    $("[data-id='current-funding-pool-name']").html(ui.item.label);
                                    $("#search-funding-pools").val("").blur();
                                } else {
                                    $("[data-id='current-funding-pool-name']").html(ui.item.label);
                                    container.fadeIn(600, function() {
                                        $("#search-funding-pools").val("").blur();
                                    });
                                }
                            },
                            error: function (jqXHR, textStatus, errorThrown) {
                            }
                        });

                        return false;
                    }
                },
                @* change: function (event, ui) {
                    if (ui.item) {
                        var postData = {
                            fundingPoolId: JSON.stringify(ui.item.value.Id)
                        };

                        addAntiForgeryToken(postData);

                        $.ajax({
                            cache: false,
                            type: "POST",
                            url: "@Url.Action("SetPurchaseFundingPoolForCustomer", "NexportWholesale")",
                            data: postData,
                            success: function (data, textStatus, jqXHR) {
                            },
                            error: function (jqXHR, textStatus, errorThrown) {
                            }
                        });
                    }
                    else {
                        $("#selected-funding-pool").html("");
                    }

                    return false;
                } *@
            });
        });
    </script>
}
@if (discounts is { Count: > 0 })
{
    <div style="float: left;">
        <strong>Note: You are currently receiving these discount(s) for this order:</strong>
        <div>
            <ul style="list-style-type: disc; float: left; margin-left: 25px; font-style: italic;">
                @foreach (var discount in discounts)
                {
                    <li>@discount.Name</li>
                }
            </ul>
        </div>
    </div>
    <br />
}