@using Nop.Plugin.Misc.Nexport.Domain.Enums
@using Nop.Plugin.Misc.Nexport.Extensions
@model Nop.Plugin.Misc.Nexport.Models.Wholesale.NexportGroupProductRedemptionListSearchModel
@{
    string GetUrl(DataUrl dataUrl)
    {
        return !string.IsNullOrEmpty(dataUrl?.ActionName) && !string.IsNullOrEmpty(dataUrl.ControllerName)
            ? Url.Action(dataUrl.ActionName, dataUrl.ControllerName, dataUrl.RouteValues)
            : !string.IsNullOrEmpty(dataUrl.Url)
                ? $"{(dataUrl.Url.StartsWith("~/", StringComparison.Ordinal) ? Url.Content(dataUrl.Url) : dataUrl.Url).TrimEnd('/')}" + (!dataUrl.TrimEnd ? "/" : "")
                : string.Empty;
    }

    var currentGroupId = @Model.CurrentGroup.Id?.ToString() ?? "null";

    var groupsRouteUrl = Model.AdminView ? Url.RouteUrl("Plugin.Misc.Nexport.Admin.Groups") : Url.RouteUrl("Plugin.Misc.Nexport.Customer.Groups");
    var groupProductsRouteUrl = Model.AdminView ? Url.RouteUrl("Plugin.Misc.Nexport.Admin.Group.Products") : Url.RouteUrl("Plugin.Misc.Nexport.Customer.Group.Products");
    var groupProductRedemptionsRouteUrl = Model.AdminView ? Url.RouteUrl("Plugin.Misc.Nexport.Admin.Group.Product.Redemptions") : Url.RouteUrl("Plugin.Misc.Nexport.Customer.Group.Product.Redemptions");

    var groupProductRedemptionText = Model.CurrentProduct.Name + " - " + T("Plugins.Misc.Nexport.Group.Product.Redemptions");
   
}
<div class="page-title">
    <nav aria-label="Breadcrumb">
        <ul class="uk-breadcrumb">
            <li >
                <a href="@groupsRouteUrl" title="@T("Plugins.Misc.Nexport.Groups")" >
                    <span>@T("Plugins.Misc.Nexport.Groups")</span>
                </a>
            </li>
            <li >
                <a href="@(groupProductsRouteUrl+"?groupId="+currentGroupId)" title="@T("Plugins.Misc.Nexport.Group.Products")">
                    <span>@Model.CurrentGroup.Name</span>
                </a>
            </li>
            <li >
                @groupProductRedemptionText
                <span id="@(groupProductRedemptionsRouteUrl+"?groupId="+currentGroupId+"&productId="+Model.CurrentProduct.Id)">
                </span>
            </li>
        </ul>
    </nav>
    <h1>@groupProductRedemptionText</h1>
</div>
<div class="page-body">
    <div style="text-align: right;padding-bottom: 1rem;">
        <input type="submit" id="btnRefreshGroupRedemptions" style="display: none">
        Assignments Available: 
        <span style="margin-left: 7px; margin-right: 12px;" id="redemptionsAvailable"></span>
        <button class="uk-button uk-button-default uk-button-small" id="redeemBtn">@T("Plugins.Misc.Nexport.Group.Product.Redemption.Button.Assign")</button>
    </div>
    <table id="redemptions_table" class="uk-table uk-table-divider uk-table-striped" style="width: 100%">
        <thead>
        <tr>
                <th>@T("Plugins.Misc.Nexport.Group.Product.Redemption.Name")</th>
                <th>@T("Plugins.Misc.Nexport.Group.Product.Redemption.Status")</th>
                <th>@T("Plugins.Misc.Nexport.Group.Product.Redemption.DateAssigned")</th>
            <th></th>
        </tr>
        </thead>
    </table>
</div>
<script>
    let groupsTable = new DataTable('#redemptions_table', {
        ajax:
            {
                url: "@Html.Raw(GetUrl(new DataUrl("GetNexportGroupProductRedemptions", "NexportWholesale", null)))?groupId=@(Model.CurrentGroup.Id)&productId=@(Model.CurrentProduct.Id)",
                type: "POST",
                dataType: "json",
                dataSrc: "Data",
                data: function(data) {
                    addAntiForgeryToken(data);
                    return data;
                }
            },
            columns: [
                { data: "Name" },
                { data: "Status" },
                { data: "DateRedeemed" },
                {
                    "mData": "InvoiceItemId",
                    "mRender": function (data, type, row) {
                        if(row.InvoiceItemId!=null){
                            if(row.Status=="@(NexportOrderInvoiceItemRedemptionStatus.Assigned.GetDisplayName())")
                            {
                            return "<center><button class=\"uk-button uk-button-default uk-button-small\" onclick=\"unassignRedemption('" + row.InvoiceItemId + "')\" >@T("Plugins.Misc.Nexport.Group.Product.Redemption.Button.Unassign")</button></center>";
                            }
                        else if (row.Status == "@(NexportOrderInvoiceItemRedemptionStatus.Awaiting.GetDisplayName())") {
                            return "<center><button class=\"uk-button uk-button-default uk-button-small\" onclick=\"cancelAwaitingRedemption('" + row.InvoiceItemId + "')\" >@T("Plugins.Misc.Nexport.Group.Product.Redemption.Button.CancelAwaiting")</button></center>";
                            }
                        }
                        return '';
                    }
                }
            ],
            dom: 'lBfrtip',
            buttons: [
                {
                    className: "fas fa-sync",
                    action: function (e, dt, node, config) {
                        dt.ajax.reload();
                    updateAvailableRedemptions();
                    }
                }
            ],
            order: [[1, 'asc']]
    });
    function unassignRedemption(invoiceItemId) 
    {
        if (confirm('@T("Plugins.Misc.Nexport.Group.Product.Redemptions.Unassign.Confirmation")')) {
            var postData = {
                invoiceItemId: invoiceItemId
            };
            addAntiForgeryToken(postData);

            $.ajax({
                cache: false,
                type: "POST",
                url: "@Url.Action("invoiceItemUnassign", "NexportWholesale")",
                data: postData,
                dataType: "json",
                success: function (data, textStatus, jqXHR) {
                    if (data.result == "@(NexportOrderInvoiceItemRedemptionStatus.ProcessingAvailable.GetDisplayName())") {
                       location.reload();
                   }
                },
                error: function (jqXHR, textStatus, errorThrown) {
                    alert('@T("Plugins.Misc.Nexport.Group.Product.Redemption.Unassign.Failed")');
                }
            });
        }
    }
    function cancelAwaitingRedemption(invoiceItemId) {
        if (confirm('@T("Plugins.Misc.Nexport.Group.Product.Redemption.CancelAwaiting.Confirm")')) {
            var postData = {
                invoiceItemId: invoiceItemId
            };
            addAntiForgeryToken(postData);

            $.ajax({
                cache: false,
                type: "POST",
                url: "@Url.Action("invoiceItemCancelAwaiting", "NexportWholesale")",
                data: postData,
                dataType: "json",
                success: function (data, textStatus, jqXHR) {
                    if (data.result == "@(NexportOrderInvoiceItemRedemptionStatus.Available)") {
                        location.reload();
                    }
                },
                error: function (jqXHR, textStatus, errorThrown) {
                    alert('@T("Plugins.Misc.Nexport.Group.Product.Redemption.CancelAwaiting.Failed")');
                }
            });
        }
    }
    function updateAvailableRedemptions() {
        var redemptionData = { groupId:"@Model.CurrentGroup.Id",productId:"@Model.CurrentProduct.Id" };
        addAntiForgeryToken(redemptionData);

        $.ajax({

            url: "@Html.Raw(GetUrl(new DataUrl("GetAvailableNexportGroupProductRedemptionsCount", "NexportWholesale", null)))",
            type: "POST",
            data:redemptionData,
            success: function (data) {
                if(data.result!=null){
                    $("#redemptionsAvailable").html(data.result);
                    if(data.result<1){
                        $("#redeemBtn").prop("disabled", true);
                    }
                    else{
                        $("#redeemBtn").prop("disabled", false);
                    }
                }
            },
            error: function (error) {
                console.log(`Error ${error}`);
            }
        });
    }
    $(document).ready(function () {
        updateAvailableRedemptions();
        $("#btnRefreshGroupRedemptions").click(function () {

            updateAvailableRedemptions();
            updateTable('#redemptions_table');

            // Return false to not reload a page
            return false;
        });
        $("#redeemBtn").click(function () {
            window.location.href = "@Html.Raw(GetUrl(new DataUrl("RedeemProduct", "NexportWholesale", null)))?GroupId=" + "@currentGroupId" +"&ProductId=" + "@Model.CurrentProduct.Id";
        });
    });
</script>