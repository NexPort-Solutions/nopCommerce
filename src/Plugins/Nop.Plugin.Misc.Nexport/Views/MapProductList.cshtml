@using Nop.Plugin.Misc.Nexport.Areas.Admin.Controllers;
@using Nop.Plugin.Misc.Nexport.Extensions;
@using Nop.Plugin.Misc.Nexport.Models.Catalog
@using Nop.Plugin.Misc.Nexport.Models.Syllabus
@using DataTablesModel = Nop.Plugin.Misc.Nexport.Models.DataTablesModel

@model CatalogSearchModel

@await Html.PartialAsync("~/Plugins/Misc.Nexport/Views/Shared/Table.cshtml", new Nop.Plugin.Misc.Nexport.Models.DataTablesModel
{
    Name = "nexport-catalog-grid",
    UrlRead = new DataUrl(nameof(ProductMappingController.CatalogList), ViewUtilities.GetControllerName<ProductMappingController>(),
        new RouteValueDictionary
        {
            [nameof(Model.OrgId)] = Model.OrgId,
            [nameof(Model.NopProductId)] = Model.NopProductId
        }),
    PrimaryKeyColumn = nameof(CatalogResponseItemModel.CatalogId),
    Length = Model.PageSize,
    LengthMenu = Model.AvailablePageSizes,
    ColumnCollection = new List<ColumnProperty>
    {
        new(null)
        {
            Render = new RenderChildCaret(),
            Width = "5",
            Searchable = false,
            ClassName = NopColumnClassDefaults.ChildControl
        },
        new(nameof(CatalogResponseItemModel.CatalogId))
        {
            Width = "5",
            Render = new RenderCustom("renderCatalogSelection")
        },
        new(nameof(CatalogResponseItemModel.Name))
        {
            Title = "Catalog Name",
            Width = "150"
        },
        new(nameof(CatalogResponseItemModel.UtcDateCreated))
        {
            Title = "Created Date",
            Width = "150",
            Render = new RenderDate()
        },
        new(nameof(CatalogResponseItemModel.UtcDateLastModified))
        {
            Title = "Last Modified Date",
            Width = "150",
            Render = new RenderDate()
        }
    },
    ChildTable = new Nop.Plugin.Misc.Nexport.Models.DataTablesModel
    {
        Name = "nexport-syllabus-grid",
        UrlRead = new DataUrl(nameof(IntegrationController.SyllabusList), ViewUtilities.GetControllerName<IntegrationController>(),
            new RouteValueDictionary
            {
                [nameof(Model.NopProductId)] = Model.NopProductId
            }),
        IsChildTable = true,
        Length = Model.PageSize,
        LengthMenu = Model.AvailablePageSizes,
        Filters = new List<FilterParameter>
        {
            new(nameof(SyllabiResponseItemModel.CatalogId), nameof(CatalogResponseItemModel.CatalogId), true)
        },
        ColumnCollection = new List<ColumnProperty>
        {
            new(nameof(SyllabiResponseItemModel.SyllabusId))
            {
                Width = "5",
                Render = new RenderCustom("renderSyllabusSelection")
            },
            new(nameof(SyllabiResponseItemModel.Name))
            {
                Title = "Name",
                Width = "150"
            },
            new(nameof(SyllabiResponseItemModel.UniqueName))
            {
                Title = "Unique Name",
                Width = "100"
            },
            new(nameof(SyllabiResponseItemModel.SectionNumber))
            {
                Title = "Section Number",
                Width = "100"
            },
            new(nameof(SyllabiResponseItemModel.Type))
            {
                Title = "Type",
                Width = "50",
                Render = new RenderCustom("renderSyllabusType"),
                AutoWidth = false
            },
            new(nameof(SyllabiResponseItemModel.ProductId))
            {
                Title = "Product Id",
                Width = "150"
            }
        }
    }
})

<script>
    $(document).ready(function() {
        $("#map-nexport-product-form").on("change", $(":radio"), function() {
            setMappingInfoRequirement();
        });
    });

    function setMappingInfoRequirement() {
        var selectedProduct = $("[data-control=nexport-product-selection]:checked");
        if (selectedProduct) {
            $("#nexport-product-container").find("[name=CatalogId]").val(selectedProduct.data("catalog-id"));
            $("#nexport-product-container").find("[name=SyllabusId]").val(selectedProduct.data("syllabus-id"));
            $("#nexport-product-container").find("[name=ProductId]").val(selectedProduct.data("product-id"));
            $("#nexport-product-container").find("[name=ProductType]").val(selectedProduct.data("product-type"));
        }
    }

    function renderSyllabusType(data, type, row, meta) {
        if (data === 1) {
            return "Training Plan";
        }

        return "Section";
    }

    function renderCatalogSelection(data, type, row, meta) {
        var renderControl = "<input type=\"radio\" data-control=\"nexport-product-selection\" name=\"nexport-product-selection\" value=\"" + row.CatalogId +
            "\" data-catalog-id=\""+ row.CatalogId + "\" data-product-id=\"" + row.CatalogId + "\" data-product-type=\"0\"";

        renderControl += ">";

        return renderControl;
    }

    function renderSyllabusSelection(data, type, row, meta) {
        var productType = +row.Type + 1;

        var renderControl = "<input type=\"radio\" data-control=\"nexport-product-selection\" name=\"nexport-product-selection\" value=\"" + row.SyllabusId +
            "\" data-catalog-id=\""+ row.CatalogId + "\" data-syllabus-id=\"" + row.SyllabusId +
            "\" data-product-id=\"" + row.ProductId + "\" data-product-type=\"" + productType + "\"";

        renderControl += ">";

        return renderControl;
    }

    //# sourceURL=MapProductList.js
</script>