@model Nop.Plugin.Misc.Nexport.Models.Wholesale.RedeemByEmailModel
@{
    Layout = "_ColumnsOne";
}
<div class="page-title">
    <h1>Redeem By Email</h1>
</div>
<div class="page-body">
    <div class="section invoice-item">
        <div class="title">
            <strong>InvoiceItem:@Model.InvoiceItemId</strong>
        </div>
        <ul class="info" style="text-align: center;margin-bottom:15px">
            <li>Product Name: @Model.ProductName </li>
            <li>Date Redeemed:@Model.RedeemedDate</li>
            <li>Status: @(Model.Redeemed? "Successfully Redeemed":"Awaiting Redemption")</li>
        </ul>
        <div class="buttons">
            <button type="button" class="button-2 redeem-item-button">@(Model.Redeemed?"Go to training":"Redeem")</button>
        </div> 
    </div>
</div>