@model Nop.Plugin.Misc.Nexport.Models.Wholesale.NexportGroupProductListSearchModel

@{
    string GetUrl(DataUrl dataUrl)
    {
        return !string.IsNullOrEmpty(dataUrl?.ActionName) && !string.IsNullOrEmpty(dataUrl.ControllerName)
            ? Url.Action(dataUrl.ActionName, dataUrl.ControllerName, dataUrl.RouteValues)
            : !string.IsNullOrEmpty(dataUrl.Url)
                ? $"{(dataUrl.Url.StartsWith("~/", StringComparison.Ordinal) ? Url.Content(dataUrl.Url) : dataUrl.Url).TrimEnd('/')}" + (!dataUrl.TrimEnd ? "/" : "")
                : string.Empty;
    }
    var groupsRouteUrl = Model.AdminView ? Url.RouteUrl("Plugin.Misc.Nexport.Admin.Groups") : Url.RouteUrl("Plugin.Misc.Nexport.Customer.Groups");
    var groupProductsRouteUrl = Model.AdminView ? Url.RouteUrl("Plugin.Misc.Nexport.Admin.Group.Products") : Url.RouteUrl("Plugin.Misc.Nexport.Customer.Group.Products");
    var groupProductRedemptionsRouteUrl = Model.AdminView ? Url.RouteUrl("Plugin.Misc.Nexport.Admin.Group.Product.Redemptions") : Url.RouteUrl("Plugin.Misc.Nexport.Customer.Group.Product.Redemptions");

    var groupProductText = (Model.CurrentGroup != null ? Model.CurrentGroup.Name : @T("Plugins.Misc.Nexport.Group.NoGroup")) + " - " + T("Plugins.Misc.Nexport.Group.Products");

    var currentGroupId = @Model.CurrentGroup.Id?.ToString() ?? "null";
}
<div class="page-title">
    <nav aria-label="Breadcrumb">
        <ul class="uk-breadcrumb">
            <li >
                <a href="@groupsRouteUrl" title="@T("Plugins.Misc.Nexport.Groups")">
                    <span>@T("Plugins.Misc.Nexport.Groups")</span>
                </a>
            </li>
            <li >
                @groupProductText
                <span id="@(groupProductsRouteUrl+"?groupId="+currentGroupId)">
                </span>
            </li>
        </ul>
    </nav>
    <h1>@groupProductText</h1>
</div>
<div class="page-body">
    <table id="products_table" class="uk-table uk-table-divider uk-table-striped" style="width:100%">
        <thead>
            <tr>
                <th>@T("Plugins.Misc.Nexport.Group.Product.Name")</th>
                <th>@T("Plugins.Misc.Nexport.Group.Product.Available")</th>
                <th>@T("Plugins.Misc.Nexport.Group.Product.Awaiting")</th>
                <th>@T("Plugins.Misc.Nexport.Group.Product.Assigned")</th>
                <th></th>
            </tr>
        </thead>
    </table>
</div>
<script>
    let productsTable = new DataTable('#products_table', {
        ajax:
            {
                url: "@Html.Raw(GetUrl(new DataUrl("GetNexportGroupProducts", "NexportWholesale", null)))?groupId=@(Model.CurrentGroup.Id)",
                type: "POST",
                dataType: "json",
                dataSrc: "Data",
                data: function(data) {
                    addAntiForgeryToken(data);
                    return data;
                }
            },
            columns:[
                { data: "Name" },
                { data: "Available" },
                { data: "Awaiting" },
                { data: "Redeemed" },
                {
                "mData": "Id",
                "mRender": function (data, type, row) {
                    return '<center><button class="uk-button uk-button-default uk-button-small" onClick="goToGroupProductRedemptions(' + row.Id + ',\'' + row.GroupId + '\')" ><i class="far fa-eye"/><span style="margin-left:5px;">@T("Plugins.Misc.Nexport.Group.Product.Button.View")</span></button></center>';
                }
            }
            ],
            dom: 'lBfrtip',
            buttons: [
                {
                    className: "fas fa-sync",
                    action: function (e, dt, node, config) {
                        dt.ajax.reload();
                    }
                }
            ],
        order: [[1, 'asc']]
    });
    function goToGroupProductRedemptions(productId,groupId){
        window.location.href = "@groupProductRedemptionsRouteUrl?GroupId="+groupId+"&ProductId="+productId;
    }
</script>