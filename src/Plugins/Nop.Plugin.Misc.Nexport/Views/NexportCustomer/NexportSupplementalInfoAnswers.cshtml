@using Nop.Plugin.Misc.Nexport.Services

@inject IWebHelper webHelper
@inject NexportService nexportService

@model Nop.Plugin.Misc.Nexport.Models.SupplementalInfo.NexportCustomerSupplementalInfoAnswersModel

@{
    Layout = "_ColumnsTwo";

    var kendoVersion = "2020.1.406";

    NopHtml.AppendPageCssClassParts("html-account-page");
    NopHtml.AddTitleParts(T("Plugins.Misc.Nexport.Navigation.SupplementalInfoAnswers").Text);
}

<link rel="stylesheet" href="~/lib/kendo/@kendoVersion/styles/web/kendo.common.min.css" />
<link rel="stylesheet" href="~/lib/kendo/@kendoVersion/styles/web/kendo.default.min.css" />
<link rel="stylesheet" href="~/lib/kendo/@kendoVersion/styles/web/kendo.rtl.min.css" />
<link rel="stylesheet" href="~/Plugins/Misc.Nexport/Content/nexport.css" />
<script src="~/lib/kendo/@kendoVersion/js/kendo.ui.core.min.js"></script>
<script src="~/js/public.accordion.js"></script>

@section left
{
    @await Component.InvokeAsync("CustomerNavigation", new { selectedTabId = 1002 })
}

<div class="page account-page supplemental-info-customer-answers-page">
    <div class="page-title">
        <h1>@T("Account.MyAccount") - @T("Plugins.Misc.Nexport.Navigation.MyAccount.SupplementalInfoAnswers.PageTitle")</h1>
    </div>
    <div class="page-body">
        @if (Model != null)
        {
            @if (Model.QuestionWithAnswersList.Count > 0)
            {
                @foreach (var (questionId, answerList) in Model.QuestionWithAnswersList)
                {
                    var question = await nexportService.GetNexportSupplementalInfoQuestionById(questionId);
                    if (question != null)
                    {
                        <div class="section supplemental-info-customer-answer-item">
                            <div class="title supplemental-info-question-text">
                                <strong>Question: <span>@question.QuestionText</span></strong>
                            </div>
                            @{
                                if (answerList.Count > 0)
                                {
                                    <div class="info supplemental-info-customer-answers">
                                        Your answer(s):

                                        @{
                                            var options =
                                                    (await (await answerList.SelectAwait(async answerWithOption=>
                                                        await nexportService.GetNexportSupplementalInfoAnswerById(answerWithOption.Key))
                                                    .ToListAsync())
                                                    .Where(answer => answer != null)
                                                    .SelectAwait(async answer =>
                                                        await nexportService.GetNexportSupplementalInfoOptionById(answer.OptionId))
                                                    .ToListAsync())
                                                    .Where(option => option != null);
                                        }

                                        @foreach (var option in options)
                                        {
                                            <div class="supplemental-info-customer-answer-item">
                                                <span>@option.OptionText</span>
                                            </div>
                                        }
                                    </div>
                                }
                            }
                            <div class="buttons">
                                <input type="button" class="button-2 modify-supplemental-info-answer-button"
                                       onclick="location.href = '/customer/nexportsuplementalinfoanswers/edit/@questionId'"
                                       value="@T("Plugins.Misc.Nexport.SupplementalInfo.Customer.Edit").Text">
                            </div>
                        </div>
                    }
                }
            }
        }
    </div>
</div>