@model Nop.Plugin.Misc.Nexport.Models.Customer.CustomerMissingInfoModel

@{
    Layout = "_ColumnsOne";

    //title
    NopHtml.AddTitleParts("Account - Missing user information");
    //page class
    NopHtml.AppendPageCssClassParts("html-login-page");
}

<div class="page login-page">
    <div class="page-title">
        <h1>My account - Customer info</h1>
    </div>
    <div class="page-body">
        <form asp-action="UpdateMissingCustomerInfo" asp-controller="NexportIntegration" method="post">
            <div class="fieldset">
                <div class="title">
                    <strong>Please fill in the below missing info:</strong>
                </div>
                <div class="form-fields">
                    <div class="inputs">
                        <label asp-for="FirstName" asp-postfix=":"></label>
                        <input asp-for="FirstName" />
                        <nop-required />
                        <span asp-validation-for="FirstName"></span>
                    </div>
                    <div class="inputs">
                        <label asp-for="LastName" asp-postfix=":"></label>
                        <input asp-for="LastName" />
                        <nop-required />
                        <span asp-validation-for="LastName"></span>
                    </div>
                </div>
            </div>
            <div class="buttons">
                <button type="submit" id="save-missing-info-button" name="save-missing-info-button" class="button-1 save-customer-info-button">@T("Common.Save")</button>
            </div>
        </form>
    </div>
</div>