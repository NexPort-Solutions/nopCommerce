@model Nop.Plugin.Misc.Nexport.Models.SupplementalInfo.NexportSupplementalInfoOptionModel

@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminPopupLayout.cshtml";

    //page title
    ViewBag.PageTitle = "Edit option";
}

<script src="~/Plugins/Misc.Nexport/Scripts/nexport_plugin_common.js"></script>

<form asp-controller="NexportIntegration" asp-action="SupplementalInfoOptionEditPopup"
      asp-route-btnId="@Context.Request.Query["btnId"]"
      asp-route-formId="@Context.Request.Query["formId"]">
    <div class="content-header clearfix">
        <h1 class="float-left">
            Edit supplemental info option
        </h1>
        <div class="float-right">
            <button type="submit" name="save" class="btn btn-primary">
                <i class="far fa-save"></i>
                @T("Admin.Common.Save")
            </button>
        </div>
    </div>
    @await Html.PartialAsync("~/Plugins/Misc.Nexport/Views/SupplementalInfo/Option/_CreateOrUpdate.Option.cshtml", Model)
</form>