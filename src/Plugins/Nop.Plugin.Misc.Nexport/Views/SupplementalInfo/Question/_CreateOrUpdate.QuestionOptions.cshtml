@using Nop.Plugin.Misc.Nexport.Areas.Admin.Controllers;
@using Nop.Plugin.Misc.Nexport.Extensions;
@using Nop.Plugin.Misc.Nexport.Models.SupplementalInfo

@model Nop.Plugin.Misc.Nexport.Models.SupplementalInfo.SupplementalInfoQuestionModel

<script src="~/Plugins/Misc.Nexport/Scripts/nexport_plugin_common.js"></script>

@if (Model.Id > 0)
{
    <div class="card-body">
        <p>
            Question options
        </p>
        @await Html.PartialAsync("~/Plugins/Misc.Nexport/Views/Shared/Table.cshtml", new Nop.Plugin.Misc.Nexport.Models.DataTablesModel
        {
            Name = "supplemental-info-question-options-grid",
            UrlRead = new DataUrl(
                nameof(SupplementalInfoController.SupplementalInfoOptionList),
                ViewUtilities.GetControllerName<SupplementalInfoController>(),
                new RouteValueDictionary
                {
                    [nameof(Model.SupplementalInfoOptionSearchModel.QuestionId)] = Model.SupplementalInfoOptionSearchModel.QuestionId
                }),
            UrlDelete = new DataUrl(
                nameof(SupplementalInfoController.DeleteSupplementalInfoOption),
                ViewUtilities.GetControllerName<SupplementalInfoController>(),
                null),
            Length = Model.SupplementalInfoOptionSearchModel.PageSize,
            LengthMenu = Model.SupplementalInfoOptionSearchModel.AvailablePageSizes,
            ColumnCollection = new List<ColumnProperty>
            {
                new(nameof(SupplementalInfoOptionModel.OptionText))
                {
                    Title = "Option",
                    Width = "200"
                },
                new(nameof(SupplementalInfoOptionModel.UtcDateCreated))
                {
                    Title = "Date Created",
                    Width = "200",
                    Render = new RenderCustom("renderLocalDateForTableEntry")
                },
                new(nameof(SupplementalInfoOptionModel.UtcDateModified))
                {
                    Title = "Date Modified",
                    Width = "200",
                    Render = new RenderCustom("renderLocalDateForTableEntry")
                },
                new(nameof(SupplementalInfoOptionModel.Id))
                {
                    Title = "Edit",
                    Width = "100",
                    ClassName = NopColumnClassDefaults.Button,
                    Render = new RenderCustom("renderEditSupplementalInfoOption")
                },
                new(nameof(SupplementalInfoOptionModel.Id))
                {
                    Width = "100",
                    ClassName = NopColumnClassDefaults.Button,
                    Render = new RenderButtonRemove("Delete")
                }
            }
        })

    <script>
        function renderEditSupplementalInfoOption(data, type, row, meta) {
                var url = "@Url.Action(nameof(SupplementalInfoController.SupplementalInfoOptionEditPopup), ViewUtilities.GetControllerName<SupplementalInfoController>())";
            url += "?optionId=" + data;
            url += "&formId=edit-supplemental-info-question-form&btnId=btnRefresh";

            var buttonFunction = "javascript:OpenWindow('" + url + "', 800, 800, true); return false;";
            return renderCustomButton(buttonFunction, "fa fa-pencil", "@T("Admin.Common.Edit")");
        }
    </script>
    </div>
    <div class="card-footer">
        <button type="submit" id="btnAddNewQuestionOption"
                onclick="javascript:OpenWindow('@(Url.Action(nameof(SupplementalInfoController.SupplementalInfoOptionCreatePopup),
                                                    ViewUtilities.GetControllerName<SupplementalInfoController>(),
                                                    new {
                                                        questionId = Model.Id,
                                                        btnId = "btnRefresh",
                                                        formId = "edit-supplemental-info-question-form" }))',
                                                800, 550, true); return false;" class="btn btn-primary">
            Add a new option
        </button>
        <input type="submit" id="btnRefresh" style="display: none;" />
        <script>
            $(document).ready(function () {
                $('#btnRefresh').click(function () {
                    updateTable("#supplemental-info-question-options-grid");

                    return false;
                });
            });
        </script>
    </div>
}
else
{
    <div class="card-body">
        You need to save the supplemental info question before you can add its options.
    </div>
}