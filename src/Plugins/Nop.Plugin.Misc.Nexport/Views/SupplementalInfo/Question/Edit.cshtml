@using Nop.Plugin.Misc.Nexport.Areas.Admin.Controllers;
@using Nop.Plugin.Misc.Nexport.Extensions;
@model Nop.Plugin.Misc.Nexport.Models.SupplementalInfo.SupplementalInfoQuestionModel

@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewBag.PageTitle = "Edit";
    NopHtml.SetActiveMenuItemSystemName(SystemNames.SUPPLEMENTAL_INFO);
}

<form asp-controller="SupplementalInfo" asp-action="EditSupplementalInfoQuestion" method="post" id="edit-supplemental-info-question-form">
    <div class="content-header clearfix">
        <h1 class="float-left">
            Edit supplemental info question - @Model.QuestionText
            <small>
                <i class="fas fa-arrow-circle-left"></i>
                <a asp-action="ListSupplementalInfoQuestion" asp-controller="SupplementalInfo">back to list</a>
            </small>
        </h1>
        <div class="float-right">
            <button type="submit" name="save" class="btn btn-primary">
                <i class="far fa-save"></i>
                @T("Admin.Common.Save")
            </button>
            <button type="submit" name="save-continue" class="btn btn-primary">
                <i class="far fa-save"></i>
                @T("Admin.Common.SaveContinue")
            </button>
            <span id="supplemental-info-question-delete" class="btn bg-red">
                <i class="fa fa-trash-o"></i>
                @T("Admin.Common.Delete")
            </span>
        </div>
    </div>
    @await Html.PartialAsync("~/Plugins/Misc.Nexport/Views/SupplementalInfo/Question/_CreateOrUpdate.cshtml", Model)
</form>
<nop-delete-confirmation asp-model-id="@Model.Id" asp-button-id="supplemental-info-question-delete" asp-action="DeleteSupplementalInfoQuestion" />