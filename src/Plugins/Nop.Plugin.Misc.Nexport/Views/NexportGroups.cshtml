@model Nop.Plugin.Misc.Nexport.Models.Wholesale.NexportGroupListSearchModel

@{
    Layout = "_ColumnsOne";

    NopHtml.AppendPageCssClassParts("html-account-page");

    string GetUrl(DataUrl dataUrl)
    {
        return !string.IsNullOrEmpty(dataUrl?.ActionName) && !string.IsNullOrEmpty(dataUrl.ControllerName)
            ? Url.Action(dataUrl.ActionName, dataUrl.ControllerName, dataUrl.RouteValues)
            : !string.IsNullOrEmpty(dataUrl.Url)
                ? $"{(dataUrl.Url.StartsWith("~/", StringComparison.Ordinal) ? Url.Content(dataUrl.Url) : dataUrl.Url).TrimEnd('/')}" + (!dataUrl.TrimEnd ? "/" : "")
                : string.Empty;
    }

    string ReplaceName(string str)
    {
        return str.Replace("-", "_");
    }

    void GetAllModels(DataTablesModel model, List<DataTablesModel> models)
    {
        models.Add(model);
        if (!string.IsNullOrEmpty(model.ChildTable?.Name))
        {
            GetAllModels(model.ChildTable, models);
        }
    }
}

<link rel="stylesheet" href="~/lib_npm/datatables.net-bs4/css/dataTables.bootstrap4.min.css" />
<link rel="stylesheet" href="~/lib_npm/bootstrap/css/bootstrap.min.css" />
<link rel="stylesheet" href=@("~/lib_npm/@fortawesome/fontawesome-free/css/all.min.css") />

<div class="page account-page">

    <div class="page-title">
        <h1>@T("Account.MyAccount") - @T("Plugins.Misc.Nexport.Groups")</h1>
    </div>
    <div class="page-body">
        <table id="groups_table" class="table table-bordered" style="width:100%">
            <thead>
            <tr>
                <th></th>
                <th>Name</th>
                <th>Short Name</th>
                <th>Products Purchased</th>
            </tr>
            </thead>
        </table>
    </div>
</div>

<script src="~/lib_npm/jquery/jquery.min.js"></script>
<script src="~/lib_npm/jquery-ui-dist/jquery-ui.min.js"></script>
<script src="~/lib_npm/datatables.net/js/jquery.dataTables.min.js"></script>
<script src="~/lib_npm/datatables.net-bs4/js/dataTables.bootstrap4.min.js"></script>

<script>
    
    let groupsTable = new DataTable('#groups_table', {
        ajax:
        {
            url: "@Html.Raw(GetUrl(new DataUrl("GetNexportGroups", "NexportWholesale", null)))",
            type: "POST",
            dataType: "json",
            dataSrc: "Data",
            data: function(data) {
                addAntiForgeryToken(data);
                return data;
            }
        },
        columns: [
            {
                className: 'groups-td dt-control',
                orderable: false,
                data: null,
                defaultContent: ''
            },
            { data: 'Name' },
            { data: 'ShortName' },
            { data: 'NumberOfProducts' },
        ],
        order: [[1, 'asc']]
    });

    // Add event listener for opening and closing details
    groupsTable.on('click', 'td.groups-td.dt-control', function (e) {
        let tr = e.target.closest('tr');
        let row = groupsTable.row(tr);

        if (row.child.isShown()) {
            // This row is already open - close it
            destroyChild(row);
            //row.child.hide();
        }
        else {
            // Open this row
            createProductsTable(row);
           // row.child(format(row.data())).show();
        }
    });
    function createProductsTable(row) {
        // This is the table we'll convert into a DataTable
        var productsTableElem = $('<table class="table table-bordered" width="100%"><thead><tr><th></th><th>Product Name</th><th>Available</th><th>Awaiting</th><th>Redeemed</th></tr></thead></table>');
        
        var rowData = row.data();
        
        // Display it the child row
        row.child(productsTableElem).show();
        
        var url = "@Html.Raw(GetUrl(new DataUrl("GetNexportGroupProducts", "NexportWholesale", null)))";
        url+="?groupId="+rowData.Id;
        // Initialise as a DataTable
        var productsTable = productsTableElem.DataTable({
            ajax:
            {
                url: url,
                type: "POST",
                dataType: "json",
                dataSrc: "Data",
                data: function(data) {
                    addAntiForgeryToken(data);
                    return data;
                }
            },
            columns:[
                {
                    className: 'products-td dt-control',
                    orderable: false,
                    data: null,
                    defaultContent: ''
                },
                { data: "Name" },
                { data: "Available" },
                { data: "Awaiting" },
                { data: "Redeemed" }
            ]
        });
        
        productsTable.on('click', 'td.products-td.dt-control', function (e) {
            let tr = e.target.closest('tr');
            let row = productsTable.row(tr);

            if (row.child.isShown()) {
                // This row is already open - close it
                destroyChild(row);
            }
            else {
                // Open this row
                createCustomersTable(row);
            }
        });
    }
    
    function createCustomersTable(row) {
        // This is the table we'll convert into a DataTable
        var customersTableElem = $('<table class="table table-bordered" width="100%"><thead><tr><th>Name</th><th>email</th><th>status</th><th></th></tr></thead></table>');
        
        var rowData = row.data();

        // Display the child row
        row.child(customersTableElem).show();
        
        var url="@Html.Raw(GetUrl(new DataUrl("GetNexportGroupProductCustomers", "NexportWholesale", null)))";
        url+="?GroupId="+rowData.GroupId
        url+="&ProductId="+rowData.Id

        // Initialize as a DataTable
        var customersTable = customersTableElem.DataTable({
            ajax:
            {
                url: url,
                type: "POST",
                dataType: "json",
                dataSrc: "Data",
                data: function(data) {
                    addAntiForgeryToken(data);
                    return data;
                }
            },
            columns: [
                { data: "Name" },
                { data: "Email" },
                { data: "Status" },
                {
                    "mData": "Status",
                    "mRender": function (data, type, row) {
                        if(data=="Available"){
                            return '<center><button class="btn btn-secondary">Redeem</button></center>';
                        }
                        else if(data=="Awaiting"){
                            return '<center><button class="btn btn-secondary">Cancel</button></center>';
                        }
                        else if(data=="Redeemed"){
                            return '<center><button class="btn btn-secondary">Unassign</button></center>';
                        }
                        return '';
                    }
                }
            ]
        });
    }

    function destroyChild(row) {
        var childTable = $("table", row.child());
        childTable.detach();
        childTable.DataTable().destroy();

        // And then hide the row
        row.child.hide();
    }
</script>