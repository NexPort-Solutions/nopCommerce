@using Nop.Plugin.Misc.Nexport.Domain.Enums
@using Nop.Plugin.Misc.Nexport.Domain;
@using Nop.Plugin.Misc.Nexport.Extensions
@using Nop.Services.Helpers

@inject IDateTimeHelper dateTimeHelper

@model Nop.Plugin.Misc.Nexport.Models.ProductMappings.ProductMappingModel

@if (Model is { Id: > 0 })
{
    <input type="hidden" name="Id" value="@Model.Id" />
    <input type="hidden" name="NopProductId" value="@Model.NopProductId" />

    <div class="form-group row">
        <div class="col-sm-5 col-md-4">
            <nop-label asp-for="ProductName" />
        </div>
        <div class="col-sm-7 col-md-8">
            <input type="hidden" name="ProductName" value="@Model.ProductName" />
            <div class="form-text-row">@Model.ProductName</div>
        </div>
    </div>
    <div class="form-group row">
        <div class="col-sm-5 col-md-4">
            <nop-label asp-for="DisplayName" />
        </div>
        <div class="col-sm-7 col-md-8">
            <input type="hidden" name="DisplayName" value="@Model.DisplayName" />
            <div class="form-text-row">@Model.DisplayName</div>
        </div>
    </div>
    <div class="form-group row">
        <div class="col-sm-5 col-md-4">
            <nop-label asp-for="CatalogId" />
        </div>
        <div class="col-sm-7 col-md-8">
            <input type="hidden" name="CatalogId" value="@Model.CatalogId" />
            <div class="form-text-row">@Model.CatalogId</div>
        </div>
    </div>
    @if (Model.CatalogSyllabusLinkId.HasValue)
    {
        <div class="form-group row">
            <div class="col-sm-5 col-md-4">
                <nop-label asp-for="CatalogSyllabusLinkId" />
            </div>
            <div class="col-sm-7 col-md-8">
                <input type="hidden" name="CatalogSyllabusLinkId" value="@Model.CatalogSyllabusLinkId" />
                <div class="form-text-row">@Model.CatalogSyllabusLinkId</div>
            </div>
        </div>
    }
    @if (Model.SyllabusId.HasValue)
    {
        <div class="form-group row">
            <div class="col-sm-5 col-md-4">
                <nop-label asp-for="SyllabusId" />
            </div>
            <div class="col-sm-7 col-md-8">
                <input type="hidden" name="SyllabusId" value="@Model.SyllabusId" />
                <div class="form-text-row">@Model.SyllabusId</div>
            </div>
        </div>
    }
    <div class="form-group row">
        <div class="col-sm-5 col-md-4">
            <nop-label asp-for="Type" />
        </div>
        <div class="col-sm-7 col-md-8">
            <input type="hidden" name="Type" value="@Model.Type" />
            <div class="form-text-row">@Model.Type.GetDisplayName()</div>
        </div>
    </div>
    @if (Model.PricingModel is { } pricingModel)
    {
        <div class="form-group row">
            <div class="col-sm-5 col-md-4">
                <nop-label asp-for="PricingModel" />
            </div>
            <div class="col-sm-7 col-md-8">
                <div class="form-text-row">@pricingModel.GetDisplayName()</div>
            </div>
        </div>
    }
    @if (Model.PublishingModel is { } publishingModel)
    {
        <div class="form-group row">
            <div class="col-sm-5 col-md-4">
                <nop-label asp-for="PublishingModel" />
            </div>
            <div class="col-sm-7 col-md-8">
                <div class="form-text-row">@publishingModel.GetDisplayName()</div>
            </div>
        </div>
    }
    @if (Model.CreditHours is { } creditHours)
    {
        <div class="form-group row">
            <div class="col-sm-5 col-md-4">
                <nop-label asp-for="CreditHours" />
            </div>
            <div class="col-sm-7 col-md-8">
                <div class="form-text-row">@decimal.Round(creditHours, 2)</div>
            </div>
        </div>
    }
    @if (Model.Type is ProductType.Section)
    {
        <div class="form-group row">
            <div class="col-sm-5 col-md-4">
                <nop-label asp-for="SectionCeus" />
            </div>
            <div class="col-sm-7 col-md-8">
                <div class="form-text-row">@Model.SectionCeus</div>
            </div>
        </div>
        <div class="form-group row">
            <div class="col-sm-5 col-md-4">
                <nop-label asp-for="SectionNumber" />
            </div>
            <div class="col-sm-7 col-md-8">
                <div class="form-text-row">@Model.SectionNumber</div>
            </div>
        </div>
    }
    @if (Model.Type is not ProductType.Catalog)
    {
        <div class="form-group row">
            <div class="col-sm-5 col-md-4">
                <nop-label asp-for="UniqueName" />
            </div>
            <div class="col-sm-7 col-md-8">
                <div class="form-text-row">@Model.UniqueName</div>
            </div>
        </div>
    }
    @if (!Model.Editable)
    {
        if (Model.AccessTimeLimit is { } timeLimit and not "")
        {
            <div class="form-group row">
                <div class="col-sm-5 col-md-4">
                    <nop-label asp-for="AccessTimeLimit" />
                </div>
                <div class="col-sm-7 col-md-8">
                    <div class="form-text-row">@timeLimit</div>
                </div>
            </div>
        }
        if (Model.UtcAccessExpirationDate is { } accessExpirationDate)
        {
            <div class="form-group row">
                <div class="col-sm-5 col-md-4">
                    <nop-label asp-for="UtcAccessExpirationDate" />
                </div>
                <div class="col-sm-7 col-md-8">
                    <div class="form-text-row">@((await dateTimeHelper.ConvertToUserTimeAsync(accessExpirationDate)).ToString("f"))</div>
                </div>
            </div>
        }
        <div class="form-group row">
            <div class="col-sm-5 col-md-4">
                <nop-label asp-for="AutoRedeem" />
            </div>
            <div class="col-sm-7 col-md-8">
                <div class="form-text-row">
                    @if (Model.AutoRedeem)
                    {
                        <text>Yes</text>
                    }
                    else
                    {
                        <text>No</text>
                    }
                </div>
            </div>
        </div>
    }
    @if (Model.UtcAvailableDate is { } availableDate)
    {
        <div class="form-group row">
            <div class="col-sm-5 col-md-4">
                <nop-label asp-for="UtcAvailableDate" />
            </div>
            <div class="col-sm-7 col-md-8">
                <div class="form-text-row">@((await dateTimeHelper.ConvertToUserTimeAsync(availableDate)).ToString("f"))</div>
            </div>
        </div>
    }
    @if (Model.UtcEndDate is { } endDate)
    {
        <div class="form-group row">
            <div class="col-sm-5 col-md-4">
                <nop-label asp-for="UtcEndDate" />
            </div>
            <div class="col-sm-7 col-md-8">
                <div class="form-text-row">@((await dateTimeHelper.ConvertToUserTimeAsync(endDate)).ToString("f"))</div>
            </div>
        </div>
    }
    <div class="form-group row">
        <div class="col-sm-5 col-md-4">
            <nop-label asp-for="UtcLastModifiedDate" />
        </div>
        <div class="col-sm-7 col-md-8">
            <div class="form-text-row">
                @if (Model.UtcLastModifiedDate is { } lastModifiedDate)
                {
                    @((await dateTimeHelper.ConvertToUserTimeAsync(lastModifiedDate, DateTimeKind.Utc)).ToString("f"))
                }
            </div>
        </div>
    </div>
    <div class="form-group row">
        <div class="col-sm-5 col-md-4">
            <nop-label asp-for="IsSynchronized" />
        </div>
        <div class="col-sm-7 col-md-8">
            <div class="form-text-row">
                <text>@(Model.IsSynchronized ? "Yes" : "No")</text>
            </div>
        </div>
    </div>
    @if (Model.IsSynchronized && Model.UtcLastSynchronizationDate is { } lastSynchronizationDate)
    {
        <div class="form-group row">
            <div class="col-sm-5 col-md-4">
                <nop-label asp-for="UtcLastSynchronizationDate" />
            </div>
            <div class="col-sm-7 col-md-8">
                <div class="form-text-row">@((await dateTimeHelper.ConvertToUserTimeAsync(lastSynchronizationDate)).ToString("f"))</div>
            </div>
        </div>
    }
}