    .redemption-statuses {
        margin-bottom: 1em;
    }
    .redemption-statuses a {
        color: #4ab2f1;
        margin-left: 0.3em;
    }
    .redemption-statuses a:hover {
        color: #248ece;
    }
    .redemption-statuses a:focus {
