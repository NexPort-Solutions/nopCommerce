@using Nop.Plugin.Misc.Nexport.Areas.Admin.Controllers;
@using Nop.Plugin.Misc.Nexport.Extensions;
@using Nop.Services.Helpers
@using NexportApi.Model

@inject IDateTimeHelper dateTimeHelper

@model Nop.Plugin.Misc.Nexport.Models.Customer.TrainingListModel

@{
    Layout = "_ColumnsOne";

    NopHtml.AddScriptParts(ResourceLocation.Footer, "~/Plugins/Misc.Nexport/Scripts/uikit.min.js", "", true);
    NopHtml.AddCssFileParts("~/Plugins/Misc.Nexport/Content/uikit.min.css");
    NopHtml.AddScriptParts(ResourceLocation.Footer, "https://kit.fontawesome.com/e4adf0b7ea.js", "", true);

    NopHtml.AddTitleParts("Nexport Trainings");
    NopHtml.AppendPageCssClassParts("html-account-page");
}

<link rel="stylesheet" href="~/Plugins/Misc.Nexport/Content/nexport-store.css" />

<div class="page account-page order-list-page">
    <div class="page-title">
        <h1>@T("Account.MyAccount") - @T("Plugins.Misc.Nexport.Training")</h1>
    </div>
    <div class="page-body">
        @if (Model?.RedemptionOrganizations != null && Model.RedemptionOrganizations.Count > 0)
        {
            <div class="nexport-training-list nex-plugin">
                <input id="userId" type="hidden" value="@Model.UserId" />
                @foreach (var trainingList in Model.Trainings)
                {
                    var org = Model.RedemptionOrganizations.FirstOrDefault(x => x.OrgId == trainingList.Key);
                    if (org != null)
                    {
                        var subscriptionDisabled = false;
                        var subscriptionStatusText = "Active";
                        if (org.Subscription != null)
                        {
                            if (org.Subscription.IsDisabled)
                            {
                                subscriptionDisabled = true;
                                subscriptionStatusText = "Disabled";
                            }
                            else
                            {
                                var subscriptionExpired = DateTime.UtcNow > org.Subscription.UtcExpirationDate;
                                subscriptionDisabled = subscriptionExpired;
                                if (subscriptionExpired)
                                {
                                    subscriptionStatusText = "Expired";
                                }
                            }
                        }
                        <div class="nexport-training-item uk-panel uk-margin-small-bottom">
                            <div class="uk-card uk-card-default uk-full-width">
                                <div class="uk-card-header" style="padding: 20px;">
                                    <h3 class="uk-card-title uk-margin-small-bottom uk-flex">
                                        <span><i class="far fa-school" aria-hidden="true"></i></span>
                                        <button class="uk-button uk-button-link uk-text-large" data-org-id="@org.OrgId"
                                                onclick="navigateToOrganization(this);return false;"
                                                disabled="@(subscriptionDisabled)" style="margin-left: 8px;">
                                            @org.OrgName (@org.OrgShortName)
                                        </button>
                                    </h3>
                                    <div>
                                        <strong>Status: </strong>
                                        @subscriptionStatusText
                                    </div>
                                </div>
                                <div class="uk-card-body" style="padding: 20px;">
                                    @foreach (var training in trainingList.Value)
                                    {
                                        var iconClass = "fas fa-chalkboard-teacher";
                                        if (training.Type == InvoiceRedemptionResponse.RedemptionTypeEnum.TrainingPlan)
                                        {
                                            iconClass = "fas fa-sitemap";
                                        }
                                        var enrollmentDisabled = training.UtcExpirationDate != null && DateTime.UtcNow > training.UtcExpirationDate.Value;
                                        <div class="uk-card uk-card-default uk-margin-small-bottom">
                                            <div class="uk-card-header uk-flex" style="font-size: 1rem; padding: 20px; align-items: center;">
                                                <span><i class="@iconClass"></i></span>
                                                <button class="uk-button uk-button-link" data-enrollment-id="@training.EnrollmentId"
                                                        onclick="navigateToClassroom(this);return false;" style="font-size: 1em; text-transform: initial; margin-left: 8px;"
                                                        disabled="@(enrollmentDisabled)">
                                                    @training.Name
                                                </button>
                                            </div>
                                            <div class="uk-card-body uk-padding-small">
                                                @if (training.UtcExpirationDate != null)
                                                {
                                                    <div class="uk-margin-small-bottom">
                                                        <strong>End date: </strong>@(await dateTimeHelper.ConvertToUserTimeAsync(training.UtcExpirationDate.Value)).ToString(CultureInfo.InvariantCulture) (@(await dateTimeHelper.GetCurrentTimeZoneAsync()).StandardName)
                                                    </div>
                                                }
                                                <div>
                                                    <strong>Status: </strong>
                                                    @if (training.Status is Enums.PhaseEnum.NotStarted)
                                                    {
                                                        <text>Not started</text>
                                                    } else if (training.Status is Enums.PhaseEnum.InProgress)
                                                    {
                                                        <text>In progress</text>
                                                    } else if (training.Status is Enums.PhaseEnum.Finished)
                                                    {
                                                        <text>Finished</text>
                                                    }
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                }
            </div>
        }
    </div>
</div>
<script asp-location="Footer">
    function navigateToOrganization(element) {
        var orgId = $(element).data("org-id");
        var userId = $("#userId").val();
        if (orgId && userId) {
            var url = "@Url.Action(nameof(IntegrationController.GoToOrg), ViewUtilities.GetControllerName<IntegrationController>())";
            url += "?orgId=" + orgId + "&userId=" + userId;

            navigateToNexport(url);
        }
    }

    function navigateToClassroom(element) {
        var enrollmentId = $(element).data("enrollment-id");
        if (enrollmentId) {
            var url = "@Url.Action(nameof(IntegrationController.GoToClassroom), ViewUtilities.GetControllerName<IntegrationController>())";
            url += "?enrollmentId=" + enrollmentId;

            navigateToNexport(url);
        }
    }

    function navigateToNexport(url) {
        var window = window.open("about:blank", "_blank");

        $.ajax({
            url: url,
            type: "GET",
            success: function(result) {
                if (result && result.RedirectUrl) {
                    window.location.href = result.RedirectUrl;
                }
            },
            error: function(xhr, textStatus, errorThrown) {
                var response = xhr.responseJSON;
                if (response && response.Error) {
                    window.close();
                    displayBarNotification(response.Error, "error");
                }
            }
        });
    }
</script>
