@using NexportApi.Model
@using Nop.Core.Domain.Catalog
@using Nop.Plugin.Misc.Nexport.Models.Enrollment

@model Nop.Plugin.Misc.Nexport.Models.Enrollment.NexportEnrollmentListSearchModel

@{
    var tableName = $"enrollment-listing-{Model.OrganizationId}";
}

@await Html.PartialAsync("~/Plugins/Misc.Nexport/Views/Shared/Table.cshtml", new DataTablesModel
{
    Name = tableName,
    UrlRead = new DataUrl("GetNexportUserEnrollments", "NexportIntegration", new RouteValueDictionary { [nameof(Model.OrganizationId)] = Model.OrganizationId }),
    Length = Model.PageSize,
    LengthMenu = Model.AvailablePageSizes,
    ColumnCollection = new List<ColumnProperty>
    {
        new(nameof(NexportEnrollmentResponseItemModel.Name))
        {
            Title = "Name",
            Width = "300",
            Render = new RenderCustom("renderProductName")
        },
        new(nameof(NexportEnrollmentResponseItemModel.ExpirationDate))
        {
            Title = "Expiration Date",
            Width = "200",
            Render = new RenderCustom("renderEnrollmentExpirationDate")
        },
        new(nameof(NexportEnrollmentResponseItemModel.LastActivityDate))
        {
            Title = "Last Activity",
            Width = "200",
            Render = new RenderCustom("renderEnrollmentLastActivity")
        },
        new(nameof(NexportEnrollmentResponseItemModel.Phase))
        {
            Title = "Status",
            Width = "100",
            Render = new RenderCustom("renderEnrollmentStatus")
        },
        new(nameof(NexportEnrollmentResponseItemModel.Id))
        {
            Title = "Certificate",
            Width = "200",
            Render = new RenderCustom("renderCertificateAction")
        },
        new(nameof(NexportEnrollmentResponseItemModel.Id))
        {
            Render = new RenderCustom("renderLaunchTraining"),
            ClassName = NopColumnClassDefaults.Button,
            Width = "200"
        }
    }
})

<script>
    function renderProductName(data, type, row, meta) {
        if (row.IsMarketplacePurchase){
            if (row.ProductUrl) {
                return "<a href=\"" + row.ProductUrl + "\">" + data +"</a>"
            }
        }

        if (row.IsExpiringSoon) {
            return data + "<i class=\"ms-2 fas fa-circle-info\" title=\"Enrollment is expiring soon!\"></i>";
        }

        return data;
    }

    function renderEnrollmentExpirationDate(data, type, row, meta) {
        if (data === null) {
            return "N/A";
        }

        return moment.utc(data).local().format("MM/DD/YYYY HH:mm:ss");
    }

    function renderEnrollmentLastActivity(data, type, row, meta) {
        if (data === null) {
            return "N/A";
        }

        return moment.utc(data).local().format("MM/DD/YYYY HH:mm:ss");
    }

    function renderEnrollmentStatus(data, type, row, meta) {
        var displayText = "";

        if (row.Phase === +"@((int)Enums.PhaseEnum.NotStarted)") {
            displayText = "Not started";
        } else if (row.Phase === +"@((int)Enums.PhaseEnum.InProgress)") {
            displayText = "In progress";
        } else if (row.Phase === +"@((int)Enums.PhaseEnum.Finished)") {
            displayText = "Finished";
        }

        return displayText
    }

    function renderCertificateAction(data, type, row, meta) {
        if (!row.Id)
            return "";

        if (row.Phase !== +"@((int)Enums.PhaseEnum.Finished)")
            return "";

        var buttonFunction = "viewNexportCertificate('" + row.Id + "', '" + row.OrganizationId + "', this); return false;";

        return renderCustomButton(buttonFunction, "fas fa-file-certificate", "Certificate");
    }

    function renderLaunchTraining(data, type, row, meta) {
        if (!row.Id)
            return "";

        if(row.HasExpired)
            return "";

        var buttonFunction = "launchNexportClassroom('" + data + "'); return false;";

        return renderCustomButton(buttonFunction, "fas fa-chalkboard-user", "Launch");
    }

    function viewNexportCertificate(enrollmentId, organizationId, button) {
        var certificateButton = $(button);
        if (certificateButton.data("pending")) {
            return false;
        }

        certificateButton.data("pending", true).prop("disabled", true).attr("aria-busy", "true");
        var certificateWindow = window.open("about:blank", "_blank");

        $.ajax({
            url: "@Url.Action("GetNexportEnrollmentCertificateUrl", "NexportIntegration")",
            type: "POST",
            data: {
                organizationId: organizationId,
                enrollmentId: enrollmentId,
                __RequestVerificationToken: $("input[name='__RequestVerificationToken']").first().val()
            },
            success: function(result) {
                if (result && result.Ready && result.CertificateUrl) {
                    if (certificateWindow) {
                        certificateWindow.location.href = result.CertificateUrl;
                    } else {
                        window.open(result.CertificateUrl, "_blank");
                    }
                    return;
                }

                if (certificateWindow) {
                    certificateWindow.close();
                }
                displayBarNotification(result && result.Message
                    ? result.Message
                    : "The certificate is not ready yet.", "error");
            },
            error: function(xhr) {
                if (certificateWindow) {
                    certificateWindow.close();
                }
                var response = xhr.responseJSON;
                displayBarNotification(response && response.Error
                    ? response.Error
                    : "Unable to retrieve the certificate right now. Please try again.", "error");
            },
            complete: function() {
                certificateButton.data("pending", false).prop("disabled", false).removeAttr("aria-busy");
            }
        });

        return false;
    }
</script>
