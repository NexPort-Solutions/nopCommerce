@using Nop.Plugin.Misc.Nexport.Areas.Admin.Controllers;
@using Nop.Plugin.Misc.Nexport.Domain.Enums
@using Nop.Plugin.Misc.Nexport.Domain;
@using Nop.Plugin.Misc.Nexport.Extensions;
@using Nop.Plugin.Misc.Nexport.Models.ProductMappings
@using Nop.Services.Helpers
@using Nop.Web.Areas.Admin.Models.Customers
@inject IDateTimeHelper DateTimeHelper

@model Nop.Plugin.Misc.Nexport.Models.ProductMappings.ProductMappingListSearchModel

@{
    var productMappingTableColumns = new List<ColumnProperty>
    {
        new(nameof(ProductMappingModel.Id))
        {
            Render = new RenderChildCaret(),
            Width = "5",
            Searchable = false,
            ClassName =  NopColumnClassDefaults.ChildControl
        },
        new(nameof(ProductMappingModel.Id))
        {
            Width = "50",
            IsMasterCheckBox = true,
            Render = new RenderCustom("deleteMappingCheckBox")
        },
        new(nameof(ProductMappingModel.StoreName))
        {
            Title = "Store",
            Width = "150",
            Render = new RenderCustom("renderStoreName")
        },
        new(nameof(ProductMappingModel.ProductName))
        {
            Title = "Product Info",
            Width = "550",
            Render = new RenderCustom("renderProductInfo")
        },
        new(nameof(ProductMappingModel.Id))
        {
            Title = "Subscription Information",
            Width = "250",
            Render = new RenderCustom("renderSubscriptionInformation")
        },
        new(nameof(ProductMappingModel.UtcLastModifiedDate))
        {
            Title = "Last Modified Date",
            Width = "150",
            Render = new RenderCustom("renderLocalDateForTableEntry")
        },
        new(nameof(ProductMappingModel.Id))
        {
            Width = "100",
            Render = new RenderCustom("renderViewMappingDetails"),
            ClassName = NopColumnClassDefaults.Button,
            AutoWidth = false
        },
        new(nameof(ProductMappingModel.Id))
        {
            Width = "100",
            Render = new RenderCustom("renderModifyProductMapping"),
            ClassName = NopColumnClassDefaults.Button,
            AutoWidth = false
        }
    };
    var groupMembershipChildTableColumns = new List<ColumnProperty>
    {
        new(nameof(ProductGroupMembershipMappingModel.GroupId))
        {
            Title = "Group Id",
            Width = "400",
            Render = new RenderCustom("renderGroupId")
        },
        new(nameof(ProductGroupMembershipMappingModel.GroupName))
        {
            Title = "Group Name",
            Width = "400",
            Render = new RenderCustom("renderGroupName")
        },
        new(nameof(ProductGroupMembershipMappingModel.GroupShortName))
        {
            Title = "Group Short Name",
            Width = "400",
            Render = new RenderCustom("renderGroupShortName")
        }
    };
    var childGroupTable = new Nop.Plugin.Misc.Nexport.Models.DataTablesModel
    {
        Name = "product-mapping-group-memberships-grid",
        UrlRead = new DataUrl(nameof(ProductMappingController.GetProductGroupMembershipMappings), ViewUtilities.GetControllerName<ProductMappingController>(), null),
        IsChildTable = true,
        Length = Model.PageSize,
        LengthMenu = Model.AvailablePageSizes,
        ColumnCollection = groupMembershipChildTableColumns,
        Filters = new List<FilterParameter>
        {
            new FilterParameter(nameof(ProductGroupMembershipMappingModel.ProductMappingId), "Id", true)
        }
    };
    var productMappingTable = new Nop.Plugin.Misc.Nexport.Models.DataTablesModel
    {
        Name = "product-mappings-grid",
        PrimaryKeyColumn = nameof(ProductMappingModel.Id),
        UrlRead = new DataUrl(nameof(ProductMappingController.GetProductMappings), ViewUtilities.GetControllerName<ProductMappingController>(),
            new RouteValueDictionary {
                { "nopProductId", Model.NopProductId }
            }),
        Filters = new List<FilterParameter>
        {
            new FilterParameter(nameof(Model.SearchProductName)),
            new FilterParameter(nameof(Model.SearchStoreName)),
            new FilterParameter(nameof(Model.ProductType))
        },
        SearchButtonId = "search-mappings",
        UrlDelete = new DataUrl(nameof(ProductMappingController.DeleteMapping), ViewUtilities.GetControllerName<ProductMappingController>(), null),
        UrlUpdate = new DataUrl(nameof(ProductMappingController.EditMapping), ViewUtilities.GetControllerName<ProductMappingController>(), null),
        Length = Model.PageSize,
        LengthMenu = Model.AvailablePageSizes,
        ColumnCollection = productMappingTableColumns,
        ChildTable = childGroupTable
    };
    const string hideSearchMappingsBlockAttributeName = "ProductPage.HideSearchMappingsBlock";
    var hideSearchMappingsBlock = await genericAttributeService.GetAttributeAsync<bool>(await workContext.GetCurrentCustomerAsync(), hideSearchMappingsBlockAttributeName);
}
<div class="row">
    <div class="col-md-12" style="text-align: right; margin-bottom: 1rem;">
        <button class="btn btn-primary" id="duplicateProductMappingBtn">
            <i class="fa fa-clone"></i>
            Duplicate mapping
        </button>
        <button type="button" id="delete-selected-mappings" class="btn bg-red">
            <i class="fa fa-trash-o"></i>
            @T("Admin.Common.Delete.Selected")
        </button>
        <nop-action-confirmation asp-button-id="delete-selected-mappings"/>
        <nop-alert asp-alert-id="deleteSelectedMappingsFailed"/>
    </div>
    <div class="col-md-12">
        <div class="card card-default card-search">
            <div class="card-body">
                <div class="row search-row @(!hideSearchMappingsBlock ? "opened" : "")" data-hideAttribute="@hideSearchMappingsBlockAttributeName">
                    <div class="search-text">@T("Admin.Common.Search")</div>
                    <div class="icon-search"><i class="fas fa-search" aria-hidden="true"></i></div>
                    <div class="icon-collapse"><i class="far fa-angle-@(!hideSearchMappingsBlock ? "up" : "down")" aria-hidden="true"></i></div>
                </div>
                <div class="search-body @(hideSearchMappingsBlock ? "closed" : "")">
                    <div class="row">
                        <div class="col-md-5">
                            <div class="form-group row">
                                <div class="col-md-4">
                                    <nop-label asp-for="SearchStoreName" />
                                </div>
                                <div class="col-md-8">
                                    <nop-editor asp-for="SearchStoreName" />
                                </div>
                            </div>
                            <div class="form-group row">
                                <div class="col-md-4">
                                    <nop-label asp-for="ProductType" />
                                </div>
                                <div class="col-md-8">
                                    <nop-select asp-for="ProductType" asp-items="Model.AvailableProductTypes" />
                                </div>
                            </div>
                        </div>
                        <div class="col-md-7">
                            <div class="form-group row">
                                <div class="col-md-4">
                                    <nop-label asp-for="SearchProductName" />
                                </div>
                                <div class="col-md-8">
                                    <nop-editor asp-for="SearchProductName" />
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="text-center col-12">
                            <button type="button" id="search-mappings" class="btn btn-primary btn-search"><i class="fas fa-search"></i>@T("Admin.Common.Search")</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-12">
        @await Html.PartialAsync("~/Plugins/Misc.Nexport/Views/Shared/Table.cshtml", productMappingTable)
    </div>
</div>

<span style="color: red;">* Default mapping cannot be removed once it has been mapped. However, it can be modified to a different product.</span>

<input type="submit" id="btnRefreshMappings" style="display: none">

<script>
    var hasDefaultMapping = false;

    function renderStoreName(data, type, row, meta) {
        if (data === null) {
            return "Default";
        }
        return data;
    }

    function deleteMappingCheckBox(data, type, row, meta) {
        if (meta.row === 0)
            return "";

        return (data === true)
            ? '<input name="checkbox_delete_product_mappings" value="' + row.Id + '" type="checkbox" class="checkboxGroups" checked="checked" />'
            : '<input name="checkbox_delete_product_mappings" value="' + row.Id + '" type="checkbox" class="checkboxGroups" />';
    }

    function renderProductInfo(data, type, row, meta) {
        if (data !== null) {
            var displayText = "<b>Name: </b>" + data + "<br>";
            if (row.CatalogId !== "00000000-0000-0000-0000-000000000000") {
                displayText += "<br><b>Type: </b>";
                if (row.Type === +"@((int)ProductType.Catalog)") {
                    displayText += "Catalog";
                } else if (row.Type === +"@((int)ProductType.Section)") {
                    displayText += "Section";
                } else if (row.Type === +"@((int)ProductType.TrainingPlan)") {
                    displayText += "Training Plain";
                }
                displayText += "<br>" + "<b>Nexport Catalog: </b>" + row.CatalogName + " (" + row.CatalogId + ")";
                if (row.SyllabusId || row.Syllabus !== "00000000-0000-0000-0000-000000000000") {
                    displayText += "<br>" + "<b>Nexport Syllabus: </b>" + row.UniqueName + " (" + row.SyllabusId + ")";
                }
                displayText += "<br>" + "<b>NexPort Product Id: </b>" + row.CatalogSyllabusLinkId;
                if (row.UtcLastSynchronizationDate) {
                    displayText += "<br>" + "<b>Last Synchronized Date: </b>" + renderLocalDateForTableEntry(row.UtcLastSynchronizationDate, null, null, null);
                }
            }
            return displayText;
        }
        return data;
    }

    function renderSubscriptionInformation(data, type, row, meta) {
        if (data > 0) {
            var displayText = "";

            var subOrgName = row.SubscriptionOrgName;
            var subOrgDisplayText = subOrgName;

            if (subOrgName) {
                subOrgDisplayText += " - " + row.SubscriptionOrgShortName;
                displayText += "<b>Subscription Organization: </b>" + subOrgDisplayText;
            }

            var groupMembershipNames = "";
            var groupMemberships = row.GroupMembershipMappingModels;
            if (groupMemberships) {
                if (groupMemberships.length > 0) {
                    groupMembershipNames += "<br>" + "<b>Group Memberships: </b>";
                    for (var i = 0; i < groupMemberships.length; i++) {
                        groupMembershipNames += groupMemberships[i].GroupName + " (" +
                            groupMemberships[i].GroupShortName + ")";
                        if (i < groupMemberships.length - 1) {
                            groupMembershipNames += ", ";
                        }
                    }

                    displayText += groupMembershipNames;
                }
            }

            return displayText;
        }

        return "";
    }

    function renderViewMappingDetails(data, type, row, meta) {
        var url;

        var renderCreateMapping = row.CatalogId === "00000000-0000-0000-0000-000000000000";
        var buttonName;

        if (renderCreateMapping) {
            buttonName = "Create/edit mapping";
        } else {
            buttonName = "View/edit mapping details";
        }

        if (renderCreateMapping) {
            url = "@Url.Action(nameof(ProductMappingController.MapProductPopup), ViewUtilities.GetControllerName<ProductMappingController>())";
            url += "?nopProductId=@Model.NopProductId";
            var storeId = row.StoreId;
            if (storeId) {
                url += "&storeId=" + storeId;
            }
            url += "&containerId=product-mapping-container";
        } else {
            url = "@Url.Action(nameof(ProductMappingController.ProductMappingDetailsPopup), ViewUtilities.GetControllerName<ProductMappingController>())" + "?mappingId=" + row.Id + "&containerId=";

            var renderInProductPage = @Json.Serialize(Model.NopProductId.HasValue);

            if (renderInProductPage) {
                url += "product-mapping-container";
            } else {
                if (row.Type === 0) {
                    url += "nexport-catalog-panels";
                } else if (row.Type === 1) {
                    url += "nexport-section-panels";
                } else {
                    url += "nexport-training-plan-panels";
                }
            }
        }

        url += "&btnId=btnRefreshMappings";

        var buttonFunction = "javascript:OpenWindow('" + url + "', 800, 800, true); return false;";

        if (renderCreateMapping && row.StoreId && !hasDefaultMapping) {
            return renderCustomButton(buttonFunction, "fas fa-info", buttonName, true);
        }

        return renderCustomButton(buttonFunction, "fas fa-info", buttonName);;
    }

    function renderModifyProductMapping(data, type, row, meta) {
        var url = "@Url.Action(nameof(ProductMappingController.MapProductPopup), ViewUtilities.GetControllerName<ProductMappingController>())";
        url += "?nopProductId=@Model.NopProductId";
        var storeId = row.StoreId;
        if (storeId) {
            url += "&storeId=" + storeId;
        }
        url += "&updateProduct=true&containerId=product-mapping-container&btnId=btnRefreshMappings";

        var buttonFunction = "javascript:OpenWindow('" + url + "', 800, 800, true); return false;";

        if (+data < 1) {
            return renderCustomButton(buttonFunction, "fa fa-pencil", "Modify product mapping", true);
        }

        return renderCustomButton(buttonFunction, "fa fa-pencil", "Modify product mapping");
    }

    function renderCustomButton(buttonFunction, buttonIconClass, buttonName, renderDisabled) {
        if (!buttonIconClass) {
            throw "Button icon class is missing!";
        }

        if (!buttonName) {
            throw "Cannot render button without a name!";
        }

        var buttonElement = "<button class=\"btn btn-default\" onclick=\"" + buttonFunction + "\"";

        if (renderDisabled) {
            buttonElement += " disabled";
        }

        buttonElement += "><i class=\"" + buttonIconClass + "\"></i>" + buttonName + "</button>";

        return buttonElement;
    }
    
    function renderLocalDateForTableEntry(data, type, row, meta) {
        return data ? moment.utc(data).local().format("MM/DD/YYYY HH:mm:ss") : null;
    }
    

    function renderGroupId(data, type, row, meta) {
        return data;
    }

    function renderGroupName(data, type, row, meta) {
        return data;
    }

    function renderGroupShortName(data, type, row, meta) {
        return data;
    }

    checkDefaultMappingExisted();

    $(document).ready(function () {

        $("#product-mapping-container").on("xhr.dt", "#product-mappings-grid",
            function (e, settings, json, xhr) {
                if (json.data) {
                    checkDefaultMappingExisted();
                }
            });

        $("#delete-selected-mappings-action-confirmation-submit-button").bind("click", function (e) {
            var submitIds = selectedIds;
            submitIds = $.grep(submitIds, function (value) {
                return value !== "0";
            });

            var noDeletion = false;
            if (submitIds.length < 1) {
                noDeletion = true;
            }

            var postData = {
                selectedIds: submitIds
            };
            addAntiForgeryToken(postData);

            $.ajax({
                cache: false,
                type: "POST",
                url: "@Url.Action(nameof(ProductMappingController.DeleteMappings), ViewUtilities.GetControllerName<ProductMappingController>())",
                data: postData,
                error: function (jqXHR, textStatus, errorThrown) {
                    $("#deleteSelectedMappingsFailed-info").text(errorThrown);
                    $("#deleteSelectedMappingsFailed").click();
                },
                complete: function (jqXHR, textStatus) {
                    updateTable("#product-mappings-grid");
                }
            });

            $("#delete-selected-mappings-action-confirmation").modal("toggle");

            if (noDeletion)
                alert("No mapping selected");

            return false;
        });

        $("#btnRefreshMappings").click(function () {
            
            checkDefaultMappingExisted()

            // Refresh grid
            $("#product-mappings-grid").DataTable().draw(false);

            // Return false to don't reload a page
            return false;
        });

        $("#duplicateProductMappingBtn").click(function () {
            duplicateProductMapping();

            return false;
        });
        $("div.mapping-search-div").keypress(function (n) {
            if (n.which == 13 || n.keyCode == 13)
                $("#search-mappings").click();
        });
    });
    function checkDefaultMappingExisted() {
        var checkDefaultMappingData = {
            productId: @Model.NopProductId
            };
        addAntiForgeryToken(checkDefaultMappingData);

        $.ajax({
            url: "@Url.Action(nameof(ProductMappingController.HasDefaultMapping), ViewUtilities.GetControllerName<ProductMappingController>())",
            type: "POST",
            dataType: "json",
            data: checkDefaultMappingData,
            success: function (data, textStatus, jqXHR) {
                // Display error if returned
                if (data) {
                    hasDefaultMapping = data;
                }

                if (hasDefaultMapping) {
                    $("#duplicateProductMappingBtn").prop("disabled", false);
                } else {
                    $("#duplicateProductMappingBtn").prop("disabled", true);
                }
            },
            error: function (jqXHR, textStatus, errorThrown) {
                hasDefaultMapping = false;
            }
        });
    }

    function duplicateProductMapping() {
        var url = "@Url.Action(nameof(ProductMappingController.DuplicateProductMapping), ViewUtilities.GetControllerName<ProductMappingController>())";
        url += "?productId=@Model.NopProductId";
        url += "&containerId=product-mapping-container&btnId=btnRefreshMappings";

        OpenWindow(url, 800, 800, true);
    }

        //# sourceURL=ProductMappingTable.js
</script>
