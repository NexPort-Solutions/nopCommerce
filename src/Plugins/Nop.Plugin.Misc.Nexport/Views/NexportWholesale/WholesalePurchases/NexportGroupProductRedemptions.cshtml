@using Nop.Plugin.Misc.Nexport.Domain.Enums
@using Nop.Plugin.Misc.Nexport.Extensions
@using Nop.Plugin.Misc.Nexport.Models.NexportWholesale.WholesalePurchases
@model Nop.Plugin.Misc.Nexport.Models.NexportWholesale.WholesalePurchases.NexportGroupProductRedemptionListSearchModel

@{
    const string hideSearchBlockAttributeName = "NexportGroupsPage.HideSearchBlock";
    var hideSearchBlock = await genericAttributeService.GetAttributeAsync<bool>(await workContext.GetCurrentCustomerAsync(), hideSearchBlockAttributeName);

    var currentGroupId = @Model.CurrentGroup.Id?.ToString() ?? "null";

    var groupsRouteUrl = Model.AdminView ? Url.RouteUrl("Plugin.Misc.Nexport.Admin.Groups") : Url.RouteUrl("Plugin.Misc.Nexport.Customer.Groups");
    var groupProductsRouteUrl = Model.AdminView ? Url.RouteUrl("Plugin.Misc.Nexport.Admin.Group.Products") : Url.RouteUrl("Plugin.Misc.Nexport.Customer.Group.Products");
    var groupProductRedemptionsRouteUrl = Model.AdminView ? Url.RouteUrl("Plugin.Misc.Nexport.Admin.Group.Product.Redemptions") : Url.RouteUrl("Plugin.Misc.Nexport.Customer.Group.Product.Redemptions");

    var groupProductRedemptionText = Model.CurrentProduct.Name + " - " + T("Plugins.Misc.Nexport.Group.Product.Redemptions");
}

<div class="content-header clearfix nex-plugin">
    <nav aria-label="Breadcrumb">
        <ul class="uk-breadcrumb">
            <li>
                <a href="@groupsRouteUrl" title="@T("Plugins.Misc.Nexport.Groups")">
                    <span>@T("Plugins.Misc.Nexport.Groups")</span>
                </a>
            </li>
            <li>
                <a href="@(groupProductsRouteUrl+"?groupId="+currentGroupId)" title="@T("Plugins.Misc.Nexport.Group.Products")">
                    <span>@Model.CurrentGroup.Name</span>
                </a>
            </li>
            <li>
                @groupProductRedemptionText
                <span id="@(groupProductRedemptionsRouteUrl+"?groupId="+currentGroupId+"&productId="+Model.CurrentProduct.Id)">
                </span>
            </li>
        </ul>
    </nav>
    <h1>@groupProductRedemptionText</h1>
</div>

<section class="content">
    <div class="container-fluid">
        <div class="form-horizontal">
            <div class="cards-group">

                <div class="card card-default card-search">
                    <div class="card-body">
                        <div class="row search-row @(!hideSearchBlock ? "opened" : "")" data-hideAttribute="@hideSearchBlockAttributeName">
                            <div class="search-text">@T("Admin.Common.Search")</div>
                            <div class="icon-search"><i class="fas fa-search" aria-hidden="true"></i></div>
                            <div class="icon-collapse"><i class="far fa-angle-@(!hideSearchBlock ? "up" : "down")" aria-hidden="true"></i></div>
                        </div>

                        <div class="search-body @(hideSearchBlock ? "closed" : "")">
                            <div class="row">
                                <div class="col-md-5">
                                    <div class="form-group row">
                                        <div class="col-md-4">
                                            <nop-label asp-for="SearchName" />
                                        </div>
                                        <div class="col-md-8">
                                            <nop-editor asp-for="SearchName" />
                                        </div>
                                    </div>
                                    <div class="form-group row">
                                        <div class="col-md-4">
                                            <nop-label asp-for="SearchEmail" />
                                        </div>
                                        <div class="col-md-8">
                                            <nop-editor asp-for="SearchEmail" />
                                        </div>
                                    </div>
                                    <div class="form-group row">
                                        <div class="col-md-4">
                                            <nop-label asp-for="SearchStatusId" />
                                        </div>
                                        <div class="col-md-8">
                                            <nop-select asp-for="SearchStatusId" asp-items="Model.AvailableStatuses" />
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-7">
                                    <div class="form-group row">
                                        <div class="col-md-4">
                                            <nop-label asp-for="DateAssignedFrom" />
                                        </div>
                                        <div class="col-md-8">
                                            <nop-editor asp-for="DateAssignedFrom" />
                                        </div>
                                    </div>
                                    <div class="form-group row">
                                        <div class="col-md-4">
                                            <nop-label asp-for="DateAssignedTo" />
                                        </div>
                                        <div class="col-md-8">
                                            <nop-editor asp-for="DateAssignedTo" />
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="form-group row">
                                <div class="text-center col-12">
                                    <button type="button" id="search-group-product-redemptions" class="btn btn-primary btn-search"><i class="fas fa-search"></i>@T("Admin.Common.Search")</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card card-default">
                    <div class="card-body">
                        <div style="font-weight: 600; margin-bottom: 5px; text-align: right">
                            Assignments Available:
                            <span style="margin-left: 7px; margin-right: 12px;" id="redemptionsAvailable">
                            </span>
                        </div>
                        @await Html.PartialAsync("~/Plugins/Misc.Nexport/Views/Shared/Table.cshtml", new DataTablesModel
                        {
                            Name = "group-product-redemptions-grid",
                            UrlRead = new DataUrl("GetNexportGroupProductRedemptions", "NexportWholesale",
                                new RouteValueDictionary {
                                    { "GroupId", Model.CurrentGroup.Id }
                                    ,{ "ProductId", Model.CurrentProduct.Id }
                                    ,{"OrderId", Model.OrderId}
                                }),
                            SearchButtonId = "search-group-product-redemptions",
                            Length = Model.PageSize,
                            LengthMenu = Model.AvailablePageSizes,
                            Filters = new List<FilterParameter>
                            {
                                new FilterParameter(nameof(Model.SearchName)),
                                new FilterParameter(nameof(Model.SearchEmail)),
                                new FilterParameter(nameof(Model.SearchStatusId)),
                                new FilterParameter(nameof(Model.DateAssignedFrom)),
                                new FilterParameter(nameof(Model.DateAssignedTo))
                            },
                            ColumnCollection = new List<ColumnProperty>
                            {
                                new ColumnProperty(nameof(NexportGroupProductRedemptionModel.Name))
                                {
                                Title = @T("Plugins.Misc.Nexport.Group.Product.Redemption.Name").Text
                                },
                                new ColumnProperty(nameof(NexportGroupProductRedemptionModel.Email))
                                {
                                    Title = @T("Plugins.Misc.Nexport.Group.Product.Redemption.Email").Text
                                },
                                new ColumnProperty(nameof(NexportGroupProductRedemptionModel.ProductName))
                                {
                                    Title = @T("Plugins.Misc.Nexport.Group.Product.Redemption.ProductName").Text
                                },
                                new ColumnProperty(nameof(NexportGroupProductRedemptionModel.Status))
                                {
                                Title = @T("Plugins.Misc.Nexport.Group.Product.Redemption.Status").Text
                                },
                                new ColumnProperty(nameof(NexportGroupProductRedemptionModel.DateRedeemed))
                                {
                                    Title = @T("Plugins.Misc.Nexport.Group.Product.Redemption.DateAssigned").Text,
                                    Render = new RenderDate()
                                },
                                new(nameof(NexportGroupModel.Id))
                                {
                                    Width = "100",
                                    Render = new RenderCustom("renderModifyGroupProductRedemptions"),
                                    ClassName = NopColumnClassDefaults.Button,
                                    AutoWidth = false
                                }
                            }
                        })
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<script>
    function renderModifyGroupProductRedemptions(data, type, row, meta) {
        
        if (row.InvoiceItemId != null) {
            if (row.Status == "@(NexportOrderInvoiceItemRedemptionStatus.Assigned.GetDisplayName())") 
            {
                return "<center><button class=\"btn btn-default\" onclick=\"unassignRedemption('" + row.InvoiceItemId + "')\" >@T("Plugins.Misc.Nexport.Group.Product.Redemption.Button.Unassign")</button></center>";
            }
            else if (row.Status == "@(NexportOrderInvoiceItemRedemptionStatus.Available.GetDisplayName())") 
            {
                return "<center><button class=\"btn btn-default\" onclick=\"assignRedemption('" + row.InvoiceItemId + "')\" >@T("Plugins.Misc.Nexport.Group.Product.Redemption.Button.Assign")</button></center>";
            }
            else if (row.Status == "@(NexportOrderInvoiceItemRedemptionStatus.Awaiting.GetDisplayName())") 
            {
                return "<center><button class=\"btn btn-default\" onclick=\"cancelAwaitingRedemption('" + row.InvoiceItemId + "')\" >@T("Plugins.Misc.Nexport.Group.Product.Redemption.Button.CancelAwaiting")</button></center>";
            }
        }
        return '';

    }
    
    function assignRedemption(invoiceItemId) {
        window.location.href = "@Url.Action("RedeemProduct", "NexportWholesale")"+"?GroupId="+"@currentGroupId"+"&InvoiceItemId="+invoiceItemId+"&ProductId="+"@Model.CurrentProduct.Id";
    }
    function unassignRedemption(invoiceItemId) {
        if (confirm('@T("Plugins.Misc.Nexport.Group.Product.Redemptions.Unassign.Confirmation")')) {
            var postData = {
                invoiceItemId: invoiceItemId
            };
            addAntiForgeryToken(postData);

            $.ajax({
                cache: false,
                type: "POST",
                url: "@Url.Action("invoiceItemUnassign", "NexportWholesale")",
                data: postData,
                dataType: "json",
                success: function (data, textStatus, jqXHR) {
                    if (data.result == "@(NexportOrderInvoiceItemRedemptionStatus.ProcessingAvailable.GetDisplayName())") {
                        location.reload();
                    }
                },
                error: function (jqXHR, textStatus, errorThrown) {
                    alert('@T("Plugins.Misc.Nexport.Group.Product.Redemption.Unassign.Failed")');
                }
            });
        }
    }
    function cancelAwaitingRedemption(invoiceItemId) {
        if (confirm('@T("Plugins.Misc.Nexport.Group.Product.Redemption.CancelAwaiting.Confirm")')) {
            var postData = {
                invoiceItemId: invoiceItemId
            };
            addAntiForgeryToken(postData);

            $.ajax({
                cache: false,
                type: "POST",
                url: "@Url.Action("invoiceItemCancelAwaiting", "NexportWholesale")",
                data: postData,
                dataType: "json",
                success: function (data, textStatus, jqXHR) {
                    if (data.result == "@(NexportOrderInvoiceItemRedemptionStatus.Available)") {
                        location.reload();
                    }
                },
                error: function (jqXHR, textStatus, errorThrown) {
                    alert('@T("Plugins.Misc.Nexport.Group.Product.Redemption.CancelAwaiting.Failed")');
                }
            });
        }
    }
    function updateAvailableRedemptions() {
        var redemptionData = { groupId: "@Model.CurrentGroup.Id", productId: "@Model.CurrentProduct.Id", orderId: "@Model.OrderId" };
        addAntiForgeryToken(redemptionData);

        $.ajax({

            url: "@Url.Action("GetAvailableNexportGroupProductRedemptionsCount", "NexportWholesale")",
            type: "POST",
            data: redemptionData,
            success: function (data) {
                if (data.result != null) {
                    $("#redemptionsAvailable").html(data.result);
                }
            },
            error: function (error) {
                console.log(`Error ${error}`);
            }
        });
    }
    $(document).ready(function () {
        updateAvailableRedemptions();
        $(".data-tables-refresh :button").click(function () {
            updateAvailableRedemptions();
        });
    });
    
</script>
