@using Nop.Plugin.Misc.Nexport.Domain.Enums
@using Nop.Plugin.Misc.Nexport.Extensions
@using Nop.Plugin.Misc.Nexport.Models.NexportWholesale.WholesalePurchases
@using Nop.Plugin.Misc.Nexport.Services
@using Nop.Services.Customers

@model Nop.Plugin.Misc.Nexport.Models.NexportWholesale.WholesalePurchases.NexportGroupProductRedemptionListSearchModel

@inject NexportService NexportService
@inject ICustomerService CustomerService

@{
    var currentCustomer = await workContext.GetCurrentCustomerAsync();
    var hasAdminRole = await CustomerService.IsAdminAsync(currentCustomer);
    const string hideSearchBlockAttributeName = "NexportGroupsPage.HideSearchBlock";
    var hideSearchBlock = await genericAttributeService.GetAttributeAsync<bool>(currentCustomer, hideSearchBlockAttributeName);

    var currentGroupId = Model.CurrentGroup.OrganizationId;

    var groupProductsRouteUrl = Model.AdminView ? Url.RouteUrl("Plugin.Misc.Nexport.Admin.Group.Products") : Url.RouteUrl("Plugin.Misc.Nexport.Customer.Group.Products");
    // var groupProductRedemptionsRouteUrl = Model.AdminView ? Url.RouteUrl("Plugin.Misc.Nexport.Admin.Group.Product.Redemptions") : Url.RouteUrl("Plugin.Misc.Nexport.Customer.Group.Product.Redemptions");

    var groupText = Model.CurrentGroup.OrganizationId != null ? Model.CurrentGroup.Name + " - " : "";
    //var groupProductRedemptionText = T("Plugins.Misc.Nexport.Group.Product.Redemptions") + " - " + groupText + Model.CurrentProduct.Name;

    var hasGroupPermission = Model.CurrentGroup.OrganizationId != null && await NexportService.HasGroupPermissionAsync(currentCustomer, Model.CurrentGroup.OrganizationId.Value);

    var redemptionsColumns = new List<ColumnProperty>
    {
        new(nameof(NexportGroupProductRedemptionModel.Name))
        {
            Title = T("Plugins.Misc.Nexport.Group.Product.Redemption.Customer").Text,
            Render = new RenderCustom("renderCustomerDetails"),
            Width = "300"
        },
        new(nameof(NexportGroupProductRedemptionModel.ProductName))
        {
            Title = T("Plugins.Misc.Nexport.Group.Product.Redemption.Product.Name").Text,
            Width = "400"
        },
        new(nameof(NexportGroupProductRedemptionModel.AssignedProductName))
        {
            Title = T("Plugins.Misc.Nexport.Group.Product.Redemption.AssignedProduct.Name").Text,
            Width = "400"
        },
        new(nameof(NexportGroupProductRedemptionModel.Status))
        {
            Title = T("Plugins.Misc.Nexport.Group.Product.Redemption.Status").Text,
            Width = "100"
        }
    };

    if (hasGroupPermission || Model.AdminView)
    {
        redemptionsColumns.Add(new ColumnProperty(nameof(NexportGroupProductRedemptionModel.PurchasedInStore))
        {
            Title = T("Plugins.Misc.Nexport.Group.Product.Redemption.PurchasedInStore").Text,
            Width = "100"
        });

        redemptionsColumns.Add(new ColumnProperty(nameof(NexportGroupProductRedemptionModel.PurchasedByCustomerEmail))
        {
            Title = T("Plugins.Misc.Nexport.Group.Product.Redemption.PurchasedBy").Text,
            Width = "300",
            Render = new RenderCustom("renderPurchasedByCustomerDetails"),
        });
    }

    redemptionsColumns.Add(new ColumnProperty(nameof(NexportGroupProductRedemptionModel.DatePurchased))
    {
        Title = T("Plugins.Misc.Nexport.Group.Product.Redemption.DatePurchased").Text,
        Render = new RenderDate(),
        Width = "100"
    });

    redemptionsColumns.Add(new ColumnProperty(nameof(NexportGroupProductRedemptionModel.DateRedeemed))
    {
        Title = T("Plugins.Misc.Nexport.Group.Product.Redemption.DateAssigned").Text,
        Render = new RenderDate() { Format = "MM/DD/YYYY h:mm:ss a" },
        Width = "100",
        AutoWidth = false
    });

    redemptionsColumns.Add(new ColumnProperty(nameof(NexportGroupProductRedemptionModel.Id))
    {
        Render = new RenderCustom("renderModifyGroupProductRedemptions"),
        ClassName = NopColumnClassDefaults.Button,
        Width = "150",
        AutoWidth = false
    });

    redemptionsColumns.Add(new ColumnProperty(nameof(NexportGroupProductRedemptionModel.Id))
    {
        Render = new RenderCustom("renderRefundRedemption"),
        ClassName = NopColumnClassDefaults.Button,
        Width = "150",
        AutoWidth = false
    });

    if (hasAdminRole && Model.AdminView)
    {
        redemptionsColumns.Add(new ColumnProperty(nameof(NexportGroupProductRedemptionModel.InvoiceItemId))
        {
            Render = new RenderCustom("renderViewRedemptionAuditLog"),
            ClassName = NopColumnClassDefaults.Button,
            Width = "75",
            AutoWidth = false
        });
    }

    var redemptionsTable = new DataTablesModel
    {
        Name = "group-product-redemptions-grid",
        UrlRead = new DataUrl("GetNexportGroupProductRedemptions", "NexportWholesale",
            new RouteValueDictionary
            {
                { "GroupId", Model.CurrentGroup.OrganizationId },
                { "ProductId", Model.CurrentProduct.Id },
                { "OrderId", Model.OrderId }
            }),
        SearchButtonId = "search-group-product-redemptions",
        Length = Model.PageSize,
        LengthMenu = Model.AvailablePageSizes,
        Filters = new List<FilterParameter>
        {
            new(nameof(Model.SearchName)),
            new(nameof(Model.SearchEmail)),
            new(nameof(Model.SearchStatusId)),
            new(nameof(Model.DateAssignedFrom)),
            new(nameof(Model.DateAssignedTo)),
            new(nameof(Model.AdminView))
        },
        ColumnCollection = redemptionsColumns
    };
}
<div class="content-header clearfix nex-plugin">
    <h1 class="float-left">
        @{
            var headerText = T("Plugins.Misc.Nexport.Group.Product.Redemptions") + " - " + groupText;
            if (hasAdminRole && Model.AdminView)
            {
                var productLink = Url.Action("Edit", "Product", new { id = Model.CurrentProduct.Id });
                @:@(headerText) <a href="@productLink">@Model.CurrentProduct.Name</a>
            }
            else
            {
                @(headerText + Model.CurrentProduct.Name)
            }
        }
        <small>
            <i class="fas fa-arrow-circle-left"></i>
            <a href="@(groupProductsRouteUrl)">Back to purchases list</a>
        </small>
    </h1>
</div>

<section class="content">
    <div class="container-fluid">
        <div class="form-horizontal">
            <div class="cards-group">
                <div class="card card-default card-search">
                    <div class="card-body">
                        <div class="row search-row @(!hideSearchBlock ? "opened" : "")" data-hideAttribute="@hideSearchBlockAttributeName">
                            <div class="search-text">@T("Admin.Common.Search")</div>
                            <div class="icon-search"><i class="fas fa-search" aria-hidden="true"></i></div>
                            <div class="icon-collapse"><i class="far fa-angle-@(!hideSearchBlock ? "up" : "down")" aria-hidden="true"></i></div>
                        </div>

                        <div class="search-body @(hideSearchBlock ? "closed" : "")">
                            <div class="row">
                                <div class="col-md-5">
                                    <div class="form-group row">
                                        <div class="col-md-4">
                                            <nop-label asp-for="SearchName" />
                                        </div>
                                        <div class="col-md-8">
                                            <nop-editor asp-for="SearchName" />
                                        </div>
                                    </div>
                                    <div class="form-group row">
                                        <div class="col-md-4">
                                            <nop-label asp-for="SearchEmail" />
                                        </div>
                                        <div class="col-md-8">
                                            <nop-editor asp-for="SearchEmail" />
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-7">
                                    <div class="form-group row">
                                        <div class="col-md-4">
                                            <nop-label asp-for="SearchStatusId" />
                                        </div>
                                        <div class="col-md-8">
                                            <nop-select asp-for="SearchStatusId" asp-items="Model.AvailableStatuses" />
                                        </div>
                                    </div>
                                    <div class="form-group row">
                                        <div class="col-md-4">
                                            <nop-label asp-for="DateAssignedFrom" />
                                        </div>
                                        <div class="col-md-8">
                                            <nop-editor asp-for="DateAssignedFrom" asp-render-form-control-class="true" />
                                        </div>
                                    </div>
                                    <div class="form-group row">
                                        <div class="col-md-4">
                                            <nop-label asp-for="DateAssignedTo" />
                                        </div>
                                        <div class="col-md-8">
                                            <nop-editor asp-for="DateAssignedTo" asp-render-form-control-class="true" />
                                            <input type="hidden" asp-for="@Model.AdminView" />
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="form-group row">
                                <div class="text-center col-12">
                                    <button type="button" id="search-group-product-redemptions" class="btn btn-primary btn-search"><i class="fas fa-search"></i>@T("Admin.Common.Search")</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card card-default">
                    <div class="card-body">
                        <div style="font-weight: 600; margin-bottom: 5px; text-align: right">
                            Assignments Available:
                            <span style="margin-left: 7px; margin-right: 12px;" id="redemptionsAvailable">
                            </span>
                        </div>
                        @await Html.PartialAsync("~/Plugins/Misc.Nexport/Views/Shared/Table.cshtml", redemptionsTable)
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@await Html.PartialAsync("~/Plugins/Misc.Nexport/Views/Shared/_ProductRedemptionsCustomRenders.cshtml", new ViewDataDictionary(ViewData) { { "HasAdminRole", hasAdminRole } })

<script>
    function requestUnassignment(invoiceItemId, customerId) {
        var url = "@Url.Action("RequestUnassignment", "NexportWholesale")";
        var groupId = "@currentGroupId";
        if (groupId) {
            url += "?GroupId=" + groupId + "&InvoiceItemId=" + invoiceItemId + "&ProductId=" + "@Model.CurrentProduct.Id" + "&CustomerId=" + customerId;
        } else {
            url += "?InvoiceItemId=" + invoiceItemId + "&ProductId=" + "@Model.CurrentProduct.Id" + "&CustomerId=" + customerId;
        }

        window.location.href = url;
    }

    function assignRedemption(invoiceItemId) {
        var url = "@Url.Action("RedeemProduct", "NexportWholesale")";
        var groupId = "@currentGroupId";
        if (groupId) {
            url += "?GroupId=" + groupId + "&InvoiceItemId=" + invoiceItemId + "&ProductId=" + "@Model.CurrentProduct.Id";
        } else {
            url += "?InvoiceItemId=" + invoiceItemId + "&ProductId=" + "@Model.CurrentProduct.Id";
        }

        window.location.href = url;
    }

    function updateAvailableRedemptions() {
        var redemptionData = {
            groupId: "@Model.CurrentGroup.OrganizationId",
            productId: "@Model.CurrentProduct.Id",
            orderId: "@Model.OrderId"
        };

        addAntiForgeryToken(redemptionData);

        $.ajax({
            url: "@Url.Action("GetAvailableNexportGroupProductRedemptionsCount", "NexportWholesale")",
            type: "POST",
            data: redemptionData,
            success: function (data) {
                if (data.result != null) {
                    $("#redemptionsAvailable").html(data.result);
                }
            },
            error: function (error) {
                console.log(error);
            }
        });
    }

    $(document).ready(function () {
        updateAvailableRedemptions();

        $(document).on("click", ".data-tables-refresh :button", function(e) {
            updateAvailableRedemptions();
        });
    });
</script>