@using Nop.Plugin.Misc.Nexport.Models.NexportWholesale.WholesalePurchases
@model Nop.Plugin.Misc.Nexport.Models.NexportWholesale.WholesalePurchases.NexportGroupProductListSearchModel

@{
    const string hideSearchBlockAttributeName = "NexportGroupsPage.HideSearchBlock";
    var hideSearchBlock = await genericAttributeService.GetAttributeAsync<bool>(await workContext.GetCurrentCustomerAsync(), hideSearchBlockAttributeName);

    //var groupProductRedemptionsRouteUrl = Model.AdminView ? Url.RouteUrl("Plugin.Misc.Nexport.Admin.Group.Product.Redemptions") : Url.RouteUrl("Plugin.Misc.Nexport.Customer.Group.Product.Redemptions");

    var columnCollection = new List<ColumnProperty>();
    if (Model.HasPurchasingAgentPermissions || Model.AdminView)
    {
        columnCollection.AddRange(new List<ColumnProperty>
        {
            new(nameof(NexportGroupProductModel.GroupName))
            {
                Title = T("Plugins.Misc.Nexport.Group.Name").Text
            },
            new(nameof(NexportGroupProductModel.GroupShortName))
            {
                Title = T("Plugins.Misc.Nexport.Group.ShortName").Text
            }
        });
    }
    columnCollection.AddRange(new List<ColumnProperty>
    {
        new(nameof(NexportGroupProductModel.ProductName))
        {
            Title = T("Admin.Catalog.Products.Fields.Name").Text
        },
        new(nameof(NexportGroupProductModel.Available))
        {
            Title = T("Plugins.Misc.Nexport.Group.Product.Available").Text
        },
        new(nameof(NexportGroupProductModel.Awaiting))
        {
            Title = T("Plugins.Misc.Nexport.Group.Product.Awaiting").Text
        },
        new(nameof(NexportGroupProductModel.Redeemed))
        {
            Title = T("Plugins.Misc.Nexport.Group.Product.Assigned").Text
        },
        new(nameof(NexportGroupModel.OrganizationId))
        {
            Width = "100",
            Render = new RenderCustom("renderViewGroupProductRedemptions"),
            ClassName = NopColumnClassDefaults.Button,
            AutoWidth = false
        }
    });
}

<div class="content-header clearfix nex-plugin">
    <h1>@T("Plugins.Misc.Nexport.Group.Products")</h1>
</div>

<section class="content">
    <div class="container-fluid">
        <div class="form-horizontal">
            <div class="cards-group">
                <div class="card card-default card-search">
                    <div class="card-body">
                        <div class="row search-row @(!hideSearchBlock ? "opened" : "")" data-hideAttribute="@hideSearchBlockAttributeName">
                            <div class="search-text">@T("Admin.Common.Search")</div>
                            <div class="icon-search"><i class="fas fa-search" aria-hidden="true"></i></div>
                            <div class="icon-collapse"><i class="far fa-angle-@(!hideSearchBlock ? "up" : "down")" aria-hidden="true"></i></div>
                        </div>

                        <div class="search-body @(hideSearchBlock ? "closed" : "")">
                            <div class="row">
                                @if (Model.HasPurchasingAgentPermissions || Model.AdminView)
                                {
                                    <div class="col-md-6">
                                        <div class="form-group row">
                                            <div class="col-md-4">
                                                <nop-label asp-for="SearchGroupName" />
                                            </div>
                                            <div class="col-md-8">
                                                <nop-editor asp-for="SearchGroupName" />
                                                <input type="hidden" asp-for="@Model.AdminView" />
                                            </div>
                                        </div>
                                        <div class="form-group row">
                                            <div class="col-md-4">
                                                <nop-label asp-for="SearchGroupShortName" />
                                            </div>
                                            <div class="col-md-8">
                                                <nop-editor asp-for="SearchGroupShortName" />
                                            </div>
                                        </div>
                                    </div>
                                }
                                <div class="col-md-6">
                                    <div class="form-group row">
                                        <div class="col-md-4">
                                            <nop-label asp-for="SearchProductName" />
                                        </div>
                                        <div class="col-md-8">
                                            <nop-editor asp-for="SearchProductName" />
                                        </div>
                                    </div>
                                    <div class="form-group row">
                                        <div class="col-md-4">
                                            <nop-label asp-for="SearchStatusId" />
                                        </div>
                                        <div class="col-md-8">
                                            <nop-select asp-for="SearchStatusId" asp-items="Model.AvailableStatuses" />
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="form-group row">
                                <div class="text-center col-12">
                                    <button type="button" id="search-group-products" class="btn btn-primary btn-search"><i class="fas fa-search"></i>@T("Admin.Common.Search")</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card card-default">
                    <div class="card-body">
                        @await Html.PartialAsync("~/Plugins/Misc.Nexport/Views/Shared/Table.cshtml", new DataTablesModel
                        {
                           Name = "group-products-grid",
                           UrlRead = new DataUrl("GetNexportGroupProducts", "NexportWholesale", null),
                           SearchButtonId = "search-group-products",
                           Length = Model.PageSize,
                           LengthMenu = Model.AvailablePageSizes,
                           Filters = new List<FilterParameter>
                           {
                                new(nameof(Model.SearchGroupName)),
                                new(nameof(Model.SearchGroupShortName)),
                                new(nameof(Model.SearchProductName)),
                                new(nameof(Model.SearchStatusId)),
                                new(nameof(Model.AdminView))
                           },
                           ColumnCollection = columnCollection
                        })
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<script>
    function renderViewGroupProductRedemptions(data, type, row, meta) {
        var buttonFunction = "";

        if (row.GroupId !== null) {
            buttonFunction = "goToGroupProductRedemptions(" + row.Id + ", '" + row.GroupId + "')";
        } else {
            buttonFunction = "goToGroupProductRedemptions(" + row.Id + ", null)";
        }

        return renderCustomButton(buttonFunction, "far fa-eye", "@T("Plugins.Misc.Nexport.Group.Product.Button.View")");
    }

    function goToGroupProductRedemptions(productId, groupId) {
        var isAdminView = @Json.Serialize(Model.AdminView);

        var url = "";

        if (groupId) {
            if (isAdminView) {
                url = "@Url.RouteUrl("Plugin.Misc.Nexport.Admin.Group.Product.Redemptions")"
            } else {
                url = "@Url.RouteUrl("Plugin.Misc.Nexport.Customer.Group.Product.Redemptions")";
            }

            url += "/" + productId + "/" + groupId;
        } else {
            if (isAdminView) {
                url = "@Url.RouteUrl("Plugin.Misc.Nexport.Admin.Group.Product.Redemptions")";
            } else {
                url = "@Url.RouteUrl("Plugin.Misc.Nexport.Customer.Group.Product.Redemptions")";
            }

            url += "/" + productId;
        }

        //window.location.href = "groupProductRedemptionsRouteUrl?GroupId=" + groupId + "&ProductId=" + productId;
        window.location.href = url;
    }
</script>