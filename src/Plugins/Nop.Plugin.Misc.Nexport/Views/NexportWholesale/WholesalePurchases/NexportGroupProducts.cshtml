@using Nop.Plugin.Misc.Nexport.Models.NexportWholesale.WholesalePurchases
@model Nop.Plugin.Misc.Nexport.Models.NexportWholesale.WholesalePurchases.NexportGroupProductListSearchModel

@{
    const string hideSearchBlockAttributeName = "NexportGroupsPage.HideSearchBlock";
    var hideSearchBlock = await genericAttributeService.GetAttributeAsync<bool>(await workContext.GetCurrentCustomerAsync(), hideSearchBlockAttributeName);

    var groupsRouteUrl = Model.AdminView ? Url.RouteUrl("Plugin.Misc.Nexport.Admin.Groups") : Url.RouteUrl("Plugin.Misc.Nexport.Customer.Groups");
    var groupProductsRouteUrl = Model.AdminView ? Url.RouteUrl("Plugin.Misc.Nexport.Admin.Group.Products") : Url.RouteUrl("Plugin.Misc.Nexport.Customer.Group.Products");
    var groupProductRedemptionsRouteUrl = Model.AdminView ? Url.RouteUrl("Plugin.Misc.Nexport.Admin.Group.Product.Redemptions") : Url.RouteUrl("Plugin.Misc.Nexport.Customer.Group.Product.Redemptions");

    var groupProductText = Model.CurrentGroup.Id != null ? Model.CurrentGroup.Name : (Model.AdminView ? @T("Plugins.Misc.Nexport.Group.NoGroup") + " - " + T("Plugins.Misc.Nexport.Group.Products") : T("Plugins.Misc.Nexport.Group.Products").Text);
    var currentGroupId = @Model.CurrentGroup.Id?.ToString() ?? "null";
}

<div class="content-header clearfix nex-plugin">
    @if (Model.HasGroupPermission)
    {
        <nav aria-label="Breadcrumb">
            <ul class="uk-breadcrumb">
                <li >
                    <a href="@groupsRouteUrl" title="@T("Plugins.Misc.Nexport.Groups")">
                        <span>@T("Plugins.Misc.Nexport.Groups")</span>
                    </a>
                </li>

                <li >
                    @groupProductText
                    <span id="@(groupProductsRouteUrl + "?groupId=" + currentGroupId)">
                    </span>
                </li>
            </ul>
        </nav>
    }
    <h1>@groupProductText</h1>
</div>

<section class="content">
    <div class="container-fluid">
        <div class="form-horizontal">
            <div class="cards-group">

                <div class="card card-default card-search">
                    <div class="card-body">
                        <div class="row search-row @(!hideSearchBlock ? "opened" : "")" data-hideAttribute="@hideSearchBlockAttributeName">
                            <div class="search-text">@T("Admin.Common.Search")</div>
                            <div class="icon-search"><i class="fas fa-search" aria-hidden="true"></i></div>
                            <div class="icon-collapse"><i class="far fa-angle-@(!hideSearchBlock ? "up" : "down")" aria-hidden="true"></i></div>
                        </div>

                        <div class="search-body @(hideSearchBlock ? "closed" : "")">
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-group row">
                                        <div class="col-md-4">
                                            <nop-label asp-for="SearchName" />
                                        </div>
                                        <div class="col-md-8">
                                            <nop-editor asp-for="SearchName" />
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="form-group row">
                                <div class="text-center col-12">
                                    <button type="button" id="search-group-products" class="btn btn-primary btn-search"><i class="fas fa-search"></i>@T("Admin.Common.Search")</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card card-default">
                    <div class="card-body">

                        @await Html.PartialAsync("~/Plugins/Misc.Nexport/Views/Shared/Table.cshtml", new DataTablesModel
                        {
                        Name = "group-products-grid",
                        UrlRead = new DataUrl("GetNexportGroupProducts", "NexportWholesale",
                            new RouteValueDictionary {
                                { "GroupId", Model.CurrentGroup.Id }
                            }),
                        SearchButtonId = "search-group-products",
                        Length = Model.PageSize,
                        LengthMenu = Model.AvailablePageSizes,
                            Filters = new List<FilterParameter>
                        {
                            new FilterParameter(nameof(Model.SearchName)),
                        },
                        ColumnCollection = new List<ColumnProperty>
                        {
                        new ColumnProperty(nameof(NexportGroupProductModel.Name))
                        {
                        Title = @T("Plugins.Misc.Nexport.Group.Product.Name").Text
                        },
                        new ColumnProperty(nameof(NexportGroupProductModel.Available))
                        {
                        Title = @T("Plugins.Misc.Nexport.Group.Product.Available").Text
                        },
                        new ColumnProperty(nameof(NexportGroupProductModel.Awaiting))
                        {
                        Title = @T("Plugins.Misc.Nexport.Group.Product.Awaiting").Text
                        },
                        new ColumnProperty(nameof(NexportGroupProductModel.Redeemed))
                        {
                            Title = @T("Plugins.Misc.Nexport.Group.Product.Assigned").Text
                        },
                        new(nameof(NexportGroupModel.Id))
                        {
                        Width = "100",
                        Render = new RenderCustom("renderViewGroupProductRedemptions"),
                        ClassName = NopColumnClassDefaults.Button,
                        AutoWidth = false
                        },
                        }
                        })
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<script>
    function renderViewGroupProductRedemptions(data, type, row, meta) {
        return '<center><button class="btn btn-default" onClick="goToGroupProductRedemptions(' + row.Id + ',\'' + row.GroupId + '\')" ><i class="far fa-eye"/><span style="margin-left:5px;">@T("Plugins.Misc.Nexport.Group.Product.Button.View")</span></button></center>';
    }
    function goToGroupProductRedemptions(productId, groupId) {
        window.location.href = "@groupProductRedemptionsRouteUrl?GroupId=" + groupId + "&ProductId=" + productId;
    }
</script>