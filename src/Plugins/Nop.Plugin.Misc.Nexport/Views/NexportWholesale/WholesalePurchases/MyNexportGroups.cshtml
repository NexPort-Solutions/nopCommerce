@{
    

    var path = ViewData["PathForPartialView"] as string;
    var model = ViewData["ModelForPartialView"];

    
    // NopHtml.AddCssFileParts("~/lib_npm/bootstrap/css/bootstrap.min.css", "", true);
    // NopHtml.AddCssFileParts("~/css/admin/styles.css", "", true);

    NopHtml.AddScriptParts(ResourceLocation.Footer,"~/lib_npm/bootstrap/js/bootstrap.min.js", "", true);

    NopHtml.AddScriptParts(ResourceLocation.Footer, "~/lib_npm/moment/min/moment-with-locales.min.js", "", true);

    NopHtml.AddScriptParts(ResourceLocation.Footer, "~/lib_npm/datatables.net/js/jquery.dataTables.min.js", "", true);

    NopHtml.AddCssFileParts("~/lib_npm/datatables.net-bs4/css/dataTables.bootstrap4.min.css", "", true);
    NopHtml.AddScriptParts(ResourceLocation.Footer, "~/lib_npm/datatables.net-bs4/js/dataTables.bootstrap4.min.js", "", true);

    NopHtml.AddScriptParts(ResourceLocation.Footer, "~/lib_npm/datatables.net-buttons/js/dataTables.buttons.min.js", "", true);

    NopHtml.AddCssFileParts("~/lib_npm/datatables.net-buttons-bs4/css/buttons.bootstrap4.min.css", "", true);
    NopHtml.AddScriptParts(ResourceLocation.Footer, "~/lib_npm/datatables.net-buttons-bs4/js/buttons.bootstrap4.min.js", "", true);

    
    // NopHtml.AddScriptParts(ResourceLocation.Footer, "~/lib_npm/datatables.net-buttons/js/buttons.html5.min.js", "", true);

    NopHtml.AddCssFileParts("~/Plugins/Misc.Nexport/Content/uikit.min.css", "", true);
    NopHtml.AddScriptParts(ResourceLocation.Footer, "~/Plugins/Misc.Nexport/Scripts/uikit.min.js", "", true);

    NopHtml.AddScriptParts(ResourceLocation.Footer, "~/js/admin.common.js", "", true);

    var kendoVersion = "2020.1.406";

    Layout = "_ColumnsOne";

}
<link rel="stylesheet" href="~/lib/kendo/@kendoVersion/styles/web/kendo.common.min.css" />
<link rel="stylesheet" href="~/lib/kendo/@kendoVersion/styles/web/kendo.default.min.css" />
<link rel="stylesheet" href="~/lib/kendo/@kendoVersion/styles/web/kendo.rtl.min.css" />
<link rel="stylesheet" href="~/lib/kendo/@kendoVersion/styles/web/kendo.rtl.min.css" />

<style>
    .content-header h1 {
        font-size: 1.8rem;
        margin: 0;
    }
    .master-wrapper-content {
        background-color: #ecf0f5;
    }
    .card {
        box-shadow: 0 0 1px rgba(0,0,0,.125), 0 1px 3px rgba(0,0,0,.2);
        margin-bottom: 1rem;
    }
    .btn-default {
        background-color: #f8f9fa;
        border-color: #ddd;
        color: #444;
    }
    a:hover {
        text-decoration: none;
    }
    div.dataTables_wrapper div.dataTables_processing {
        border: none;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        margin-left: auto;
        margin-top: auto;
        z-index: 50;
        background: rgba(255,255,255,0.7);
        -ms-border-radius: 3px;
        border-radius: 3px;
    }
</style>
<div id="ajaxBusy">
    <span>&nbsp;</span>
</div>
<div class="page account-page nex-plugin">

    @await Html.PartialAsync(path, model)
 
</div>
<script>
    $(document).ready(function () {
        $("<link rel=\"stylesheet\" href = \"/lib_npm/bootstrap/css/bootstrap.min.css\" /><link rel=\"stylesheet\" href = \"/css/admin/styles.css\" />").insertBefore("link:first");
    })
</script>
<script src="~/lib/kendo/@kendoVersion/js/kendo.ui.core.min.js"></script>
<!script async src="https://kit.fontawesome.com/e4adf0b7ea.js" crossorigin="anonymous" asp-location="Footer"></!script>