@{
    var path = ViewData["PathForPartialView"] as string;
    var model = ViewData["ModelForPartialView"];

    NopHtml.AddScriptParts(ResourceLocation.Head, "~/lib_npm/jquery/jquery.min.js", "", true);
    NopHtml.AddScriptParts(ResourceLocation.Footer,"~/lib_npm/bootstrap/js/bootstrap.bundle.min.js", "", true);
    NopHtml.AddScriptParts(ResourceLocation.Footer, "~/lib_npm/moment/min/moment-with-locales.min.js", "", true);
    NopHtml.AddScriptParts(ResourceLocation.Footer, "~/lib_npm/datatables.net/js/jquery.dataTables.min.js", "", true);

    NopHtml.AddScriptParts(ResourceLocation.Footer, "~/lib_npm/datatables.net-bs4/js/dataTables.bootstrap4.min.js", "", true);
    NopHtml.AddScriptParts(ResourceLocation.Footer, "~/lib_npm/datatables.net-buttons/js/dataTables.buttons.min.js", "", true);
    NopHtml.AddScriptParts(ResourceLocation.Footer, "~/lib_npm/datatables.net-buttons-bs4/js/buttons.bootstrap4.min.js", "", true);

    NopHtml.AddScriptParts(ResourceLocation.Footer, "~/Plugins/Misc.Nexport/Scripts/nexport_plugin_common.js", "", true);

    NopHtml.AddScriptParts(ResourceLocation.Footer, "~/js/admin.common.js", "", true);

    Layout = "_ColumnsOne";
}

@* <link rel="stylesheet" href="~/Plugins/Misc.Nexport/Content/uikit.min.css" /> *@
<link rel="stylesheet" href="~/lib_npm/bootstrap/css/bootstrap.min.css" />
<link rel="stylesheet" href="~/lib_npm/datatables.net-bs4/css/dataTables.bootstrap4.min.css" />
<link rel="stylesheet" href="~/lib_npm/datatables.net-buttons-bs4/css/buttons.bootstrap4.min.css" />
<link rel="stylesheet" href="~/css/admin/styles.css" />
<link rel="stylesheet" href="~/Plugins/Misc.Nexport/Content/nexport.css" />

<style>
    .content-header h1 {
        font-size: 1.8rem;
        margin: 0;
    }
    .master-wrapper-content {
        background-color: #ecf0f5;
    }
    .card {
        box-shadow: 0 0 1px rgba(0,0,0,.125), 0 1px 3px rgba(0,0,0,.2);
        margin-bottom: 1rem;
    }
    .btn-default {
        background-color: #f8f9fa;
        border-color: #ddd;
        color: #444;
    }
    a:hover {
        text-decoration: none;
    }
    div.dataTables_wrapper div.dataTables_processing {
        border: none;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        margin-left: auto;
        margin-top: auto;
        z-index: 50;
        background: rgba(255,255,255,0.7);
        -ms-border-radius: 3px;
        border-radius: 3px;
    }
</style>
<div id="ajaxBusy">
    <span>&nbsp;</span>
</div>
<div class="page account-page nex-plugin">
    @await Html.PartialAsync(path, model)
</div>

<script src="~/Plugins/Misc.Nexport/Scripts/fontawesome/fontawesome.min.js"></script>
<script src="~/Plugins/Misc.Nexport/Scripts/fontawesome/regular.min.js"></script>
<script src="~/Plugins/Misc.Nexport/Scripts/fontawesome/solid.min.js"></script>
<script src="~/Plugins/Misc.Nexport/Scripts/fontawesome/light.min.js"></script>