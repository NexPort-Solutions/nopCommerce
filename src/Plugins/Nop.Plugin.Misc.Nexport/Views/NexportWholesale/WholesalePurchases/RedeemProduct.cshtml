@using Nop.Plugin.Misc.Nexport.Models.NexportWholesale.WholesalePurchases.RedeemProduct
@using Nop.Services.Helpers

@inject IWebHelper webHelper
@inject IThemeContext themeContext

@model Nop.Plugin.Misc.Nexport.Models.NexportWholesale.WholesalePurchases.RedeemProductModel

@{
    var groupProductRedemptionsRouteUrl = Model.AdminView ? Url.RouteUrl("Plugin.Misc.Nexport.Admin.Group.Product.Redemptions") : Url.RouteUrl("Plugin.Misc.Nexport.Customer.Group.Product.Redemptions");

    var groupText = Model.CurrentGroup.OrganizationId != null ? Model.CurrentGroup.Name : (Model.AdminView ? @T("Plugins.Misc.Nexport.Group.NoGroup").Text : T("Plugins.Misc.Nexport.Group.Products").Text);

    var redeemOrModifyText = T("Plugins.Misc.Nexport.Group.Product.Redemptions.Redeem") + " - " + groupText + " - " + Model.CurrentProduct.Name;

    var currentGroupId = @Model.CurrentGroup.OrganizationId?.ToString() ?? "null";

    NopHtml.AddCssFileParts("~/Plugins/Misc.Nexport/Content/redeem-product.css", "", true);

    var storeLocation = webHelper.GetStoreLocation();

    var themeName = await themeContext.GetWorkingThemeNameAsync();
    var backIconLink = $"{storeLocation}Themes/{themeName}/Content/images/back-button.png";

    if (Model.AdminView)
    {
        ViewBag.PageTitle = "Product Assignment";
    }
}

<style>
    .assign .back-link a {
        background: url('@backIconLink') left center no-repeat;
    }
</style>

<div class="content-header clearfix nex-plugin">
    <h1>
        @redeemOrModifyText
        <small>
            <i class="fas fa-arrow-circle-left"></i>
            <a href="@(groupProductRedemptionsRouteUrl + "?groupId=" + currentGroupId + "&productId=" + Model.CurrentProduct.Id)">Back to assignments list</a>
        </small>
    </h1>
</div>

<section class="content">
    <div class="container-fluid">
        <div class="form-horizontal">
            <div class="cards-group">
                <div class="card card-default">
                    <div class="card-body">
                        <ol class="assign" id="assign-steps">
                            <li id="assign-customer" class="tab-section allow">
                                <div class="step-title">
                                    <span class="number">1</span>
                                    <h2 class="title">@T("Plugins.Misc.Nexport.Group.Product.Redemption.RedeemProduct.SelectCustomer")</h2>
                                </div>
                                <div id="assign-step-customer" class="step a-item" style="display: none;">
                                    <form id="as-customer-form" action="" method="post">
                                        <div id="assignment-customer-load" class="container-fluid">
                                            @await Html.PartialAsync("~/Plugins/Misc.Nexport/Views/NexportWHolesale/WholesalePurchases/RedeemProduct/_CustomerStep.cshtml",
                                            new CustomerStepModel
                                            {
                                                ProductId = Model.CurrentProduct.Id,
                                                GroupId = Model.CurrentGroup.OrganizationId,
                                                AdminView = Model.AdminView
                                            })
                                        </div>
                                    </form>
                                    <script asp-location="Footer">
                                        Customer.init('#as-customer-form', "@Url.Action("AsnSaveCustomer", "NexportWholesale")");
                                    </script>
                                    <div class="buttons" id="customer-buttons-container">
                                        <button id="CustomerContinue" type="button" name="save" class="button-1" onclick="Customer.continue()">@T("Common.Continue")</button>
                                        <span class="please-wait" id="customer-please-wait" style="display: none;">@T("Common.LoadingNextStep")</span>
                                    </div>
                                </div>
                            </li>
                            @if (Model.AvailableMappings.Count > 1)
                            {
                                <li id="assign-product" class="tab-section">
                                    <div class="step-title">
                                        <span class="number">2</span>
                                        <h2 class="title">@T("Plugins.Misc.Nexport.Group.Product.Redemption.RedeemProduct.SelectProduct")</h2>
                                    </div>
                                    <div id="assign-step-product" class="step a-item" style="display: none;">
                                        <form id="as-product-form" action="" method="post">
                                            <div id="assignment-product-load" class="container-fluid">
                                            </div>
                                        </form>
                                        <script asp-location="Footer">
                                            Product.init('#as-product-form', "@Url.Action("AsnSaveProduct", "NexportWholesale")");
                                        </script>
                                        <div class="buttons" id="product-buttons-container">
                                            <p class="back-link">
                                                <a href="#" onclick="Assign.back(); return false; "><small>&laquo; </small>@T("Common.Back")</a>
                                            </p>
                                            <button type="button" name="save" class="button-1" onclick="Product.save()">@T("Common.Continue")</button>
                                        </div>
                                    </div>
                                </li>
                            }
                            <li id="assign-options" class="tab-section">
                                <div class="step-title">
                                    @{
                                        var addtionalOptionStepNumber = Model.AvailableMappings.Count > 1 ? 3 : 2;
                                    }
                                    <span class="number">@addtionalOptionStepNumber</span>
                                    <h2 class="title">Additional options</h2>
                                </div>
                                <div id="assign-step-product-options" class="step a-item" style="display: none;">
                                    <form id="as-options-form" action="" method="post">
                                        <div id="assignment-options-load" class="container-fluid">
                                        </div>
                                    </form>
                                    <script asp-location="Footer">
                                        ProductOptions.init('#as-options-form', "@Url.Action("AsnProductOptions", "NexportWholesale")", "@groupProductRedemptionsRouteUrl" + "?groupId=" + "@currentGroupId" + "&productId=" + "@Model.CurrentProduct.Id");
                                    </script>
                                    <div class="buttons" id="product-options-buttons-container">
                                        <p class="back-link">
                                            <a href="#" onclick="Assign.back(); return false; "><small>&laquo; </small>@T("Common.Back")</a>
                                        </p>
                                        <button type="button" name="save" class="button-1" onclick="ProductOptions.save()">@T("Common.Continue")</button>
                                    </div>
                                </div>
                            </li>
                            <li id="assign-confirm" class="tab-section">
                                <div class="step-title">
                                    @{
                                        var finalStepNumber = Model.AvailableMappings.Count > 1 ? 4 : 3;
                                    }
                                    <span class="number">@finalStepNumber</span>
                                    <h2 class="title">@T("Plugins.Misc.Nexport.Group.Product.Redemption.RedeemProduct.Confirm")</h2>
                                </div>
                                <div id="assign-step-confirm" class="step a-item" style="display: none;">
                                    <form id="as-confirm-form" action="" method="post">
                                        <div id="assignment-confirm-load" class="container-fluid">
                                            @*confirm content will be loaded here*@
                                        </div>
                                    </form>
                                    <script asp-location="Footer">
                                        Confirm.init('#as-confirm-form', "@Url.Action("AsnSaveConfirm", "NexportWholesale")", "@groupProductRedemptionsRouteUrl" + "?groupId=" + "@currentGroupId" + "&productId=" + "@Model.CurrentProduct.Id");
                                    </script>
                                    <div class="buttons" id="confirm-buttons-container">
                                        <p class="back-link">
                                            <a href="#" onclick="Assign.back(); return false; "><small>&laquo; </small>@T("Common.Back")</a>
                                        </p>
                                        <button type="button" name="save" class="button-1" onclick="Confirm.save()">@T("Common.Confirm")</button>
                                    </div>
                                </div>
                            </li>
                        </ol>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<script src="~/Plugins/Misc.Nexport/Scripts/redeem-product.js" asp-location="Footer"></script>
<script asp-location="Footer">
    Accordion.init('assign-steps', '.step-title', true);
    Accordion.openSection('#assign-customer');
    Assign.init('@(storeLocation)');
</script>