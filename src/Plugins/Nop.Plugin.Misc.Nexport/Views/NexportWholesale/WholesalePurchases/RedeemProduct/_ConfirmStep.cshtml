@model Nop.Plugin.Misc.Nexport.Models.NexportWholesale.WholesalePurchases.RedeemProduct.ConfirmStepModel

<div class="form-group row">
    <div class="col-sm-4">
        <nop-label asp-for="Email"></nop-label>
    </div>
    <div class="col-sm-8" style="text-align:left">
        <div class="col-form-label"> @Model.Email</div>
    </div>
</div>
<div class="form-group row">
    <div class="col-sm-4">
        <nop-label asp-for="FirstName"></nop-label>
    </div>
    <div class="col-sm-8" style="text-align:left">
        <div class="col-form-label"> @Model.FirstName</div>
    </div>
</div>
<div class="form-group row">
    <div class="col-sm-4">
        <nop-label asp-for="LastName"></nop-label>
    </div>
    <div class="col-sm-8" style="text-align:left">
        <div class="col-form-label"> @Model.LastName</div>
    </div>
</div>
<div class="form-group row">
    <div class="col-sm-4">
        <nop-label asp-for="Product"></nop-label>
    </div>
    <div class="col-sm-8" style="text-align:left">
        <div class="col-form-label"> @Model.Product</div>
    </div>
</div>
<div class="form-group row">
    <div class="col-sm-4">
        <nop-label asp-for="SendViaEmail"></nop-label>
    </div>
    <div class="col-sm-8" style="text-align:left">
        <div class="col-form-label">@Model.SendViaEmail</div>
    </div>
</div>
