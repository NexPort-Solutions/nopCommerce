@model Nop.Plugin.Misc.Nexport.Models.NexportWholesale.WholesalePurchases.RedeemProduct.OptionStepModel

<div id="additional-options">
    <div class="section">
        <label>Enrollment options</label>
    </div>
    <div class="form-group row section">
        <div class="col-sm-4">
            <nop-label asp-for="UtcStartDate" />
        </div>
        <div class="col-sm-4">
            <nop-editor asp-for="UtcStartDate" asp-render-form-control-class="true" />
            <span asp-validation-for="UtcStartDate"></span>
        </div>
    </div>
    @if (Model.IsOpenEnded)
    {
        <div class="form-group row section">
            <div class="col-sm-4">
                <nop-label asp-for="StoreId" />
            </div>
            <div class="col-sm-4">
                <nop-select asp-for="StoreId" asp-items="Model.AvailableStores" asp-multiple="false" title="Select Store" />
                <span asp-validation-for="StoreId"></span>
            </div>
        </div>
    }
    <div class="form-group row section">
        <div class="col-sm-4">
            <nop-label asp-for="PurchasingGroupId" />
        </div>
        <div class="col-sm-4">
            <nop-select asp-for="PurchasingGroupId" asp-items="Model.AvailableNexportPurchasingGroups" asp-multiple="false" title="Select Purchasing Group" />
            <span asp-validation-for="PurchasingGroupId"></span>
        </div>
        <input type="hidden" name="PurchasingGroupName" id="PurchasingGroupName" />
    </div>
    <div id="extension-options-container"></div>
</div>
<script>
    $(document).ready(function () {
        $("#@Html.IdFor(model => model.PurchasingGroupId)").on("change", function (e) {
            var selectedGroupName = $("#@Html.IdFor(model => model.PurchasingGroupId) option:selected").text()
            $("#PurchasingGroupName").val(selectedGroupName);
        });

        $("#@Html.IdFor(model => model.StoreId)").on("change", function (e) {
           verifyExistingEnrollment();
        });

        verifyExistingEnrollment();
    });

    function verifyExistingEnrollment() {
        console.log("Verifying existing enrollment...");
        var storeId = $("#@Html.IdFor(model => model.StoreId)").val();
        var postData = {
            storeId: storeId
        };
        addAntiForgeryToken(postData);

        $.ajax({
            url: "@Url.RouteUrl("VerifyExistingEnrollmentForRedemption")",
            data: postData,
            success: function (result) {
                if (result) {
                    $("#extension-options-container").html(result);
                }
            },
            error: function (xhr, textStatus, errorThrown) {
                console.log(errorThrown);
            }
        });
    }

    //# sourceURL=InvoiceAssignment-ProductOptions.js
</script>