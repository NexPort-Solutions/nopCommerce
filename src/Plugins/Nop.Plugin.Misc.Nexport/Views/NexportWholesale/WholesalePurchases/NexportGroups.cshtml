@using Nop.Plugin.Misc.Nexport.Models.NexportWholesale.WholesalePurchases
@model Nop.Plugin.Misc.Nexport.Models.NexportWholesale.WholesalePurchases.NexportGroupListSearchModel

@{
  
    var groupProductsRouteUrl = Model.AdminView ? Url.RouteUrl("Plugin.Misc.Nexport.Admin.Group.Products") : Url.RouteUrl("Plugin.Misc.Nexport.Customer.Group.Products");

    const string hideSearchBlockAttributeName = "NexportGroupsPage.HideSearchBlock";
    var hideSearchBlock = await genericAttributeService.GetAttributeAsync<bool>(await workContext.GetCurrentCustomerAsync(), hideSearchBlockAttributeName);
}

<div class="content-header clearfix">
    <h1 class="float-left">
        @T("Plugins.Misc.Nexport.Groups")
    </h1>
    <div class="float-right">
    </div>
</div>

<section class="content">
    <div class="container-fluid">
        <div class="form-horizontal">
            <div class="cards-group">
                
                <div class="card card-default card-search">
                    <div class="card-body">
                        <div class="row search-row @(!hideSearchBlock ? "opened" : "")" data-hideAttribute="@hideSearchBlockAttributeName">
                            <div class="search-text">@T("Admin.Common.Search")</div>
                            <div class="icon-search"><i class="fas fa-search" aria-hidden="true"></i></div>
                            <div class="icon-collapse"><i class="far fa-angle-@(!hideSearchBlock ? "up" : "down")" aria-hidden="true"></i></div>
                        </div>

                        <div class="search-body @(hideSearchBlock ? "closed" : "")">
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-group row">
                                        <div class="col-md-4">
                                            <nop-label asp-for="SearchName" />
                                        </div>
                                        <div class="col-md-8">
                                            <nop-editor asp-for="SearchName" />
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group row">
                                        <div class="col-md-4">
                                            <nop-label asp-for="SearchShortName" />
                                        </div>
                                        <div class="col-md-8">
                                            <nop-editor asp-for="SearchShortName" />
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="form-group row">
                                <div class="text-center col-12">
                                    <button type="button" id="search-groups" class="btn btn-primary btn-search"><i class="fas fa-search"></i>@T("Admin.Common.Search")</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card card-default">
                    <div class="card-body">

                        @await Html.PartialAsync("~/Plugins/Misc.Nexport/Views/Shared/Table.cshtml", new DataTablesModel
                        {
                            Name = "groups-grid",
                            UrlRead = new DataUrl("GetNexportGroups", "NexportWholesale", null),
                            SearchButtonId = "search-groups",
                            Length = Model.PageSize,
                            LengthMenu = Model.AvailablePageSizes,
                            Filters = new List<FilterParameter>
                            {
                                new FilterParameter(nameof(Model.SearchName)),
                                new FilterParameter(nameof(Model.SearchShortName)),
                            },
                            ColumnCollection = new List<ColumnProperty>
                            {
                                new ColumnProperty(nameof(NexportGroupModel.Name))
                                {
                                    Title = @T("Plugins.Misc.Nexport.Group.Name").Text
                                },
                                new ColumnProperty(nameof(NexportGroupModel.ShortName))
                                {
                                    Title = @T("Plugins.Misc.Nexport.Group.ShortName").Text
                                },
                                new ColumnProperty(nameof(NexportGroupModel.NumberOfProducts))
                                {
                                    Title = @T("Plugins.Misc.Nexport.Group.NumberOfProducts").Text
                                },
                                new(nameof(NexportGroupModel.Id))
                                {
                                    Width = "100",
                                    Render = new RenderCustom("renderViewGroupProducts"),
                                    ClassName = NopColumnClassDefaults.Button,
                                    AutoWidth = false
                                },
                            }
                        })
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<script>
    function renderViewGroupProducts(data, type, row, meta) 
    {
            return '<center><button class="btn btn-default" onClick="goToGroupProduct(\'' + data + '\')" ><i class="far fa-eye"/><span style="margin-left:5px;">@T("Plugins.Misc.Nexport.Group.Button.View")</span></button></center>';
    }
    function goToGroupProduct(e) {
        window.location.href = "@groupProductsRouteUrl?GroupId=" + e;
    }
</script>