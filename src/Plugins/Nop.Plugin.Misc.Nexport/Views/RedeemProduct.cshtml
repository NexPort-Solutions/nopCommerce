@model Nop.Plugin.Misc.Nexport.Models.Wholesale.RedeemProductModel
@{
    var groupsRouteUrl = Model.AdminView ? Url.RouteUrl("Plugin.Misc.Nexport.Admin.Groups") : Url.RouteUrl("Plugin.Misc.Nexport.Customer.Groups");
    var groupProductsRouteUrl = Model.AdminView ? Url.RouteUrl("Plugin.Misc.Nexport.Admin.Group.Products") : Url.RouteUrl("Plugin.Misc.Nexport.Customer.Group.Products");
    var groupProductRedemptionsRouteUrl = Model.AdminView ? Url.RouteUrl("Plugin.Misc.Nexport.Admin.Group.Product.Redemptions") : Url.RouteUrl("Plugin.Misc.Nexport.Customer.Group.Product.Redemptions");
    var redeemOrModifyText = T("Plugins.Misc.Nexport.Group.Product.Redemptions.Redeem") + " - " + Model.CurrentProduct.Name;

    var currentGroupId = @Model.CurrentGroup.Id?.ToString() ?? "null";


}

<div class="content-header clearfix nex-plugin">
    <nav aria-label="Breadcrumb">
        <ul class="uk-breadcrumb">
            <li>
                <a href="@groupsRouteUrl" title="@T("Plugins.Misc.Nexport.Groups")">
                    <span>@T("Plugins.Misc.Nexport.Groups")</span>
                </a>
            </li>
            <li>
                <a href="@(groupProductsRouteUrl+"?groupId="+currentGroupId)" title="@T("Plugins.Misc.Nexport.Group.Products")">
                    <span>@Model.CurrentGroup.Name</span>
                </a>
            </li>
            <li>
                <a href="@(groupProductRedemptionsRouteUrl+"?groupId="+currentGroupId+"&productId="+Model.CurrentProduct.Id)" title="Redemptions">
                    <span>@Model.CurrentProduct.Name</span>
                </a>
            </li>
            <li>
                @redeemOrModifyText
                <span id="@(groupProductRedemptionsRouteUrl+"?groupId="+currentGroupId+"&productId="+Model.CurrentProduct.Id)">
                </span>
            </li>
        </ul>
    </nav>
    <h1>@redeemOrModifyText</h1>
</div>

<section class="content">
    <div class="container-fluid">
        <div class="form-horizontal">
            <div class="cards-group">
                <div class="card card-default">
                    <div class="card-body">
                        <form asp-controller="NexportWholesale" asp-action="RedeemProductForCustomer">
                            <div class="form-group row">
                                <div class="col-sm-3">
                                    <div class="label-wrapper">
                                        <label for="search-customer-name-email" class="col-form-label">@T("Plugins.Misc.Nexport.Group.Product.Redemptions.Redeem.SelectCustomer")</label>
                                        <div title="" data-toggle="tooltip" class="ico-help" data-original-title="@T("Plugins.Misc.Nexport.Group.Product.Redemptions.Redeem.SelectCustomer")">
                                            <i class="fas fa-question-circle"></i>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-sm-9">
                                    <input type="text" id="search-customer-name-email" autocomplete="off" class="form-control" />

                                </div>
                            </div>
                            <div class="form-group row">
                                <div class="col-sm-3">
                                    <div class="label-wrapper">
                                        <label for="TrainingProductMappingId" class="col-form-label">@T("Plugins.Misc.Nexport.Group.Product.Redemptions.Redeem.SelectTraining")</label>
                                        <div title="" data-toggle="tooltip" class="ico-help" data-original-title="@T("Plugins.Misc.Nexport.Group.Product.Redemptions.Redeem.SelectTraining")">
                                            <i class="fas fa-question-circle"></i>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-sm-9">
                                    <nop-select asp-for="SelectedProductMappingId" asp-items="Model.AvailableMappings" asp-multiple="false" title="Select Training" asp-required="false" />
                                </div>
                            </div>
                            <div class="form-group row">
                                <div class="col-sm-3">
                                    <div class="label-wrapper">
                                        <label for="assignment-type" class="col-form-label">@T("Plugins.Misc.Nexport.Group.Product.Redemptions.Redeem.AssignmentType")</label>
                                        <div title="" data-toggle="tooltip" class="ico-help" data-original-title="@T("Plugins.Misc.Nexport.Group.Product.Redemptions.Redeem.AssignmentType")">
                                            <i class="fas fa-question-circle"></i>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-sm-9">
                                    <div class="raw">
                                        <div class="form-check">
                                            <input type="radio" class="form-check-input" asp-for="AssignmentType" value="Email" id="assignment-type-email"/>
                                            <label class="form-check-label" for="assignment-type-email">
                                                @T("Plugins.Misc.Nexport.Group.Product.Redemptions.Redeem.AssignmentType.Option1")
                                            </label>
                                        </div>
                                        <div class="form-check">
                                            <input type="radio" class="form-check-input" asp-for="AssignmentType" value="Instant" id="assignment-type-instant"/>
                                            <label class="form-check-label" for="assignment-type-instant">
                                                @T("Plugins.Misc.Nexport.Group.Product.Redemptions.Redeem.AssignmentType.Option2")
                                            </label>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="form-group row">
                                <div class="col-md-9 offset-md-3">
                                    <input asp-for="UserId" style="display: none;" />
                                    <input asp-for="InvoiceItemId" style="display: none;" />
                                    <input asp-for="ProductMappingIdForOpenEndedProduct" style="display:none" />
                                    <input name="ReturnUrl" id="ReturnUrl" value="@(groupProductRedemptionsRouteUrl+"?groupId="+currentGroupId+"&productId="+Model.CurrentProduct.Id)" style="display: none;" />
                                    <button type="submit" class="btn btn-primary">Submit</button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<script>
    $(document).ready(function () {
        $('#search-customer-name-email').autocomplete({
            delay: 500,
            minLength: 3,
            source: '@Url.Action("SearchNexportUsers", "NexportWholesale")',
            select: function (event, ui) {
                $('#@Html.IdFor(model => model.UserId)').val(ui.item.nexportUserId);
                $('#search-customer-name-email').val(ui.item.label);
                return false;
            }
        });
    });
</script>