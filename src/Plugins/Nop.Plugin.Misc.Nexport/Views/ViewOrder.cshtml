@using Nop.Plugin.Misc.Nexport.Areas.Admin.Controllers;
@using Nop.Plugin.Misc.Nexport.Extensions;
@using Nop.Plugin.Misc.Nexport.Services

@inject IWorkContext workContext
@inject IUserMappingService userMapping

@model Nop.Plugin.Misc.Nexport.Domain.OrderInvoiceItem

@{
    var currentCustomer = await workContext.GetCurrentCustomerAsync();
}

<div id="redemption-details" style="">
    @if (await userMapping.FindByCustomerId(currentCustomer.Id) is { UserId: var currentUserId } 
        && Model.RedeemingUserId == currentUserId)
    {
            <a href="javascript:void(0);" onclick="navigateToClassroom(this); return false;"
               data-order-invoice-id="@Model.Id" id="go-to-nexport-link">Click here to go to Nexport</a>
    }
    else
    {
        <span>This product has been redeemed by user [@Model.RedeemingUserId]</span>
    }
</div>
<script>
    function navigateToClassroom(element) {
        var orderInvoiceItemId = $(element).data("order-invoice-id");
        if (orderInvoiceItemId) {
            var url = "@Url.Action(nameof(IntegrationController.GoToNexport), ViewUtilities.GetControllerName<IntegrationController>())";
            url += "?orderInvoiceItemId=" + orderInvoiceItemId;
            navigateToNexport(url);
        }
    }
</script>