@model Nop.Plugin.Misc.Nexport.Models.Wholesale.ConfirmStepModel

<div class="form-group row">
    <div class="col-sm-4">
        <div class="label-wrapper">
            <label class="col-form-label">Email</label>
        </div>
    </div>
    <div class="col-sm-8" style="text-align:left">
        <div class="col-form-label"> @Model.Email</div>
    </div>
</div>
<div class="form-group row">
    <div class="col-sm-4">
        <div class="label-wrapper">
            <label class="col-form-label">First Name</label>
        </div>
    </div>
    <div class="col-sm-8" style="text-align:left">
        <div class="col-form-label"> @Model.FirstName</div>
    </div>
</div>
<div class="form-group row">
    <div class="col-sm-4">
        <div class="label-wrapper">
            <label class="col-form-label">Last Name</label>
        </div>
    </div>
    <div class="col-sm-8" style="text-align:left">
        <div class="col-form-label"> @Model.LastName</div>
    </div>
</div>
<div class="form-group row">
    <div class="col-sm-4">
        <div class="label-wrapper">
            <label class="col-form-label">Product Selected</label>
        </div>
    </div>
    <div class="col-sm-8" style="text-align:left">
        <div class="col-form-label"> @Model.Product</div>
    </div>
</div>
<div class="form-group row">
    <div class="col-sm-4">
        <div class="label-wrapper">
            <label class="col-form-label">Send redemption link to user via email</label>
        </div>
    </div>
    <div class="col-sm-8" style="text-align:left">
        <div class="col-form-label">@Model.SendViaEmail</div>
    </div>
</div>
