@using Nop.Plugin.Misc.Nexport.Areas.Admin.Controllers;
@using Nop.Plugin.Misc.Nexport.Extensions;
@using Nop.Plugin.Misc.Nexport.Models.ProductMappings
@using DataTablesModel = Nop.Plugin.Misc.Nexport.Models.DataTablesModel;

@model Nop.Plugin.Misc.Nexport.Models.ProductMappings.ProductGroupMembershipMappingListSearchModel

@await Html.PartialAsync("~/Plugins/Misc.Nexport/Views/Shared/Table.cshtml", new DataTablesModel
{
    Name = "product-mapping-group-memberships-grid",
    UrlRead = new DataUrl(nameof(IntegrationController.GetProductGroupMembershipMappings), ViewUtilities.GetControllerName<IntegrationController>(), new RouteValueDictionary {
        { "nexportProductMappingId", Model.ProductMappingId }
    }),
    UrlDelete = new DataUrl(nameof(IntegrationController.DeleteGroupMembershipMapping), ViewUtilities.GetControllerName<IntegrationController>(), null),
    Length = Model.PageSize,
    LengthMenu = Model.AvailablePageSizes,
    Filters = new List<FilterParameter>
    {
        new(nameof(Model.ProductMappingId))
    },
    ColumnCollection = new List<ColumnProperty>
    {
        new(nameof(ProductGroupMembershipMappingModel.GroupId))
        {
            Title = "Group Id",
            Width = "250",
        },
        new(nameof(ProductGroupMembershipMappingModel.Id))
        {
            Title = "Group",
            Width = "200",
            Render = new RenderCustom("renderGroupName")
        },
        new(nameof(ProductGroupMembershipMappingModel.Id))
        {
            Width = "50",
            Render = new RenderButtonRemove(T("Admin.Common.Delete").Text),
            ClassName = NopColumnClassDefaults.Button,
            AutoWidth = false
        }
    }
})

<input type="submit" id="btnRefreshGroupMembershipMappings" style="display: none">

<script>
    function renderGroupName(data, type, row, meta) {
        var textRenderer = $.fn.dataTable.render.text().display;
        var groupName = row.GroupName;
        var displayText = groupName;

        if (groupName !== null) {
            displayText += " - " + row.GroupShortName;
        }

        return textRenderer(displayText);
    }
</script>
