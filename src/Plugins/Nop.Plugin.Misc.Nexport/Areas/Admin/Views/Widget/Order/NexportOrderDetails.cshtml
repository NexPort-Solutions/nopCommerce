@model Nop.Plugin.Misc.Nexport.Models.Order.NexportOrderAdditionalInfoModel

@{
    NopHtml.AddScriptParts(ResourceLocation.Footer, "~/Plugins/Misc.Nexport/Scripts/nexport_plugin_common.js");

    const string hideNexportOrderApprovalBlockAttributeName = "OrderPage.HideNexportOrderApprovalBlock";
    var hideNexportOrderApprovalBlock = await genericAttributeService.GetAttributeAsync(await workContext.GetCurrentCustomerAsync(), hideNexportOrderApprovalBlockAttributeName,defaultValue:true);
}

<nop-card asp-name="customersettings-nexportregistrationfields" asp-icon="fas fa-pencil-square-o"
          asp-title="Nexport order approval"
          asp-hide-block-attribute-name="@hideNexportOrderApprovalBlockAttributeName" asp-hide="@hideNexportOrderApprovalBlock" asp-advanced="true">
    <div class="card-body">
    @await Html.PartialAsync("~/Plugins/Misc.Nexport/Areas/Admin/Views/Order/_OrderDetails.NexportOrderApproval.cshtml", Model.NexportOrderApprovalModel)
    </div>
</nop-card>