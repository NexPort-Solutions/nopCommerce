@model Nop.Plugin.Misc.Nexport.Models.Order.NexportOrderAdditionalInfoModel

@{
    NopHtml.AddScriptParts(ResourceLocation.Footer, "~/Plugins/Misc.Nexport/Scripts/nexport_plugin_common.js");

    var currentCustomer = await workContext.GetCurrentCustomerAsync();

    const string hideNexportOrderApprovalBlockAttributeName = "OrderPage.NexportOrderApprovalBlock";
    var hideNexportOrderApprovalBlock = await genericAttributeService.GetAttributeAsync(currentCustomer, hideNexportOrderApprovalBlockAttributeName, defaultValue: true);
}

<nop-card asp-name="customersettings-nexportregistrationfields" asp-icon="fas fa-pencil-square-o"
           asp-title="Nexport order approval"
           asp-hide-block-attribute-name="@hideNexportOrderApprovalBlockAttributeName" asp-hide="@hideNexportOrderApprovalBlock" asp-advanced="true">
    @await Html.PartialAsync("~/Plugins/Misc.Nexport/Areas/Admin/Views/NexportOrder/_OrderDetails.NexportOrderApproval.cshtml", Model.NexportOrderApprovalModel)
</nop-card>