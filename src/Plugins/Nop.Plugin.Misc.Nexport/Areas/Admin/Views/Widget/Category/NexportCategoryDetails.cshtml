@model Nop.Plugin.Misc.Nexport.Models.Category.NexportCategoryModel

@{
    var customer = await workContext.GetCurrentCustomerAsync();
    const string hideNexportOptionsBlockAttributeName = "CategoryPage.HideNexportOptionsBlock";
    var hideNexportOptionsBlock = await genericAttributeService.GetAttributeAsync<bool>(customer, hideNexportOptionsBlockAttributeName);
}

<nop-card asp-name="nexport-category-options" asp-icon="fas fa-sliders-h"
          asp-hide-block-attribute-name="@hideNexportOptionsBlockAttributeName" asp-hide="@hideNexportOptionsBlock"
          asp-title="@T("Plugins.Misc.Nexport.Category.Options")" asp-advanced="true">
    <div class="card-body">
        @await Html.PartialAsync("../../NexportCategory/NexportOptions.cshtml", Model)
    </div>
</nop-card>

@if (ViewBag.ManageNexportProductMapping)
{
    @await Component.InvokeAsync("WidgetsNexportCategoryProductMappings", new {additionalData = Model})
}