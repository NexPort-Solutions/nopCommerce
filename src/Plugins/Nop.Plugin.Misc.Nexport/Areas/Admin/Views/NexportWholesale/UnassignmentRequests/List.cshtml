@inject IWorkContext workContext

@using Nop.Plugin.Misc.Nexport.Areas.Admin.Models.NexportWholesale.WholesalePurchases
@using Nop.Plugin.Misc.Nexport.Domain.Enums
@using Nop.Plugin.Misc.Nexport.Domain.Wholesale
@using Nop.Plugin.Misc.Nexport.Models.NexportWholesale.WholesalePurchases
@model Nop.Plugin.Misc.Nexport.Areas.Admin.Models.NexportWholesale.WholesalePurchases.NexportRedemptionUnassignmentRequestListSearchModel

@{
    ViewBag.Title = T("RedemptionUnassignmentRequests").Text;
    
    NopHtml.SetActiveMenuItemSystemName("UnassignmentRequests");

    var currentCustomer = await workContext.GetCurrentCustomerAsync();

    const string hideSearchBlockAttributeName = "UnassignmentRequestsPage.HideSearchBlock";
    var hideSearchBlock = await genericAttributeService.GetAttributeAsync(currentCustomer, hideSearchBlockAttributeName, defaultValue: true);
}

<nop-antiforgery-token />
<div class="content-header clearfix">
    <h1 class="float-left">
        @T("RedemptionUnassignmentRequests")
    </h1>
</div>
<div class="content">
    <div class="form-horizontal">
        <div class="cards-group">
            <div class="card card-default panel-search">
                <div class="card-body">
                    <div class="row search-row @(!hideSearchBlock ? "opened" : "")" data-hideAttribute="@hideSearchBlockAttributeName">
                        <div class="search-text">@T("Admin.Common.Search")</div>
                        <div class="icon-search"><i class="fa fa-search" aria-hidden="true"></i></div>
                        <div class="icon-collapse"><i class="fa fa-angle-down" aria-hidden="true"></i></div>
                    </div>
                    <div class="search-body @(hideSearchBlock ? "closed" : "")">

                        <div class="row">
                            <div class="col-md-5">
                                <div class="form-group row">
                                    <div class="col-md-4">
                                        <nop-label asp-for="StartDate"/>
                                    </div>
                                    <div class="col-md-8">
                                        <nop-editor asp-for="StartDate"/>
                                    </div>
                                </div>
                                <div class="form-group row">
                                    <div class="col-md-4">
                                        <nop-label asp-for="EndDate"/>
                                    </div>
                                    <div class="col-md-8">
                                        <nop-editor asp-for="EndDate"/>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-7">
                                <div class="form-group row">
                                    <div class="col-md-4">
                                        <nop-label asp-for="RequestStatusId"/>
                                    </div>
                                    <div class="col-md-8">
                                        <nop-select asp-for="RequestStatusId" asp-items="Model.RequestStatusList"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-7 offset-md-5">
                                <button type="button" id="search-unassignmentrequests" class="btn btn-primary btn-search">
                                    <i class="far fa-search"></i>
                                    @T("Admin.Common.Search")
                                </button>
                            </div>
                        </div> 
                    </div>
                </div>
            </div>
            <div class="card card-default">
                <div class="card-body">
                    <p>
                        @T("RedemptionUnassignmentRequests.Description")
                    </p>
                  @await Html.PartialAsync("Table", new DataTablesModel
               {
                   Name = "unassignment-requests-grid",
                   UrlRead = new DataUrl("UnassignmentRequestsList", "NexportWholesale", null),
                   SearchButtonId = "search-unassignmentrequests",
                   Length = Model.PageSize,
                   LengthMenu = Model.AvailablePageSizes,
                   Filters = new List<FilterParameter>
                    {
                    new(nameof(Model.StartDate)),
                    new(nameof(Model.EndDate)),
                    new(nameof(Model.RequestStatusId))
                    },
                   ColumnCollection = new List<ColumnProperty>
                    {
                        new(nameof(NexportRedemptionUnassignmentRequestModel.Id))
                        {
                            Title = "Id"
                        },
                    new(nameof(NexportRedemptionUnassignmentRequestModel.InvoiceItemId))
                        {
                            Title = "Nexport Invoice Item"
                        },
                        new(nameof(NexportRedemptionUnassignmentRequestModel.OrderId))
                        {
                            Title = "Order",
                            ClassName = NopColumnClassDefaults.Button,
                            Render =  new RenderCustom("renderOrderInfo"),
                            Width = "100",
                            AutoWidth = false
                        },
                        new(nameof(NexportRedemptionUnassignmentRequestModel.RequestedByCustomerId))
                        {
                            Title = T("RedemptionUnassignmentRequests.Fields.Customer").Text,
                            Width = "350",
                            Render = new RenderCustom("renderCustomerInfo")
                        },
                        new(nameof(NexportRedemptionUnassignmentRequestModel.CustomerComments))
                        {
                            Title = T("RedemptionUnassignmentRequests.Fields.CustomerComments").Text
                        },
                    new(nameof(NexportRedemptionUnassignmentRequestModel.RequestStatus))
                        {
                        Title = T("RedemptionUnassignmentRequests.Fields.RequestStatus").Text,
                        Width = "200",
                        Render = new RenderCustom("renderStatusInfo")
                        },
                    new(nameof(NexportRedemptionUnassignmentRequestModel.UtcCreatedDate))
                        {
                    Title = T("RedemptionUnassignmentRequests.Fields.CreatedOn").Text,
                        Width = "100",
                        Render = new RenderDate()
                        },
                    new(nameof(NexportRedemptionUnassignmentRequestModel.Id))
                        {
                        Title = T("Admin.Common.Edit").Text,
                        Width = "100",
                        ClassName =  NopColumnClassDefaults.Button,
                        Render = new RenderButtonEdit(new DataUrl("Edit"))
                        }
                    }
               })

                  <script>
                    
                        function renderOrderInfo(data, type, row, meta) {
                            if (row.OrderId > 0) {
                                var textRenderer = $.fn.dataTable.render.text().display;
                                return "<a class=\"btn btn-default\" href=\"@Url.Content("~/Admin/Order/Edit/")" +
                                    row.OrderId + "\"><i class=\"fa fa-eye\"></i>" +
                                    textRenderer(row.OrderId) + " - @T("Admin.Common.View")</a>";
                            } else {
                                return "order item is deleted";
                            }
                        }
                        
                        function renderCustomerInfo(data, type, row, meta) {
                            var textRenderer = $.fn.dataTable.render.text().display;
                            return "<a href=\"@Url.Content("~/Admin/Customer/Edit/")" + row.RequestedByCustomerId + "\">" +
                                textRenderer(row.CustomerInfo) + "</a>";
                    }

                        function renderStatusInfo(data, type, row, meta) {
                            if (data === +"@((int) NexportRedemptionUnassignmentRequestStatus.Accepted)") {
                                return "Accepted";
                                } else if (data === +"@((int)NexportRedemptionUnassignmentRequestStatus.Received)") {
                                return "Received";
                                } else if (data === +"@((int)NexportRedemptionUnassignmentRequestStatus.Rejected)") {
                                return "Rejected";
                            }

                            return "Unknown";
                        }
                    
                  </script>  
                </div>
            </div>
        </div>
    </div>
</div>