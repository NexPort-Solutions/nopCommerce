@model Nop.Plugin.Misc.Nexport.Models.NexportWholesale.WholesalePurchases.NexportRedemptionUnassignmentRequestModel

@{
    ViewBag.Title = T("RedemptionUnassignmentRequests.EditUnassignmentRequestDetails").Text;
    NopHtml.SetActiveMenuItemSystemName("UnassignmentRequests");
}

<form asp-controller="NexportWholesale" asp-action="EditUnassignmentRequest" method="post">
    <div class="content-header clearfix">
        <h1 class="float-left">
            @T("RedemptionUnassignmentRequests.EditUnassignmentRequestDetails")
            <small>
                <i class="fas fa-arrow-circle-left"></i>
                <a asp-action="UnassignmentRequestsList">@T("RedemptionUnassignmentRequests.EditUnassignmentRequest.BackToList")</a>
            </small>
        </h1>
        <div class="float-right">
            <button type="submit" name="save" class="btn btn-primary">
                <i class="far fa-save"></i>
                @T("Admin.Common.Save")
            </button>
            <button type="submit" name="save-continue" class="btn btn-primary">
                <i class="far fa-save"></i>
                @T("Admin.Common.SaveContinue")
            </button>
            <span id="unassignmentrequest-delete" class="btn bg-red">
                <i class="far fa-trash-alt"></i>
                @T("Admin.Common.Delete")
            </span>
        </div>
    </div>
    @await Html.PartialAsync("~/Plugins/Misc.Nexport/Areas/Admin/Views/NexportWholesale/UnassignmentRequests/_CreateOrUpdate.cshtml", Model)
</form>
<nop-delete-confirmation asp-model-id="@Model.Id" asp-button-id="unassignmentrequest-delete" />