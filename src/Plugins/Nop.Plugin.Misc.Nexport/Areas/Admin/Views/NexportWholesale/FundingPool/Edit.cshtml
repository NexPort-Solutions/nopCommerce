@using Nop.Plugin.Misc.Nexport.Areas.Admin.Models.FundingPool

@model NexportFundingPoolModel

@{
    ViewBag.PageTitle = T("Plugins.Misc.Nexport.FundingPool.Edit").Text;
    NopHtml.SetActiveMenuItemSystemName("Nexport Funding Pools");
}

<form asp-controller="NexportWholesale" asp-action="EditFundingPool" method="post" id="edit-funding-pool-form">
    <div class="content-header clearfix">
        <h1 class="float-left">
            @T("Plugins.Misc.Nexport.FundingPool.Edit") - @Model.Name
            <small>
                <i class="fas fa-arrow-circle-left"></i>
                <a asp-action="ListFundingPools" asp-controller="NexportWholesale">
                    @T("Plugins.Misc.Nexport.FundingPool.BackToList")
                </a>
            </small>
        </h1>
        <div class="float-right">
            <button type="submit" name="save" class="btn btn-primary">
                <i class="far fa-save"></i>
                @T("Admin.Common.Save")
            </button>
            <button type="submit" name="save-continue" class="btn btn-primary">
                <i class="far fa-save"></i>
                @T("Admin.Common.SaveContinue")
            </button>
            <span id="delete-funding-pool" name="delete" class="btn bg-red">
                <i class="fa fa-trash-o"></i>
                @T("Admin.Common.Delete")
            </span>
        </div>
    </div>
    @await Html.PartialAsync("~/Plugins/Misc.Nexport/Areas/Admin/Views/NexportWholesale/FundingPool/_CreateOrUpdate.cshtml", Model))
</form>
<nop-delete-confirmation asp-model-id="@Model.Id" asp-button-id="delete-funding-pool" asp-action="DeleteFundingPool" />