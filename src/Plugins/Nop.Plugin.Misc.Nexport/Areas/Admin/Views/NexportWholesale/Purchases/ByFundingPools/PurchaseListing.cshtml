@using Nop.Plugin.Misc.Nexport.Models.NexportWholesale.WholesalePurchases

@model Nop.Plugin.Misc.Nexport.Areas.Admin.Models.NexportWholesale.WholesalePurchases.NexportPurchasesByFundingPoolListSearchModel

@{
    const string hideSearchBlockAttributeName = "NexportGroupsPage.HideSearchBlock";
    var hideSearchBlock = await genericAttributeService.GetAttributeAsync<bool>(await workContext.GetCurrentCustomerAsync(), hideSearchBlockAttributeName);

    var columnCollection = new List<ColumnProperty>();
    columnCollection.AddRange(new List<ColumnProperty>
    {
        new(nameof(NexportGroupProductModel.FundingPool))
        {
            Title = T("Plugins.Misc.Nexport.Group.FundingPool").Text,
            Width = "400",
        },
        new(nameof(NexportGroupProductModel.Available))
        {
            Title = T("Plugins.Misc.Nexport.Group.Product.Available").Text,
            Width = "100"
        },
        new(nameof(NexportGroupProductModel.ProcessingAvailable))
        {
            Title = T("Plugins.Misc.Nexport.Group.Product.ProcessingAvailable").Text,
            Width = "100"
        },
        new(nameof(NexportGroupProductModel.Awaiting))
        {
            Title = T("Plugins.Misc.Nexport.Group.Product.Awaiting").Text,
            Width = "100"
        },
        new(nameof(NexportGroupProductModel.ProcessingAwaiting))
        {
            Title = T("Plugins.Misc.Nexport.Group.Product.ProcessingAwaiting").Text,
            Width = "100"
        },
        new(nameof(NexportGroupProductModel.ApprovalAwaiting))
        {
            Title = T("Plugins.Misc.Nexport.Group.Product.ApprovalAwaiting").Text,
            Width = "100"
        },
        new(nameof(NexportGroupProductModel.Redeemed))
        {
            Title = T("Plugins.Misc.Nexport.Group.Product.Assigned").Text,
            Width = "100"
        },
        new(nameof(NexportGroupProductModel.ProcessingRefund))
        {
            Title = T("Plugins.Misc.Nexport.Group.Product.ProcessingRefund").Text,
            Width = "100"
        },
        new(nameof(NexportGroupProductModel.Refunded))
        {
            Title = T("Plugins.Misc.Nexport.Group.Product.Refunded").Text,
            Width = "100"
        },
        new(nameof(NexportGroupProductModel.Total))
        {
            Title = T("Plugins.Misc.Nexport.Group.Product.Total").Text,
            Width = "100"
        },
        new(nameof(NexportGroupProductModel.FundingPoolId))
        {
            Width = "100",
            Render = new RenderCustom("renderViewRedemptions"),
            ClassName = NopColumnClassDefaults.Button,
            AutoWidth = false
        }
    });
}

<div class="content-header clearfix">
    <h1>@T("Plugins.Misc.Nexport.Group.Products")</h1>
</div>

<section class="content">
    <div class="container-fluid">
        <div class="form-horizontal">
            <div class="cards-group">
                <div class="card card-default card-search">
                    <div class="card-body">
                        <div class="row search-row @(!hideSearchBlock ? "opened" : "")" data-hideAttribute="@hideSearchBlockAttributeName">
                            <div class="search-text">@T("Admin.Common.Search")</div>
                            <div class="icon-search"><i class="fas fa-search" aria-hidden="true"></i></div>
                            <div class="icon-collapse"><i class="far fa-angle-@(!hideSearchBlock ? "up" : "down")" aria-hidden="true"></i></div>
                        </div>

                        <div class="search-body @(hideSearchBlock ? "closed" : "")">
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-group row">
                                        <div class="col-md-4">
                                            <nop-label asp-for="SearchFundingPoolName" />
                                        </div>
                                        <div class="col-md-8">
                                            <nop-editor asp-for="SearchFundingPoolName" />
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group row">
                                        <div class="col-md-4">
                                            <nop-label asp-for="SearchStatusId" />
                                        </div>
                                        <div class="col-md-8">
                                            <nop-select asp-for="SearchStatusId" asp-items="Model.AvailableStatuses" />
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="form-group row">
                                <div class="text-center col-12">
                                    <button type="button" id="search-purchases-by-funding-pools" class="btn btn-primary btn-search"><i class="fas fa-search"></i>@T("Admin.Common.Search")</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card card-default">
                    <div class="card-body">
                        @await Html.PartialAsync("~/Plugins/Misc.Nexport/Views/Shared/Table.cshtml", new DataTablesModel
                        {
                           Name = "purchases-by-funding-pools-grid",
                           UrlRead = new DataUrl("GetNexportWholesalePurchasesByFundingPools", "NexportWholesale", null),
                           SearchButtonId = "search-purchases-by-funding-pools",
                           Length = Model.PageSize,
                           LengthMenu = Model.AvailablePageSizes,
                           Filters = new List<FilterParameter>
                           {
                                new(nameof(Model.SearchFundingPoolName)),
                                new(nameof(Model.SearchStatusId))
                           },
                           ColumnCollection = columnCollection
                        })
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<script>
    function renderViewRedemptions(data, type, row, meta) {
        var buttonFunction = "";
        var url = "";

        if (row.FundingPoolId) {
            url = "@Url.RouteUrl("Plugin.Misc.Nexport.Admin.Wholesale.Purchase.ByFundingPools.Redemptions")"
            url += "/" + row.FundingPoolId;
        } else {
            url = "@Url.RouteUrl("Plugin.Misc.Nexport.Admin.Wholesale.Purchase.ByFundingPools.Redemptions")";
        }

        return renderCustomLinkTag(url, null, "far fa-eye", "@T("Plugins.Misc.Nexport.Group.Product.Button.View")");
    }
</script>