@using Nop.Plugin.Misc.Nexport.Domain.Enums
@using Nop.Plugin.Misc.Nexport.Extensions
@using Nop.Plugin.Misc.Nexport.Models.NexportWholesale.WholesalePurchases
@using Nop.Services.Customers

@model NexportProductRedemptionListSearchModel

@inject ICustomerService CustomerService

@{
    ViewBag.PageTitle = "Wholesale Purchase Redemptions";

    NopHtml.AddCssFileParts("~/Plugins/Misc.Nexport/Content/nexport-admin.css");
    NopHtml.AddCssFileParts("~/Plugins/Misc.Nexport/Content/fontawesome/css/all.min.css");

    NopHtml.SetActiveMenuItemSystemName("Wholesale Purchases - By Funding Pools");

    NopHtml.AddScriptParts(ResourceLocation.Footer, "~/Plugins/Misc.Nexport/Scripts/nexport_plugin_common.js");
}

@{
    var currentCustomer = await workContext.GetCurrentCustomerAsync();
    var hasAdminRole = await CustomerService.IsAdminAsync(currentCustomer);
    const string hideSearchBlockAttributeName = "NexportGroupsPage.HideSearchBlock";
    var hideSearchBlock = await genericAttributeService.GetAttributeAsync<bool>(currentCustomer, hideSearchBlockAttributeName);

    var backBtnUrl = Url.RouteUrl("Plugin.Misc.Nexport.Admin.Wholesale.Purchase.ByFundingPools.List");
    var name = Model.FundingPoolId != null ? $"within {Model.FundingPool.Name}" : "without funding pools";
    var headerText = "Purchases " + name;

    var redemptionsColumns = new List<ColumnProperty>
    {
        new(nameof(NexportGroupProductRedemptionModel.Name))
        {
            Title = T("Plugins.Misc.Nexport.Group.Product.Redemption.Customer").Text,
            Render = new RenderCustom("renderCustomerDetails"),
            Width = "300"
        },
        new(nameof(NexportGroupProductRedemptionModel.ProductName))
        {
            Title = T("Plugins.Misc.Nexport.Group.Product.Redemption.Product.Name").Text,
            Width = "400"
        },
        new(nameof(NexportGroupProductRedemptionModel.AssignedProductName))
        {
            Title = T("Plugins.Misc.Nexport.Group.Product.Redemption.AssignedProduct.Name").Text,
            Width = "400"
        },
        new(nameof(NexportGroupProductRedemptionModel.Status))
        {
            Title = T("Plugins.Misc.Nexport.Group.Product.Redemption.Status").Text,
            Width = "100"
        },
        new(nameof(NexportGroupProductRedemptionModel.PurchasedInStore))
        {
            Title = T("Plugins.Misc.Nexport.Group.Product.Redemption.PurchasedInStore").Text,
            Width = "100"
        },
        new(nameof(NexportGroupProductRedemptionModel.PurchasedByCustomerEmail))
        {
            Title = T("Plugins.Misc.Nexport.Group.Product.Redemption.PurchasedBy").Text,
            Width = "300",
            Render = new RenderCustom("renderPurchasedByCustomerDetails"),
        },
        new(nameof(NexportGroupProductRedemptionModel.DatePurchased))
        {
            Title = T("Plugins.Misc.Nexport.Group.Product.Redemption.DatePurchased").Text,
            Render = new RenderDate(),
            Width = "100"
        },
        new(nameof(NexportGroupProductRedemptionModel.DateRedeemed))
        {
            Title = T("Plugins.Misc.Nexport.Group.Product.Redemption.DateAssigned").Text,
            Render = new RenderDate { Format = "MM/DD/YYYY h:mm:ss a" },
            Width = "100",
            AutoWidth = false
        },
        new(nameof(NexportGroupProductRedemptionModel.Id))
        {
            Render = new RenderCustom("renderModifyGroupProductRedemptions"),
            ClassName = NopColumnClassDefaults.Button,
            Width = "150",
            AutoWidth = false
        },
        new(nameof(NexportGroupProductRedemptionModel.Id))
        {
            Render = new RenderCustom("renderRefundRedemption"),
            ClassName = NopColumnClassDefaults.Button,
            Width = "150",
            AutoWidth = false
        }
    };

    if (hasAdminRole)
    {
        redemptionsColumns.Add(new ColumnProperty(nameof(NexportGroupProductRedemptionModel.InvoiceItemId))
        {
            Render = new RenderCustom("renderViewRedemptionAuditLog"),
            ClassName = NopColumnClassDefaults.Button,
            Width = "75",
            AutoWidth = false
        });
    }

    var redemptionsTable = new DataTablesModel
    {
        Name = "group-product-redemptions-grid",
        UrlRead = new DataUrl("GetNexportWholesalePurchasesByFundingPoolsRedemptions", "NexportWholesale",
            new RouteValueDictionary
            {
                [nameof(Model.FundingPoolId)] = Model.FundingPoolId
            }),
        SearchButtonId = "search-product-redemptions",
        Length = Model.PageSize,
        LengthMenu = Model.AvailablePageSizes,
        Filters = new List<FilterParameter>
        {
            new(nameof(Model.SearchCustomerName)),
            new(nameof(Model.SearchCustomerEmail)),
            new(nameof(Model.SearchProductName)),
            new(nameof(Model.SearchStatusId)),
            new(nameof(Model.DateAssignedFrom)),
            new(nameof(Model.DateAssignedTo)),
        },
        ColumnCollection = redemptionsColumns
    };
}
<div class="content-header clearfix nex-plugin">
    <h1 class="float-left">
        @(headerText)
        <small>
            <i class="fas fa-arrow-circle-left"></i>
            <a href="@(backBtnUrl)">back to purchases list</a>
        </small>
    </h1>
</div>

<section class="content">
    <div class="container-fluid">
        <div class="form-horizontal">
            <div class="cards-group">
                <div class="card card-default card-search">
                    <div class="card-body">
                        <div class="row search-row @(!hideSearchBlock ? "opened" : "")" data-hideAttribute="@hideSearchBlockAttributeName">
                            <div class="search-text">@T("Admin.Common.Search")</div>
                            <div class="icon-search"><i class="fas fa-search" aria-hidden="true"></i></div>
                            <div class="icon-collapse"><i class="far fa-angle-@(!hideSearchBlock ? "up" : "down")" aria-hidden="true"></i></div>
                        </div>

                        <div class="search-body @(hideSearchBlock ? "closed" : "")">
                            <div class="row">
                                <div class="col-md-5">
                                    <div class="form-group row">
                                        <div class="col-md-4">
                                            <nop-label asp-for="SearchCustomerName" />
                                        </div>
                                        <div class="col-md-8">
                                            <nop-editor asp-for="SearchCustomerName" />
                                        </div>
                                    </div>
                                    <div class="form-group row">
                                        <div class="col-md-4">
                                            <nop-label asp-for="SearchCustomerEmail" />
                                        </div>
                                        <div class="col-md-8">
                                            <nop-editor asp-for="SearchCustomerEmail" />
                                        </div>
                                    </div>
                                    <div class="form-group row">
                                        <div class="col-md-4">
                                            <nop-label asp-for="SearchProductName" />
                                        </div>
                                        <div class="col-md-8">
                                            <nop-editor asp-for="SearchProductName" />
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-7">
                                    <div class="form-group row">
                                        <div class="col-md-4">
                                            <nop-label asp-for="SearchStatusId" />
                                        </div>
                                        <div class="col-md-8">
                                            <nop-select asp-for="SearchStatusId" asp-items="Model.AvailableStatuses" />
                                        </div>
                                    </div>
                                    <div class="form-group row">
                                        <div class="col-md-4">
                                            <nop-label asp-for="DateAssignedFrom" />
                                        </div>
                                        <div class="col-md-8">
                                            <nop-editor asp-for="DateAssignedFrom" />
                                        </div>
                                    </div>
                                    <div class="form-group row">
                                        <div class="col-md-4">
                                            <nop-label asp-for="DateAssignedTo" />
                                        </div>
                                        <div class="col-md-8">
                                            <nop-editor asp-for="DateAssignedTo" />
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="form-group row">
                                <div class="text-center col-12">
                                    <button type="button" id="search-product-redemptions" class="btn btn-primary btn-search"><i class="fas fa-search"></i>@T("Admin.Common.Search")</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card card-default">
                    <div class="card-body">
                        <div style="font-weight: 600; margin-bottom: 5px; text-align: right">
                            Assignments Available:
                            <span style="margin-left: 7px; margin-right: 12px;" id="redemptionsAvailable">
                            </span>
                        </div>
                        @await Html.PartialAsync("~/Plugins/Misc.Nexport/Views/Shared/Table.cshtml", redemptionsTable)
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@await Html.PartialAsync("~/Plugins/Misc.Nexport/Views/Shared/_ProductRedemptionsCustomRenders.cshtml", new ViewDataDictionary(ViewData) {{ "HasAdminRole", hasAdminRole }, { "AdminView", true }})

<script>
    function assignRedemption(invoiceItemId, productId) {
        var url = "@Url.Action("RedeemProduct", "NexportWholesale")";
        url += "?InvoiceItemId=" + invoiceItemId + "&ProductId=" + productId;

        window.location.href = url;
    }

    function updateAvailableRedemptions() {
         var redemptionData = {
            fundingPoolId: "@Model.FundingPoolId"
        };

        addAntiForgeryToken(redemptionData);

        $.ajax({
            url: "@Url.Action("GetAvailableNexportProductRedemptionsByFundingPoolCount", "NexportWholesale")",
            type: "POST",
            data: redemptionData,
            success: function (data) {
                if (data.result != null) {
                    $("#redemptionsAvailable").html(data.result);
                }
            },
            error: function (error) {
                console.log(`Error ${error}`);
            }
        });
    }

    $(document).ready(function () {
        updateAvailableRedemptions();

        $(document).on("click", ".data-tables-refresh :button", function(e) {
            updateAvailableRedemptions();
        });
    });

</script>