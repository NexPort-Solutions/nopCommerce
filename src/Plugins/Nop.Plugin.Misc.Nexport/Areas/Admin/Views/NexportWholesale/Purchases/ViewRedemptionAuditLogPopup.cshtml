@using Nop.Plugin.Misc.Nexport.Areas.Admin.Models.NexportWholesale.WholesalePurchases
@using Nop.Plugin.Misc.Nexport.Domain.Enums
@using Nop.Plugin.Misc.Nexport.Extensions
@using Nop.Plugin.Misc.Nexport.Models

@model Nop.Plugin.Misc.Nexport.Areas.Admin.Models.NexportWholesale.WholesalePurchases.NexportRedemptionAuditLogListSearchModel

@{
    Layout = "_AdminPopupLayout";

    ViewBag.PageTitle = "Redemption Audit Log";

    const string hideSearchNexportRedemptionAuditLogBlockAttributeName = "NexportGroupsPage.RedemptionAuditLog.HideSearchNexportRedemptionAuditLogBlock";
    var hideSearchNexportRedemptionAuditLogBlock = await genericAttributeService.GetAttributeAsync<bool>(await workContext.GetCurrentCustomerAsync(), hideSearchNexportRedemptionAuditLogBlockAttributeName);
}

<form asp-controller="NexportWholesale" asp-action="RedemptionAuditLogList" method="post">
    <div class="content-header clearfix">
        <h1 class="float-left">
            Redemption Audit Log
        </h1>
    </div>
    <section class="content">
        <div class="container-fluid">
            <div class="form-horizontal">
                <div class="cards-group">
                    <div class="card card-default card-search">
                        <div class="card-body">
                            <div class="row search-row @(!hideSearchNexportRedemptionAuditLogBlock ? "opened" : "")" data-hideAttribute="@hideSearchNexportRedemptionAuditLogBlockAttributeName">
                                <div class="search-text">@T("Admin.Common.Search")</div>
                                <div class="icon-search"><i class="fas fa-search" aria-hidden="true"></i></div>
                                <div class="icon-collapse"><i class="far fa-angle-@(!hideSearchNexportRedemptionAuditLogBlock ? "up" : "down")" aria-hidden="true"></i></div>
                            </div>
                            <div class="search-body @(hideSearchNexportRedemptionAuditLogBlock ? "closed" : "")">
                                <div class="row">
                                    <div class="col-md-5">
                                        <div class="form-group row">
                                            <div class="col-md-4">
                                                <nop-label asp-for="SearchCustomerName" />
                                            </div>
                                            <div class="col-md-8">
                                                <nop-editor asp-for="SearchCustomerName" />
                                            </div>
                                        </div>
                                        <div class="form-group row">
                                            <div class="col-md-4">
                                                <nop-label asp-for="SearchTargetedCustomerName" />
                                            </div>
                                            <div class="col-md-8">
                                                <nop-editor asp-for="SearchTargetedCustomerName" />
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-7">
                                        <div class="form-group row">
                                            <div class="col-md-4">
                                                <nop-label asp-for="SearchAuditLogType" />
                                            </div>
                                            <div class="col-md-8">
                                                <nop-select asp-for="SearchAuditLogType" asp-items="Model.AvailableAuditLogType" />
                                            </div>
                                        </div>
                                        <div class="form-group row">
                                            <div class="col-md-4">
                                                <nop-label asp-for="DateCreatedFrom" />
                                            </div>
                                            <div class="col-md-8">
                                                <nop-editor asp-for="DateCreatedFrom" asp-render-form-control-class="true" />
                                            </div>
                                        </div>
                                        <div class="form-group row">
                                            <div class="col-md-4">
                                                <nop-label asp-for="DateCreatedTo" />
                                            </div>
                                            <div class="col-md-8">
                                                <nop-editor asp-for="DateCreatedTo" asp-render-form-control-class="true" />
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="text-center col-12">
                                        <button type="button" id="search-audit-log" class="btn btn-primary btn-search"><i class="fas fa-search"></i>@T("Admin.Common.Search")</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="card card-default">
                        <div class="card-body">
                            @await Html.PartialAsync("~/Plugins/Misc.Nexport/Views/Shared/Table.cshtml", new NexportDataTablesModel
                            {
                                Name = "nexport-redemption-audit-log-grid",
                                UrlRead = new DataUrl("GetRedemptionAuditLog", "NexportWholesale",
                                    new RouteValueDictionary
                                    {
                                        [nameof(Model.InvoiceItemId)] = Model.InvoiceItemId
                                    }),
                                SearchButtonId = "search-audit-log",
                                Length = Model.PageSize,
                                LengthMenu = Model.AvailablePageSizes,
                                Filters = new List<FilterParameter>
                                {
                                    new(nameof(Model.SearchCustomerName)),
                                    new(nameof(Model.SearchTargetedCustomerName)),
                                    new(nameof(Model.SearchAuditLogType)),
                                    new(nameof(Model.DateCreatedFrom)),
                                    new(nameof(Model.DateCreatedTo))
                                },
                                ColumnCollection = new List<ColumnProperty>
                                {
                                    new(nameof(NexportRedemptionAuditLogModel.CustomerDetails))
                                    {
                                        Title = "User",
                                        Width = "100"
                                    },
                                    new(nameof(NexportRedemptionAuditLogModel.TargetedCustomerDetails))
                                    {
                                        Title = "Target User",
                                        Width = "100"
                                    },
                                    new(nameof(NexportRedemptionAuditLogModel.Description))
                                    {
                                        Title = "Description",
                                        Width = "300"
                                    },
                                    new(nameof(NexportRedemptionAuditLogModel.Type))
                                    {
                                        Title = "Type",
                                        Width = "150"
                                    },
                                    new(nameof(NexportRedemptionAuditLogModel.DateCreated))
                                    {
                                        Title = "Date",
                                        Width = "150",
                                        Render = new RenderDate()
                                    }
                                }
                            })
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</form>