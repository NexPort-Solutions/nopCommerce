@using NexportApi.Model
@using Nop.Plugin.Misc.Nexport.Domain.Enums
@using Nop.Plugin.Misc.Nexport.Models.NexportWholesale.WholesalePurchases

@model Nop.Plugin.Misc.Nexport.Areas.Admin.Models.NexportWholesale.WholesalePurchases.NexportRedemptionAssignmentApprovalRequestListSearchModel

@inject IWorkContext workContext

@{
    ViewBag.PageTitle = T("Plugins.Misc.Nexport.Wholesale.RedemptionAssignmentApprovalRequests").Text;

    NopHtml.SetActiveMenuItemSystemName("Assignment Approval Requests");

    var currentCustomer = await workContext.GetCurrentCustomerAsync();

    const string hideSearchBlockAttributeName = "AssignmentApprovalRequestsPage.HideSearchBlock";
    var hideSearchBlock = await genericAttributeService.GetAttributeAsync<bool>(currentCustomer, hideSearchBlockAttributeName);
}

<nop-antiforgery-token />
<div class="content-header clearfix">
    <h1 class="float-left">
        @T("Plugins.Misc.Nexport.Wholesale.RedemptionAssignmentApprovalRequests")
    </h1>
</div>
<div class="content">
    <div class="form-horizontal">
        <div class="cards-group">
            <div class="card card-default card-search">
                <div class="card-body">
                    <div class="row search-row @(!hideSearchBlock ? "opened" : "")" data-hideAttribute="@hideSearchBlockAttributeName">
                        <div class="search-text">@T("Admin.Common.Search")</div>
                        <div class="icon-search"><i class="fas fa-search" aria-hidden="true"></i></div>
                        <div class="icon-collapse"><i class="far fa-angle-@(!hideSearchBlock ? "up" : "down")" aria-hidden="true"></i></div>
                    </div>
                    <div class="search-body @(hideSearchBlock ? "closed" : "")">
                        <div class="row">
                            <div class="col-md-5">
                                <div class="form-group row">
                                    <div class="col-md-4">
                                        <nop-label asp-for="StartDate" />
                                    </div>
                                    <div class="col-md-8">
                                        <nop-editor asp-for="StartDate" />
                                    </div>
                                </div>
                                <div class="form-group row">
                                    <div class="col-md-4">
                                        <nop-label asp-for="EndDate" />
                                    </div>
                                    <div class="col-md-8">
                                        <nop-editor asp-for="EndDate" />
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-7">
                                <div class="form-group row">
                                    <div class="col-md-4">
                                        <nop-label asp-for="RequestStatusId" />
                                    </div>
                                    <div class="col-md-8">
                                        <nop-select asp-for="RequestStatusId" asp-items="Model.RequestStatusList" />
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-7 offset-md-5">
                                <button type="button" id="search-assignment-approval-requests" class="btn btn-primary btn-search">
                                    <i class="fas fa-search"></i>
                                    @T("Admin.Common.Search")
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="card card-default">
                <div class="card-body">
                    <p>
                        @T("Plugins.Misc.Nexport.Wholesale.RedemptionAssignmentApprovalRequests.Description")
                    </p>
                    @await Html.PartialAsync("Table", new DataTablesModel
                    {
                        Name = "approval-requests-grid",
                        UrlRead = new DataUrl("AssignmentApprovalRequestsList", "NexportWholesale", null),
                        SearchButtonId = "search-assignment-approval-requests",
                        Length = Model.PageSize,
                        LengthMenu = Model.AvailablePageSizes,
                        Filters = new List<FilterParameter>
                        {
                            new(nameof(Model.StartDate)),
                            new(nameof(Model.EndDate)),
                            new(nameof(Model.RequestStatusId))
                        },
                        ColumnCollection = new List<ColumnProperty>
                        {
                            new(nameof(NexportRedemptionAssignmentApprovalRequestModel.Id))
                            {
                                Title = "Id",
                                Width = "50",
                            },
                            new(nameof(NexportRedemptionAssignmentApprovalRequestModel.InvoiceItemId))
                            {
                                Title = "Nexport Invoice Item",
                                Width = "300",
                            },
                            new(nameof(NexportRedemptionAssignmentApprovalRequestModel.RedemptionCustomerInfo))
                            {
                                Title = T("Plugins.Misc.Nexport.Wholesale.RedemptionAssignmentApprovalRequests.Fields.Customer").Text,
                                Width = "300",
                                Render = new RenderCustom("renderRequestByCustomerInfo")
                            },
                            new(nameof(NexportRedemptionAssignmentApprovalRequestModel.RedemptionCustomerInfo))
                            {
                                Title = T("Plugins.Misc.Nexport.Wholesale.RedemptionAssignmentApprovalRequests.Fields.RedeemingCustomer").Text,
                                Width = "300",
                                Render = new RenderCustom("renderRedeemingCustomerInfo")
                            },
                            new(nameof(NexportRedemptionAssignmentApprovalRequestModel.Status))
                            {
                                Title = T("Plugins.Misc.Nexport.Wholesale.RedemptionAssignmentApprovalRequests.Fields.RequestStatus").Text,
                                Width = "100",
                                Render = new RenderCustom("renderStatusInfo")
                            },
                            new(nameof(NexportRedemptionAssignmentApprovalRequestModel.UtcCreatedDate))
                            {
                                Title = T("Plugins.Misc.Nexport.Wholesale.RedemptionAssignmentApprovalRequests.Fields.UtcCreatedDate").Text,
                                Width = "150",
                                Render = new RenderDate()
                            },
                            new(nameof(NexportRedemptionAssignmentApprovalRequestModel.UtcModifiedDate))
                            {
                                Title = T("Plugins.Misc.Nexport.Wholesale.RedemptionAssignmentApprovalRequests.Fields.UtcModifiedDate").Text,
                                Width = "150",
                                Render = new RenderDate()
                            },
                            new(nameof(NexportRedemptionAssignmentApprovalRequestModel.ExtensionOption))
                            {
                                Title = T("Plugins.Misc.Nexport.Wholesale.RedemptionAssignmentApprovalRequests.Fields.ExtensionOption").Text,
                                Width = "100",
                                Render = new RenderCustom("renderRedemptionAction")
                            },
                            new(nameof(NexportRedemptionAssignmentApprovalRequestModel.Id))
                            {
                                Title = T("Admin.Common.Edit").Text,
                                Width = "100",
                                ClassName =  NopColumnClassDefaults.Button,
                                Render = new RenderButtonEdit(new DataUrl("Edit"))
                            }
                        }
                    })

                    <script>
                        function renderRequestByCustomerInfo(data, type, row, meta) {
                            var textRenderer = $.fn.dataTable.render.text().display;
                            return "<a href=\"@Url.Content("~/Admin/Customer/Edit/")" + row.RequestedByCustomerId + "\">" +
                                textRenderer(row.RequestedByCustomerInfo) + "</a>";
                        }

                        function renderRedeemingCustomerInfo(data, type, row, meta) {
                            var textRenderer = $.fn.dataTable.render.text().display;
                            if (row.RedemptionCustomerId)
                            {
                                return "<a href=\"@Url.Content("~/Admin/Customer/Edit/")" + row.RedemptionCustomerId + "\">" +
                                textRenderer(row.RedemptionCustomerInfo) + "</a>";
                            }

                            return textRenderer(row.RedemptionCustomerInfo);
                        }

                        function renderStatusInfo(data, type, row, meta) {
                            if (data === +"@((int)NexportRedemptionAssignmentApprovalRequestStatus.Accepted)") {
                                return "Accepted";
                            } else if (data === +"@((int)NexportRedemptionAssignmentApprovalRequestStatus.Received)") {
                                return "Received";
                            } else if (data === +"@((int)NexportRedemptionAssignmentApprovalRequestStatus.Rejected)") {
                                return "Rejected";
                            }

                            return "N/A";
                        }

                        function renderRedemptionAction(data, type, row, meta) {
                            if (data === +"@((int)RedeemInvoiceItemRequest.RedemptionActionTypeEnum.RestartEnrollment)") {
                                return "Restart enrollment";
                            } else if (data === +"@((int)RedeemInvoiceItemRequest.RedemptionActionTypeEnum.RenewRedemption)") {
                                return "Renew enrollment";
                            } else if (data === +"@((int)RedeemInvoiceItemRequest.RedemptionActionTypeEnum.DeleteFinishedEnrollment)") {
                                return "Delete finished enrollment";
                            }

                            return "";
                        }
                    </script>
                </div>
            </div>
        </div>
    </div>
</div>