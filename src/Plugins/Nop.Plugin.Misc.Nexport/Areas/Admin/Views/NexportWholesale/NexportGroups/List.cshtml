@{
    var path = ViewData["PathForPartialView"] as string;
    var model = ViewData["ModelForPartialView"];
    NopHtml.AddScriptParts(ResourceLocation.Footer, "~/Plugins/Misc.Nexport/Scripts/uikit.min.js", "", true);
    NopHtml.AddCssFileParts("~/Plugins/Misc.Nexport/Content/jquery.dataTables.min.css");
    NopHtml.AddCssFileParts("~/Plugins/Misc.Nexport/Content/uikit.min.css");
    NopHtml.AddScriptParts(ResourceLocation.Footer, "https://kit.fontawesome.com/e4adf0b7ea.js", "", true);
    NopHtml.AddScriptParts(ResourceLocation.Footer, "~/lib_npm/datatables.net/js/jquery.dataTables.min.js");
}

<style>
    .nex-plugin .uk-table {
        border-collapse: collapse !important;
    }

    .content-wrapper {
        background-color: white;
    }

    div.dataTables_wrapper div.dataTables_length select {
        width:60px
    }

    .dataTables_wrapper thead {
        background-color: white;
    }
    body {
        font: normal 14px Arial, Helvetica, sans-serif;
    }

    .page {
        color: #777;
    }

    .page-title {
        text-align: center;
    }
    .page-title {
        margin: 0 0 25px;
        border-bottom: 1px solid #ddd;
        padding: 6px 10px;
    }
</style>
<div class="container">
    <div class="page account-page nex-plugin">
        @await Html.PartialAsync(path, model)
    </div>
</div>