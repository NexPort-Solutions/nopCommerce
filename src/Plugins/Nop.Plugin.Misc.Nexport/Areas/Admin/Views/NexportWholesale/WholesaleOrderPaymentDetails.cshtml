@model Nop.Plugin.Misc.Nexport.Areas.Admin.Models.Orders.WholesaleOrderPaymentInfoModel

@if(Model is { PaymentViewComponent: not null })
{
    <div class="checkout-data">
        <div class="section payment-info">
            <div class="info">
                @await Component.InvokeAsync(Model.PaymentViewComponent)
            </div>
        </div>
    </div>
}