@using Nop.Plugin.Misc.Nexport.Areas.Admin.Controllers
@using Nop.Plugin.Misc.Nexport.Domain
@using Nop.Plugin.Misc.Nexport.Extensions
@using Nop.Plugin.Misc.Nexport.Services
@using Nop.Services.Common
@using Nop.Plugin.Misc.Nexport.Models
@using Nop.Plugin.Misc.Nexport.Areas.Admin.Models.FundingPool

@model FundingPoolModel

@{
    ViewBag.PageTitle = T("Plugins.Misc.Nexport.FundingPool.Edit").Text;
    NopHtml.SetActiveMenuItemSystemName("Nexport");
}

<form asp-controller="@(ViewUtilities.GetControllerName<FundingPoolController>())"
      asp-action="@nameof(FundingPoolController.Save)"
    method="post"
    id="fundingpool-form">
    <div class="content-header clearfix">
        <h1 class="float-left">
            @T("Plugins.Misc.Nexport.FundingPool.Edit") - @Model.Name
            <small>
                <i class="fas fa-arrow-circle-left"></i>
                <a asp-action="@nameof(FundingPoolController.List)" asp-controller="@(ViewUtilities.GetControllerName<FundingPoolController>())">
                    @T("Plugins.Misc.Nexport.FundingPool.BackToList")
                </a>
            </small>
        </h1>
        <div class="float-right">
            <button type="submit" name="save" class="btn btn-primary">
                <i class="far fa-save"></i>
                @T("Admin.Common.Save")
            </button>
            <button type="submit" name="save-continue" class="btn btn-primary">
                <i class="far fa-save"></i>
                @T("Admin.Common.SaveContinue")
            </button>
            <span id="fundingpool-delete" name="delete" class="btn bg-red">
                <i class="fa fa-trash-o"></i>
                @T("Admin.Common.Delete")
            </span>
        </div>
    </div>
    @await Html.PartialAsync("~/Plugins/Misc.Nexport/Areas/Admin/Views/FundingPool/_CreateOrUpdate.cshtml", Model))
</form>
<nop-delete-confirmation asp-model-id="@Model.Id" asp-button-id="fundingpool-delete"
                         asp-controller="@(ViewUtilities.GetControllerName<FundingPoolController>())" asp-action="@nameof(FundingPoolController.Delete)" />