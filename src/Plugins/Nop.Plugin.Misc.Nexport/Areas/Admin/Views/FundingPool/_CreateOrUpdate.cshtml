@using Nop.Plugin.Misc.Nexport.Areas.Admin.Controllers
@using Nop.Plugin.Misc.Nexport.Areas.Admin.Models.FundingPool
@using Nop.Plugin.Misc.Nexport.Areas.Admin.Models.Orders
@using Nop.Plugin.Misc.Nexport.Extensions

@model FundingPoolModel

<div asp-validation-summary="All"></div>
<input asp-for="Id" type="hidden" />

<div class="content">
    <div class="form-horizontal">
        <div class="card-group">
            <div class="card card-default">
                <div class="card-body">
                    <div class="form-group row">
                        <div class="col-md-4">
                            <nop-label asp-for="Name"></nop-label>
                        </div>
                        <div class="col-md-8">
                            @Html.TextBoxFor(model => model.Name)
                        </div>
                    </div>
                    <div class="form-group row">
                        <div class="col-md-4">
                            <nop-label asp-for="Code"></nop-label>
                        </div>
                        <div class="col-md-8">
                            @Html.TextBoxFor(model => model.Code)
                        </div>
                    </div>
                    <div class="form-group row">
                        <div class="col-md-4">
                            <nop-label asp-for="Description"></nop-label>
                        </div>
                        <div class="col-md-8">
                            @Html.TextBoxFor(model => model.Description)
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
