@using Nop.Services.Stores
@model CustomerModel
@inject IStoreService StoreService

@{
    var stores = await StoreService.GetAllStoresAsync();
    var storeItems = stores.Select(store => new SelectListItem(store.Name, store.Id.ToString())).ToList();
}

<div class="card-body">
    <ul class="common-list">
        <li>@T("Admin.Customers.Customers.Impersonate.Description1")</li>
        <li>@T("Admin.Customers.Customers.Impersonate.Description2")</li>
    </ul>
    <div class="select2-blue mb-2">
        <select name="storeId" id="storeId" asp-items="@storeItems" class="form-control select2" style="width: 100%;" data-dropdown-css-class="select2-blue"></select>
    </div>
    <script>
        $(function() {
            $("#storeId").select2();
        });
    </script>

    <button type="submit" name="impersonate" class="btn btn-primary">
        <i class="fas fa-shopping-cart"></i>
        @T("Admin.Customers.Customers.Impersonate.Button")
    </button>
</div>