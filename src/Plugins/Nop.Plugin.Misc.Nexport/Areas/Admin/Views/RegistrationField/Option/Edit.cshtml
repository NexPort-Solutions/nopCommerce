@using Nop.Plugin.Misc.Nexport.Areas.Admin.Controllers;
@using Nop.Plugin.Misc.Nexport.Extensions;

@model Nop.Plugin.Misc.Nexport.Models.RegistrationField.OptionModel

@{
    Layout = "_AdminPopupLayout";
    ViewBag.PageTitle = T("Admin.Customers.Nexport.RegistrationField.Options.EditOptionValueDetails").Text;
}

<form asp-controller="RegistrationField" asp-action="EditOption"
      asp-route-btnId="@Context.Request.Query["btnId"]"
      asp-route-formId="@Context.Request.Query["formId"]">
    <div class="content-header clearfix">
        <h1 class="float-left">
            @T("Admin.Customers.Nexport.RegistrationField.Options.EditOptionValueDetails")
        </h1>
        <div class="float-right">
            <button type="submit" name="save" class="btn btn-primary">
                <i class="far fa-save"></i>
                @T("Admin.Common.Save")
            </button>
        </div>
    </div>
    @await Html.PartialAsync("~/Plugins/Misc.Nexport/Areas/Admin/Views/RegistrationField/Option/_CreateOrUpdate.cshtml", Model)
</form>