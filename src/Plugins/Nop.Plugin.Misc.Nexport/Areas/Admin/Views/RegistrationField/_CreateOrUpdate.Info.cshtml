@using Nop.Plugin.Misc.Nexport.Domain.Enums
@using Nop.Plugin.Misc.Nexport.Domain.RegistrationField
@using Nop.Plugin.Misc.Nexport.Extensions
@using Nop.Plugin.Misc.Nexport.Models.RegistrationField
@using Nop.Services
@using System.Globalization
@using static Nop.Plugin.Misc.Nexport.Domain.RegistrationField.RegistrationField

@model Nop.Plugin.Misc.Nexport.Models.RegistrationField.RegistrationFieldModel

<script>
    $(document).ready(function() {
        $("#@Html.IdFor(model => model.Type)").change(toggleControlType);
        toggleControlType();

        $("#@Html.IdFor(model => model.Validation)").click(toggleValidation);
        toggleValidation();
    });

    function toggleControlType() {
        var selectedAttributeControlTypeId = +$("#@Html.IdFor(model => model.Type)").val();

        if (selectedAttributeControlTypeId === @(((int) RegistrationFieldType.SelectCheckbox).ToString(CultureInfo.InvariantCulture)) ||
            selectedAttributeControlTypeId === @(((int) RegistrationFieldType.SelectDropDown).ToString(CultureInfo.InvariantCulture))) {
            if (selectedAttributeControlTypeId === @(((int) RegistrationFieldType.SelectCheckbox).ToString(CultureInfo.InvariantCulture))) {
                $("#allowMultipleSelectionSettingContainer").show();
            } else {
                $("#allowMultipleSelectionSettingContainer").hide();
            }

            $("#displayOptionByAscendingOrderSettingContainer").show();
            $("#registrationfield-options").show(50, function(){
                $("#registrationfield-options-grid").DataTable().columns.adjust();
            });
        } else {
            $("#allowMultipleSelectionSettingContainer").hide();
            $("#displayOptionByAscendingOrderSettingContainer").hide();
            $("#registrationfield-options").hide();
        }

        if (selectedAttributeControlTypeId === @(((int) RegistrationFieldType.CustomType).ToString(CultureInfo.InvariantCulture))) {
            $("#@Html.IdFor(model => model.CustomProfileFieldKey)").val("");
            $("#nexportCustomProfileFieldKeySettingContainer").hide();

            $("#registrationfield-custom").show();
        } else{
            $("#registrationfield-custom").hide();
            $("#nexportCustomProfileFieldKeySettingContainer").show();
        }
    }

    function toggleValidation() {
        if ($("#@Html.IdFor(model => model.Validation)").is(":checked")) {
            $("#validationRegexSettingContainer").show();
            $("#validationMessageSettingContainer").show();
        } else {
            $("#@Html.IdFor(model => model.ValidationRegex)").val("");
            $("#validationRegexSettingContainer").hide();
            $("#validationMessageSettingContainer").hide();
        }
    }
</script>

<div class="card-body">
    @(await Html.LocalizedEditorAsync<RegistrationFieldModel, RegistrationFieldLocalizedModel>("registrationfield-localized",
    @<div>
        <div class="form-group row">
            <div class="col-md-3">
                <nop-label asp-for="@Model.Locales[item].Name"/>
            </div>
            <div class="col-md-9">
                <nop-editor asp-for="@Model.Locales[item].Name"/>
                <span asp-validation-for="@Model.Locales[item].Name"></span>
            </div>
        </div>
         <input type="hidden" asp-for="@Model.Locales[item].LanguageId" />
    </div>
,
    @<div>
            <div class="form-group row">
            <div class="col-md-3">
                <nop-label asp-for="Model.Name" />
            </div>
            <div class="col-md-9">
                <nop-editor asp-for="Model.Name)" asp-required="true" />
                <span asp-validation-for="Model.Name)"></span>
            </div>
        </div>
    </div>
))
    <div class="form-group row">
        <div class="col-md-3">
            <nop-label asp-for="Model.IsRequired" />
        </div>
        <div class="col-md-9">
            <nop-editor asp-for="Model.IsRequired" />
            <span asp-validation-for="Model.IsRequired)"></span>
        </div>
    </div>
    <div class="form-group row">
        <div class="col-md-3">
            <nop-label asp-for="Model.IsActive" />
        </div>
        <div class="col-md-9">
            <nop-editor asp-for="Model.IsActive" />
            <span asp-validation-for="Model.IsActive)"></span>
        </div>
    </div>
    <div class="form-group row">
        <div class="col-md-3">
            <nop-label asp-for="Model.Type" />
        </div>
        <div class="col-md-9">
            @{
                var fieldTypes = Model.Type.ToSelectList(valuesToExclude: new[]
                {
                    (int)RegistrationFieldType.None
                });
            }
            <nop-select asp-for="Model.Type)" asp-items="@fieldTypes" />
            <span asp-validation-for="Model.Type)"></span>
        </div>
    </div>
    <div class="form-group row" id="nexportCustomProfileFieldKeySettingContainer">
        <div class="col-md-3">
            <nop-label asp-for="Model.CustomProfileFieldKey" />
        </div>
        <div class="col-md-9">
            <nop-editor asp-for="Model.CustomProfileFieldKey" />
            <span asp-validation-for="Model.CustomProfileFieldKey)"></span>
        </div>
    </div>
    <div class="form-group row">
        <div class="col-md-3">
            <nop-label asp-for="Model.FieldCategoryId" />
        </div>
        <div class="col-md-9">
            <nop-select asp-for="Model.FieldCategoryId)" asp-items="@Model.AvailableFieldCategory" />
            <span asp-validation-for="Model.FieldCategoryId)"></span>
        </div>
    </div>
    <div class="form-group row">
        <div class="col-md-3">
            <nop-label asp-for="Model.Validation" />
        </div>
        <div class="col-md-9">
            <nop-editor asp-for="Model.Validation" />
            <span asp-validation-for="Model.Validation)"></span>
        </div>
    </div>
    <nop-nested-setting asp-for="Model.Validation)">
        <div class="form-group row" id="validationRegexSettingContainer">
            <div class="col-md-3">
                <nop-label asp-for="Model.ValidationRegex" />
            </div>
            <div class="col-md-9">
                <nop-editor asp-for="Model.ValidationRegex" />
                <span asp-validation-for="Model.ValidationRegex)"></span>
            </div>
        </div>
        <div class="form-group row" id="validationMessageSettingContainer">
            <div class="col-md-3">
                <nop-label asp-for="Model.ValidationMessage" />
            </div>
            <div class="col-md-9">
                <nop-editor asp-for="Model.ValidationMessage" />
                <span asp-validation-for="Model.ValidationMessage)"></span>
            </div>
        </div>
    </nop-nested-setting>
    <div class="form-group row">
        <div class="col-md-3">
            <nop-label asp-for="Model.StoreMappingIds" />
        </div>
        <div class="col-md-9">
            <nop-select asp-for="Model.StoreMappingIds)" asp-items="@Model.AvailableStores" asp-multiple="true" />
            <span asp-validation-for="Model.StoreMappingIds)"></span>
        </div>
    </div>
    <div class="form-group row">
        <div class="col-md-3">
            <nop-label asp-for="Model.DisplayOrder" />
        </div>
        <div class="col-md-9">
            <nop-editor asp-for="Model.DisplayOrder" />
            <span asp-validation-for="Model.DisplayOrder)"></span>
        </div>
    </div>
</div>
