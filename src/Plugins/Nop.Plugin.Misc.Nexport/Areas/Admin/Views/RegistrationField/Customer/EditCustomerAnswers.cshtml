@using Nop.Plugin.Misc.Nexport.Controllers;
@using Nop.Plugin.Misc.Nexport.Domain.Enums
@using Nop.Plugin.Misc.Nexport.Extensions;
@using Nop.Services.Helpers
@using static Nop.Plugin.Misc.Nexport.Domain.RegistrationField.RegistrationField;
@using Nop.Plugin.Misc.Nexport.Areas.Admin.Controllers;

@model Nop.Plugin.Misc.Nexport.Models.RegistrationField.Customer.EditCustomerAnswersModel

@inject IUserAgentHelper userAgentHelper

@{
    Layout = "_AdminPopupLayout";
    ViewBag.PageTitle = "Edit customer registration field answers";
}

@if (ViewBag.RefreshPage == true)
{
    <script>
        try {
            window.opener.$("#@(Context.Request.Query["containerId"]) #@(Context.Request.Query["btnId"])").click();
        }
        catch (e) { }
    </script>
}

@if (ViewBag.ClosePage == true)
{
    <script>
        window.close();
    </script>
}

@if (Model.RegistrationField != null)
{
    var controlId = $"RegistrationFieldAnswer-{Model.RegistrationField.Id}";
    <form id="edit-customer-registration-fields-form" method="post"
          asp-action="EditCustomerAnswers"
          asp-controller="RegistrationField"
          asp-route-customerId="@Context.Request.Query["customerId"]"
          asp-route-fieldId="@Context.Request.Query["fieldId"]"
          asp-route-containerId="@Context.Request.Query["containerId"]"
          asp-route-btnId="@Context.Request.Query["btnId"]">
        <div class="content-header clearfix">
            <div class="float-right">
                <button type="submit" name="save" class="btn btn-primary">
                    <i class="far fa-save"></i>
                    @T("Admin.Common.Save")
                </button>
            </div>
        </div>
        <div class="content">
            <div class="form-horizontal">
                <div class="card-group">
                        <div class="card card-default card-popup">
                        <div class="card-body">
                            <div>
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="fieldId" value="@Model.RegistrationField.Id" />
                                <div>
                                    @if (Model.RegistrationField.Type is not RegistrationFieldType.CustomType)
                                    {
                                        <text>
                                            <div class="inputs custom-attributes">
                                                <div style="display: flex; align-items: center;">
                                                    @if (Model.RegistrationField.IsRequired)
                                                    {
                                                        if (Model.RegistrationField.Type is not RegistrationFieldType.DateOnly and not RegistrationFieldType.DateTime)
                                                        {
                                                            <nop-required />
                                                        }
                                                    }
                                                   <h3 style="margin-top: 0;"><label for="@(controlId)">@Model.RegistrationField.Name:</label></h3>
                                                </div>
                                                @switch (Model.RegistrationField.Type)
                                                {
                                                    case RegistrationFieldType.Text:
                                                        <input type="hidden" name="previousAnswers" value="@(Model.Answers.FirstOrDefault()?.Id)" />
                                                        <input name="answerValue" type="text" class="form-control text-box single-line" id="@(controlId)"
                                                               value="@Model.Answers.FirstOrDefault()?.TextValue" />
                                                        <script>
                                                            $(document).ready(function () {
                                                                $("#@(controlId)").rules("add", {
                                                                    "validate-pattern": {
                                                                        @if (Model.RegistrationField.IsRequired)
                                                                                {
                                                                                    <text>required: true,</text>
                                                                                }
                                                                        format: "@Model.RegistrationField.ValidationRegex"
                                                                    },
                                                                    messages: {
                                                                        "validate-pattern": "@(string.IsNullOrWhiteSpace(Model.RegistrationField.ValidationMessage)
                                                                                                 ? "Please input the correct format" : Model.RegistrationField.ValidationMessage)"
                                                                    }
                                                                });
                                                            });
                                                        </script>

                                                        break;
                                                    case RegistrationFieldType.Numeric:
                                                        <input type="hidden" name="previousAnswers" value="@(Model.Answers.FirstOrDefault()?.Id)" />
                                                        <input name="answerValue" type="number" class="form-control text-box single-line"
                                                               id="@(controlId)" value="@Model.Answers.FirstOrDefault()?.NumericValue" />

                                                        break;
                                                    case RegistrationFieldType.SelectCheckbox:
                                                    {
                                                        var options = Model.Options;
                                                        if (options.Count > 0)
                                                        {
                                                            var renderOptions = Model.RegistrationField.DisplayOptionByAscendingOrder
                                                                ? options.OrderBy(x => x.OptionValue).ToList()
                                                                : options;

                                                            <div class="option-list nexport-option-list">
                                                                @if (Model.RegistrationField.AllowMultipleSelection)
                                                                {
                                                                    <input type="hidden" name="allowMultipleSelection" value="@Json.Serialize(Model.RegistrationField.AllowMultipleSelection)" />

                                                                    @for (var i = 0; i < Model.Answers.Count; i++)
                                                                    {
                                                                        var answered = Model.Answers[i];
                                                                        <input type="hidden" name="previousAnswers" value="@answered.Id" />
                                                                        <input type="hidden" name="previousAnswerFieldOptions" value="@answered.FieldOptionId" />
                                                                    }

                                                                    foreach (var option in renderOptions)
                                                                    {
                                                                        var currentAnswer = Model.Answers.FirstOrDefault(x => x.FieldId == option.FieldId && x.FieldOptionId != null && x.FieldOptionId == option.Id);

                                                                        <div class="nexport-custom-attributes-option-list-item">
                                                                            <input id="@(controlId)_@(option.Id)" type="checkbox" name="answerFieldOptions" value="@option.Id" checked="@(currentAnswer != null)"/>
                                                                            <label for="@(controlId)_@(option.Id)">@option.OptionValue</label>
                                                                        </div>
                                                                    }
                                                                }
                                                                else
                                                                {
                                                                    <input type="hidden" name="previousAnswers" value="@(Model.Answers.FirstOrDefault()?.Id)" />
                                                                    foreach (var option in renderOptions)
                                                                    {
                                                                        <div class="nexport-custom-attributes-option-list-item">
                                                                            <input id="@(controlId)_@(option.Id)" type="radio" name="answerFieldOptions" value="@option.Id"
                                                                                checked="@(Model.Answers.FirstOrDefault()?.FieldOptionId != null && Model.Answers.FirstOrDefault()?.FieldOptionId == option.Id)"/>
                                                                            <label for="@(controlId)_@(option.Id)">@option.OptionValue</label>
                                                                        </div>
                                                                    }
                                                                }
                                                            </div>
                                                        }

                                                        break;
                                                    }
                                                    case RegistrationFieldType.SelectDropDown:
                                                    {
                                                        var options = Model.Options;
                                                        if (options.Count > 0)
                                                        {
                                                            var renderOptions = Model.RegistrationField.DisplayOptionByAscendingOrder
                                                                ? options.OrderBy(x => x.OptionValue).ToList()
                                                                : options;

                                                            <input type="hidden" name="previousAnswers" value="@(Model.Answers.FirstOrDefault()?.Id)" />
                                                            <select name="answerFieldOptions" id="@(controlId)" class="form-control">
                                                                @if (!Model.RegistrationField.IsRequired)
                                                                {
                                                                    <option value="0">---</option>
                                                                }
                                                                else
                                                                {
                                                                    <option value="0">Please select</option>
                                                                }

                                                                @foreach (var option in renderOptions)
                                                                {
                                                                    <option value="@option.Id"
                                                                        selected="@(Model.Answers.FirstOrDefault()?.FieldOptionId != null && Model.Answers.FirstOrDefault()?.FieldOptionId == option.Id)">
                                                                        @option.OptionValue
                                                                    </option>
                                                                }
                                                            </select>
                                                        }

                                                        break;
                                                    }
                                                    case RegistrationFieldType.Email:
                                                        <input type="hidden" name="previousAnswers" value="@(Model.Answers.FirstOrDefault()?.Id)" />
                                                        <input name="answerValue" type="email" class="form-control text-box single-line" id="@(controlId)" value="@Model.Answers.FirstOrDefault()?.TextValue" />
                                                        <script>
                                                            $(document).ready(function() {
                                                                $("#@(controlId)").rules("add",
                                                                    {
                                                                        email: true
                                                                    });
                                                            });
                                                        </script>

                                                        break;
                                                    case RegistrationFieldType.Boolean:
                                                        <input type="hidden" name="previousAnswers" value="@(Model.Answers.FirstOrDefault()?.Id)" />
                                                        <div class="option-list nexport-yes-no-field">
                                                            <span>
                                                                <input id="@(controlId)_Yes" type="radio" name="answerValue" value="True" checked="@(Model.Answers.FirstOrDefault()?.BooleanValue)" />
                                                                <label for="@(controlId)_Yes">Yes</label>
                                                            </span>
                                                            <span>
                                                                <input id="@(controlId)_No" type="radio" name="answerValue" value="False" checked="@(!Model.Answers.FirstOrDefault()?.BooleanValue)" />
                                                                <label for="@(controlId)_No">No</label>
                                                            </span>
                                                        </div>

                                                        break;
                                                    case RegistrationFieldType.DateOnly:
                                                    {
                                                        const string datePickerFormat = "MM/DD/YYYY";
                                                        var isMobileDevice = userAgentHelper.IsMobileDevice();

                                                        <input type="hidden" name="previousAnswers" value="@(Model.Answers.FirstOrDefault()?.Id)" />
                                                        <input id="@(controlId)" name="answerValue" type="text" class="datepicker"
                                                               value="@Model.Answers.FirstOrDefault()?.DateTimeValue"
                                                               @if (isMobileDevice)
                                                               {
                                                                   <text> readonly</text>
                                                               }/>
                                                        @if (Model.RegistrationField.IsRequired)
                                                        {
                                                            <nop-required/>
                                                        }
                                                        <span class="field-validation-error" data-valmsg-for="@(controlId)" data-valmsg-replace="true"></span>
                                                        <script>
                                                            $(document).ready(function() {
                                                                $("#@(controlId)").kendoDatePicker({ format: "mm/dd/yy" });
                                                                $("#@(controlId)").rules("add",
                                                                    {
                                                                        "validate-datetime": {
                                                                            @if (Model.RegistrationField.IsRequired)
                                                                            {
                                                                                <text>required: true,</text>
                                                                            }
                                                                            format: "@datePickerFormat"
                                                                        },
                                                                        messages: {
                                                                            "validate-datetime": "Please select the date value from the picker or input the valid format (MM/DD/YYYY)"
                                                                        }
                                                                    });
                                                            });
                                                        </script>
                                                        break;
                                                    }
                                                    case RegistrationFieldType.DateTime:
                                                    {
                                                        const string dateTimePickerFormat = "MM/DD/YYYY HH:mm";
                                                        var isMobileDevice = userAgentHelper.IsMobileDevice();

                                                        <input type="hidden" name="previousAnswers" value="@(Model.Answers.FirstOrDefault()?.Id)" />
                                                        <input id="@(controlId)" name="answerValue" type="text"
                                                               value="@Model.Answers.FirstOrDefault()?.DateTimeValue"
                                                               @if (isMobileDevice)
                                                               {
                                                                   <text> readonly</text>
                                                               }/>
                                                        @if (Model.RegistrationField.IsRequired)
                                                        {
                                                            <nop-required/>
                                                        }
                                                        <span class="field-validation-error" data-valmsg-for="@(controlId)" data-valmsg-replace="true"></span>
                                                        <script>
                                                            $(document).ready(function() {
                                                                $("#@(controlId)").kendoDateTimePicker({
                                                                    popup: {
                                                                        position: "bottom right",
                                                                        origin: "top right"
                                                                    }
                                                                });
                                                                $("#@(controlId)").rules("add",
                                                                    {
                                                                        "validate-datetime": {
                                                                            @if (Model.RegistrationField.IsRequired)
                                                                            {
                                                                                <text>required: true,</text>
                                                                            }
                                                                            format: "@dateTimePickerFormat"
                                                                        },
                                                                        messages: {
                                                                            "validate-datetime": "Please select the date time value from the picker or input the valid format (MM/DD/YYYY HH:mm)"
                                                                        }
                                                                    });
                                                            });
                                                        </script>
                                                        break;
                                                    }
                                                    case RegistrationFieldType.None:
                                                        break;
                                                }
                                                @if (Model.RegistrationField.IsRequired)
                                                {
                                                    if (Model.RegistrationField.Type != RegistrationFieldType.DateOnly &&
                                                        Model.RegistrationField.Type != RegistrationFieldType.DateTime)
                                                    {

                                                        <span class="field-validation-error" data-valmsg-for="@(controlId)" data-valmsg-replace="true"></span>
                                                    }
                                                    <script>
                                                        $(document).ready(function() {
                                                            $("[id^=@(controlId)]").rules("add",
                                                                {
                                                                    required: true,
                                                                    @if (Model.RegistrationField.Type is RegistrationFieldType.SelectDropDown)
                                                                    {
                                                                        <text>min: 1,</text>
                                                                    }
                                                                    messages: {
                                                                        @if (Model.RegistrationField.Type is RegistrationFieldType.SelectDropDown)
                                                                        {
                                                                            <text>min: "This is a required field",</text>
                                                                        }
                                                                        required: "This is a required field"
                                                                    }
                                                                });
                                                        });
                                                    </script>
                                                }
                                            </div>
                                            </text>
                                        }
                                        else
                                        {
                                            <div id="customFieldAnswerPlaceholder"></div>

                                            <script>
                                                $(document).ready(function() {
                                                    loadCustomFieldAnswers();
                                                });

                                                function loadCustomFieldAnswers() {
                                                    var customFieldSystemName = "@Model.RegistrationField.CustomFieldRender";

                                                    var postData = {
                                                        systemName: customFieldSystemName,
                                                        customerId: @Context.Request.Query["customerId"],
                                                        fieldId: @Model.RegistrationField.Id
                                                    };

                                                    addAntiForgeryToken(postData);

                                                    $.ajax({
                                                        cache: false,
                                                        url: "@Url.Action(nameof(RegistrationFieldController.GetEditCustomerAnswersViewUrl), ViewUtilities.GetControllerName<RegistrationFieldController>())",
                                                        data: postData,
                                                        success: function(data, textStatus, jqXHR) {
                                                            displayCustomFieldAnswers(data.url, "#customFieldAnswerPlaceholder");
                                                        },
                                                        error: function(jqXHR, textStatus, errorThrown) {
                                                            $("#customFieldAnswerPlaceholder").html("Failed to load custom field answers!");
                                                        }
                                                    });
                                                };

                                                function displayCustomFieldAnswers(url, placeholderName) {
                                                    $.ajax({
                                                        cache: false,
                                                        url: url,
                                                        dataType: "html",
                                                        success: function(data, textStatus, jqXHR) {
                                                            $(placeholderName).html(data);
                                                        },
                                                        error: function(jqXHR, textStatus, errorThrown) {
                                                            $(placeholderName).html("Failed to load custom field answers content!");
                                                        }
                                                    });
                                                }
                                            </script>
                                        }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
}