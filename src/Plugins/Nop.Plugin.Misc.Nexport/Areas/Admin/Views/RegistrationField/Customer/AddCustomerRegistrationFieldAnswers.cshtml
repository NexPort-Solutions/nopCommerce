@using Nop.Services.Helpers

@inject IUserAgentHelper userAgentHelper

@model Nop.Plugin.Misc.Nexport.Models.RegistrationField.Customer.NexportAddCustomerRegistrationFieldsModel

@{
    Layout = "_AdminPopupLayout";

    ViewBag.Title = "Add customer registration field answers";
}

@if (ViewBag.RefreshPage == true)
{
    <script>
        try {
            window.opener.$("#@(Context.Request.Query["containerId"]) #@(Context.Request.Query["btnId"])").click();
        }
        catch (e) { }
    </script>
}

@if (ViewBag.ClosePage == true)
{
    <script>
        window.close();
    </script>
}

@if (Model != null)
{
    <form id="add-customer-registration-fields-form" method="post"
          asp-action="AddCustomerRegistrationFieldAnswers"
          asp-controller="NexportIntegration"
          asp-route-customerId="@Context.Request.Query["customerId"]"
          asp-route-storeId="@Context.Request.Query["storeId"]"
          asp-route-containerId="@Context.Request.Query["containerId"]"
          asp-route-btnId="@Context.Request.Query["btnId"]">
        <div class="content-header clearfix">
            <div class="pull-right">
                <button type="submit" name="save" class="btn bg-blue" disabled="@(Model.RegistrationFields.Count == 0)">
                    <i class="fa fa-floppy-o"></i>
                    @T("Admin.Common.Save")
                </button>
            </div>
        </div>
        <div class="content">
            <div class="form-horizontal">
                @if (Model.RegistrationFields.Count > 0)
                {
                    <div class="panel-group">
                        <div class="panel panel-default panel-popup">
                            <div class="panel-body">
                                @await Html.PartialAsync("../Customer/_Create.RegistrationFieldAnswer.cshtml", Model)
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <div class="callout callout-info">
                        <span>No registration fields available for this customer!</span>
                    </div>
                }
            </div>
        </div>
    </form>
}