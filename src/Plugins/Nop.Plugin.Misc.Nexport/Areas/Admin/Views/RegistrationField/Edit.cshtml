@using Nop.Plugin.Misc.Nexport.Areas.Admin.Controllers;
@using Nop.Plugin.Misc.Nexport.Extensions;
@model Nop.Plugin.Misc.Nexport.Models.RegistrationField.RegistrationFieldModel

@{
    ViewBag.PageTitle = T("Admin.Customers.Nexport.RegistrationField.Fields.EditFieldDetails").Text;
    NopHtml.SetActiveMenuItemSystemName("Customer and user settings");
}

<form asp-controller="RegistrationField" asp-action="Edit" method="post" id="registrationfield-form">
    <div class="content-header clearfix">
        <h1 class="float-left">
            @T("Admin.Customers.Nexport.RegistrationField.Fields.EditFieldDetails") - @Model.Name
            <small>
                <i class="fas fa-arrow-circle-left"></i>
                <a asp-action="List" asp-controller="RegistrationField">
                    @T("Admin.Customers.Nexport.RegistrationField.Fields.BackToList")
                </a>
            </small>
        </h1>
        <div class="float-right">
            <button type="submit" name="save" class="btn btn-primary">
                <i class="far fa-save"></i>
                @T("Admin.Common.Save")
            </button>
            <button type="submit" name="save-continue" class="btn btn-primary">
                <i class="far fa-save"></i>
                @T("Admin.Common.SaveContinue")
            </button>
            <span id="registrationfield-delete" class="btn bg-red">
                <i class="fa fa-trash-o"></i>
                @T("Admin.Common.Delete")
            </span>
        </div>
    </div>
    @await Html.PartialAsync("~/Plugins/Misc.Nexport/Areas/Admin/Views/RegistrationField/_CreateOrUpdate.cshtml", Model)
</form>
<nop-delete-confirmation asp-model-id="@Model.Id" asp-button-id="registrationfield-delete"
                         asp-controller="RegistrationField" asp-action="Delete" />