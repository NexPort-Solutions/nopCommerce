@using Nop.Plugin.Misc.Nexport.Areas.Admin.Controllers
@using Nop.Plugin.Misc.Nexport.Models
@using Nop.Plugin.Misc.Nexport.Models.RegistrationField
@using Nop.Plugin.Misc.Nexport.Domain.Enums
@using Nop.Plugin.Misc.Nexport.Extensions
@using static Nop.Plugin.Misc.Nexport.Domain.RegistrationField.RegistrationField

@model Nop.Plugin.Misc.Nexport.Models.RegistrationField.SearchModel

@{
    const string hideSearchRegistrationFieldsBlockAttributeName = "ProductPage.HideSearchMappingsBlock";
    var hideSearchRegistrationFieldsBlock = await genericAttributeService.GetAttributeAsync<bool>(await workContext.GetCurrentCustomerAsync(), hideSearchRegistrationFieldsBlockAttributeName);
}

<div class="card card-default">
    <div class="card-header">
        @T("Admin.Customers.Nexport.RegistrationField.Fields")
    </div>
    <div class="card-body">
        <div class="card card-default card-search">
            <div class="card-body">
                <div class="row search-row @(!hideSearchRegistrationFieldsBlock ? "opened" : "")" data-hideAttribute="@hideSearchRegistrationFieldsBlockAttributeName">
                    <div class="search-text">@T("Admin.Common.Search")</div>
                    <div class="icon-search"><i class="fas fa-search" aria-hidden="true"></i></div>
                    <div class="icon-collapse"><i class="far fa-angle-@(!hideSearchRegistrationFieldsBlock ? "up" : "down")" aria-hidden="true"></i></div>
                </div>
                <div class="search-body @(hideSearchRegistrationFieldsBlock ? "closed" : "")">
                    <div class="row">
                        <div class="col-md-5">
                            <div class="form-group row">
                                <div class="col-md-4">
                                    <nop-label asp-for="Model.SelectedStoreIds" />
                                </div>
                                <div class="col-md-8">
                                    <nop-select asp-for="Model.SelectedStoreIds)" asp-items="@Model.AvailableStores" asp-multiple="true" />
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="text-center col-12">
                            <button type="button" id="search-registration-fields" class="btn btn-primary btn-search"><i class="fas fa-search"></i>@T("Admin.Common.Search")</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <p style="display: flex; align-items: center; margin: 0">
            <em>@T("Admin.Customers.Nexport.RegistrationField.Fields.Description")</em>
        </p>
        @await Html.PartialAsync("~/Plugins/Misc.Nexport/Views/Shared/Table.cshtml", new Nop.Plugin.Misc.Nexport.Models.DataTablesModel
        {
            Name = "nexport-registrationfields-grid",
            UrlRead = new DataUrl(nameof(RegistrationFieldController.List), ViewUtilities.GetControllerName<RegistrationFieldController>(), null),
            Filters = new List<FilterParameter>
            {
                new FilterParameter(nameof(Model.SelectedStoreIds))
            },
            SearchButtonId = "search-registration-fields",
            Length = Model.PageSize,
            LengthMenu = Model.AvailablePageSizes,
            ColumnCollection = new List<ColumnProperty>
            {
                new(nameof(RegistrationFieldModel.Name))
                {
                    Title = T("Plugins.Misc.Nexport.RegistrationField.Field.Name").Text,
                    Width = "100"
                },
                new(nameof(RegistrationFieldModel.Type))
                {
                    Title = T("Plugins.Misc.Nexport.RegistrationField.Field.Type").Text,
                    Width = "100",
                    Render = new RenderCustom("renderRegistrationFieldType")
                },
                new(nameof(RegistrationFieldModel.IsActive))
                {
                    Title = T("Plugins.Misc.Nexport.RegistrationField.Field.Active").Text,
                    Width = "200",
                    ClassName = NopColumnClassDefaults.CenterAll,
                    Render = new RenderBoolean()
                },
                new(nameof(RegistrationFieldModel.IsRequired))
                {
                    Title = T("Plugins.Misc.Nexport.RegistrationField.Field.Required").Text,
                    Width = "200",
                    ClassName = NopColumnClassDefaults.CenterAll,
                    Render = new RenderBoolean()
                },
                new(nameof(RegistrationFieldModel.CustomProfileFieldKey))
                {
                    Title = T("Plugins.Misc.Nexport.RegistrationField.Field.CustomProfileFieldKey").Text,
                    Width = "100",
                    ClassName = NopColumnClassDefaults.CenterAll
                },
                new(nameof(RegistrationFieldModel.DisplayOrder))
                {
                    Title = T("Plugins.Misc.Nexport.RegistrationField.Field.DisplayOrder").Text,
                    Width = "100",
                    ClassName = NopColumnClassDefaults.CenterAll
                },
                new(nameof(RegistrationFieldModel.FieldCategoryName))
                {
                    Title = T("Plugins.Misc.Nexport.RegistrationField.Field.Category").Text,
                    Width = "100",
                    ClassName = NopColumnClassDefaults.CenterAll
                },
                new(nameof(RegistrationFieldModel.StoreMappings))
                {
                    Title = T("Plugins.Misc.Nexport.RegistrationField.Field.StoreMappings").Text,
                    Width = "100",
                    ClassName = NopColumnClassDefaults.CenterAll
                },
                new(nameof(RegistrationFieldModel.CustomFieldRenderDescription))
                {
                    Title = T("Plugins.Misc.Nexport.RegistrationField.Field.CustomRender").Text,
                    Width = "100",
                    ClassName = NopColumnClassDefaults.CenterAll
                },
                new(nameof(RegistrationFieldModel.Id))
                {
                    Title = T("Admin.Common.Edit").Text,
                    Width = "100",
                    ClassName = NopColumnClassDefaults.Button,
                    Render = new RenderButtonEdit(new DataUrl("~/Admin/RegistrationField/Edit/"))
                }
            }
        })

        <script>
            function renderRegistrationFieldType(data, type, row, meta) {
                if (data === +"@((int) RegistrationFieldType.Text)") {
                    return "@RegistrationFieldType.Text.GetDisplayName()";
                } else if (data === +"@((int) RegistrationFieldType.DateTime)") {
                    return "@RegistrationFieldType.DateTime.GetDisplayName()";
                } else if (data === +"@((int) RegistrationFieldType.Boolean)") {
                    return "@RegistrationFieldType.Boolean.GetDisplayName()";
                } else if (data === +"@((int) RegistrationFieldType.Numeric)") {
                    return "@RegistrationFieldType.Numeric.GetDisplayName()";
                } else if (data === +"@((int) RegistrationFieldType.Email)") {
                    return "@RegistrationFieldType.Email.GetDisplayName()";
                } else if (data === +"@((int) RegistrationFieldType.SelectDropDown)") {
                    return "@RegistrationFieldType.SelectDropDown.GetDisplayName()";
                } else if (data === +"@((int) RegistrationFieldType.DateOnly)") {
                    return "@RegistrationFieldType.DateOnly.GetDisplayName()";
                } else if (data === +"@((int) RegistrationFieldType.SelectCheckbox)") {
                    return "@RegistrationFieldType.SelectCheckbox.GetDisplayName()";
                } else if (data === +"@((int) RegistrationFieldType.CustomType)") {
                    return "@RegistrationFieldType.CustomType.GetDisplayName()";
                } else if (data === +"@((int) RegistrationFieldType.None)") {
                    return "None";
                } else {
                    return "";
                }
          }
            $(document).ready(function () {
                $("div.search-registration-div").keypress(function (n) {
                    if (n.which == 13 || n.keyCode == 13)
                        return $("#search-registration-fields").click(),
                            !1
                });
            });
    </script>
    </div>
    <div class="card-footer">
        <a class="btn btn-primary" href="@Url.Action("CreateRegistrationField", ViewUtilities.GetControllerName<Integration">
            <i class="fa fa-plus-square"></i>
            @T("Admin.Common.AddNew")
        </a>
    </div>
</div>