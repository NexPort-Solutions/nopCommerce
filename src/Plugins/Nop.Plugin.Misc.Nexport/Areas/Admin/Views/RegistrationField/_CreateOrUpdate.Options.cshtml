@using Nop.Plugin.Misc.Nexport.Areas.Admin.Controllers;
@using Nop.Plugin.Misc.Nexport.Extensions;
@using Nop.Plugin.Misc.Nexport.Models
@using Nop.Plugin.Misc.Nexport.Domain.RegistrationField

@model Nop.Plugin.Misc.Nexport.Models.RegistrationField.RegistrationFieldModel

@if (Model.Id > 0)
{
    <div class="card-body">
        <div class="form-group row" id="allowMultipleSelectionSettingContainer">
            <div class="col-md-3">
                <nop-label asp-for="Model.AllowMultipleSelection" />
            </div>
            <div class="col-md-9">
                <nop-editor asp-for="Model.AllowMultipleSelection" />
                <span asp-validation-for="Model.AllowMultipleSelection)"></span>
            </div>
        </div>
        <div class="form-group row" id="displayOptionByAscendingOrderSettingContainer">
            <div class="col-md-3">
                <nop-label asp-for="Model.DisplayOptionByAscendingOrder" />
            </div>
            <div class="col-md-9">
                <nop-editor asp-for="Model.DisplayOptionByAscendingOrder" />
                <span asp-validation-for="Model.DisplayOptionByAscendingOrder)"></span>
            </div>
        </div>

        <div class="card card-default">
            <div class="card-body">
                @await Html.PartialAsync("~/Plugins/Misc.Nexport/Views/Shared/Table.cshtml", new Nop.Plugin.Misc.Nexport.Models.DataTablesModel
                {
                    Name = "registrationfield-options-grid",
                    UrlRead = new DataUrl(nameof(RegistrationFieldController.ListOptions), ViewUtilities.GetControllerName<RegistrationFieldController>(),
                        new RouteValueDictionary
                        {
                            [nameof(Model.RegistrationFieldOptionSearchModel.RegistrationFieldId)] = Model.RegistrationFieldOptionSearchModel.RegistrationFieldId
                        }),
                    UrlDelete = new DataUrl(nameof(RegistrationFieldController.DeleteOption), ViewUtilities.GetControllerName<RegistrationFieldController>(), null),
                    UrlUpdate = new DataUrl(nameof(RegistrationFieldController.EditOption), ViewUtilities.GetControllerName<RegistrationFieldController>(), null),
                    Length = Model.RegistrationFieldOptionSearchModel.PageSize,
                    LengthMenu = Model.RegistrationFieldOptionSearchModel.AvailablePageSizes,
                    ColumnCollection = new List<ColumnProperty>
                    {
                        new(nameof(Option.OptionValue))
                        {
                            Title = T("Plugins.Misc.Nexport.RegistrationField.Option.Value").Text,
                            Editable = true,
                            EditType = EditType.String
                        },
                        new(nameof(Option.DisplayOrder))
                        {
                            Title = T("Plugins.Misc.Nexport.RegistrationField.Option.DisplayOrder").Text,
                            Editable = true,
                            EditType = EditType.Number
                        },
                        new(nameof(Option.Id))
                        {
                            Title = T("Admin.Common.Edit").Text,
                            Width = "100",
                            ClassName = NopColumnClassDefaults.Button,
                            Render = new RenderButtonsInlineEdit()
                        },
                        new(nameof(CustomerAttributeValueModel.Id))
                        {
                            Title = T("Admin.Common.Delete").Text,
                            Width = "100",
                            Render = new RenderButtonRemove(T("Admin.Common.Delete").Text),
                            ClassName = NopColumnClassDefaults.Button
                        }
                    }
                })
            </div>
        </div>
        <script>
            function renderEditRegistrationFieldOption(data, type, row, meta) {
                return '<button onclick=\"javascript:OpenWindow(\'@Url.Content("~/Admin/RegistrationField/EditOption/")' + data + '?btnId=btnRefresh&formId=registrationfield-form\', 800, 400, true); return false;\" class="btn btn-default"><i class="fa fa-pencil"></i>@T("Admin.Common.Edit")</button>';
            }
        </script>
    </div>
    <div class="card-footer">
        <button type="submit" id="btnAddNewValue" onclick="javascript:OpenWindow('@(Url.Action(nameof(RegistrationFieldController.CreateOption), ViewUtilities.GetControllerName<RegistrationFieldController>(),
                                                                                      new { fieldId = Model.Id, btnId = "btnRefresh", formId = "registrationfield-form" }))', 800, 400, true); return false;" class="btn btn-primary">
            @T("Admin.Customers.Nexport.RegistrationField.Options.AddNew")
        </button>
        <input type="submit" id="btnRefresh" style="display: none" />
        <script>
            $(document).ready(function () {
                $("#btnRefresh").click(function () {
                    updateTable("#registrationfield-options-grid");

                    return false;
                });
            });
        </script>
    </div>
}
else
{
<div class="card-body">
    @T("Admin.Customers.Nexport.RegistrationField.Options.SaveBeforeEdit")
</div>
}