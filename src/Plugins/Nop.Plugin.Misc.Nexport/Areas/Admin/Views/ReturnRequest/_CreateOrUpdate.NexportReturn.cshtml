@model Nop.Plugin.Misc.Nexport.Areas.Admin.Models.ReturnRequest.NexportReturnRequestModel

@inject NexportSettings _nexportSettings

@using Nop.Core.Domain.Orders;
@using Nop.Plugin.Misc.Nexport
@using Nop.Plugin.Misc.Nexport.Domain.Enums
@using Nop.Plugin.Misc.Nexport.Extensions
@using Nop.Services

<div asp-validation-summary="All"></div>
<input asp-for="Id" type="hidden" />

<section class="content">
    <div class="container-fluid">
        <div class="form-horizontal">
            <div class="cards-group">
                @await Component.InvokeAsync(typeof(AdminWidgetViewComponent), new { widgetZone = AdminWidgetZones.ReturnRequestDetailsTop, additionalData = Model })
                <div class="card card-default">
                    <div class="card-body">
                        <div class="form-group row">
                            <div class="col-md-3">
                                <nop-label asp-for="CustomNumber" />
                            </div>
                            <div class="col-md-9">
                                <div class="form-text-row">@Model.CustomNumber</div>
                            </div>
                        </div>
                        <div class="form-group row">
                            <div class="col-md-3">
                                <nop-label asp-for="CustomOrderNumber" />
                            </div>
                            <div class="col-md-9">
                                @if (Model.OrderId > 0)
                                {
                                    <a asp-controller="Order" asp-action="Edit" asp-route-id="@Model.OrderId">@Model.CustomOrderNumber</a>
                                }
                                else
                                {
                                    <text>Order item is deleted</text>
                                }
                            </div>
                        </div>
                        <div class="form-group row">
                            <div class="col-md-3">
                                <nop-label asp-for="CustomerId" />
                            </div>
                            <div class="col-md-9">
                                <a asp-controller="Customer" asp-action="Edit" asp-route-id="@Model.CustomerId">@Model.CustomerInfo</a>
                                @if (!string.IsNullOrWhiteSpace(Model.RequestUserNexportProfileLink))
                                {
                                    <text> (<a href="@Model.RequestUserNexportProfileLink" target="_blank">View Nexport profile</a>)</text>
                                }
                            </div>
                        </div>
                        @if (Model.IsNexportWholesalePurchase && Model.AssignedUserNexportId != null)
                        {
                            <div class="form-group row">
                                <div class="col-md-3">
                                    <nop-label asp-for="AssignedUserNexportId" />
                                </div>
                                <div class="col-md-9">
                                    <a asp-controller="Customer" asp-action="Edit" asp-route-id="@Model.AssignedUserCustomerId">@Model.AssignedUserInfo</a>
                                    @if (!string.IsNullOrWhiteSpace(Model.AssignedUserNexportProfileLink))
                                    {
                                        <text> (<a href="@Model.AssignedUserNexportProfileLink" target="_blank">View Nexport profile</a>)</text>
                                    }
                                </div>
                            </div>
                        }
                        <div class="form-group row">
                            <div class="col-md-3">
                                <nop-label asp-for="ProductName" />
                            </div>
                            <div class="col-md-9">
                                @if (Model.ProductId > 0)
                                {
                                    <a asp-controller="Product" asp-action="Edit" asp-route-id="@Model.ProductId">@Model.ProductName</a>
                                }
                                else
                                {
                                    <text>Order item is deleted</text>
                                }
                            </div>
                        </div>
                        <div class="form-group row">
                            <div class="col-md-3">
                                <nop-label asp-for="Quantity" />
                            </div>
                            <div class="col-md-9">
                                <div class="form-text-row">@Model.Quantity</div>
                                @Html.HiddenFor(x => x.Quantity)
                                @* <nop-editor asp-for="Quantity" />
                                <span asp-validation-for="Quantity"></span> *@
                            </div>
                        </div>
                        @if (!Model.IsNexportPurchase)
                        {
                            <div class="form-group row">
                                <div class="col-md-3">
                                    <nop-label asp-for="ReturnedQuantity" />
                                </div>
                                <div class="col-md-9">
                                    <nop-editor asp-for="ReturnedQuantity" />
                                    <span asp-validation-for="ReturnedQuantity"></span>
                                </div>
                            </div>
                        }
                        <div class="form-group row">
                            <div class="col-md-3">
                                <nop-label asp-for="ReturnRequestStatusId" />
                            </div>
                            <div class="col-md-9">
                                <div class="form-text-row">@Model.ReturnRequestStatusStr</div>
                            </div>
                        </div>
                        <div class="form-group row">
                            <div class="col-md-3">
                                <nop-label asp-for="ReasonForReturn" />
                            </div>
                            <div class="col-md-9">
                                <div class="form-text-row">@Model.ReasonForReturn</div>
                                @Html.HiddenFor(x => x.ReasonForReturn)
                                @* <nop-editor asp-for="ReasonForReturn" asp-required="true" />
                                <span asp-validation-for="ReasonForReturn"></span> *@
                            </div>
                        </div>
                        <div class="form-group row">
                            <div class="col-md-3">
                                <nop-label asp-for="RequestedAction" />
                            </div>
                            <div class="col-md-9">
                                <div class="form-text-row">@Model.RequestedAction</div>
                                @Html.HiddenFor(x => x.RequestedAction)
                                @* <nop-editor asp-for="RequestedAction" asp-required="true" />
                                <span asp-validation-for="RequestedAction"></span> *@
                            </div>
                        </div>
                        @if (Model.UploadedFileGuid != Guid.Empty)
                        {
                            <div class="form-group row">
                                <div class="col-md-3">
                                    <nop-label asp-for="UploadedFileGuid" />
                                </div>
                                <div class="col-md-9">
                                    <a asp-controller="Download" asp-action="DownloadFile" asp-route-downloadGuid="@Model.UploadedFileGuid">@T("Admin.ReturnRequests.Fields.UploadedFile.Download")</a>
                                </div>
                            </div>
                        }
                        <div class="form-group row">
                            <div class="col-md-3">
                                <nop-label asp-for="CustomerComments" />
                            </div>
                            <div class="col-md-9">
                                <div class="form-text-row">@Model.CustomerComments</div>
                                @Html.HiddenFor(x => x.CustomerComments)
                                @* <nop-textarea asp-for="CustomerComments" />
                                <span asp-validation-for="CustomerComments"></span> *@
                            </div>
                        </div>
                        <div class="form-group row">
                            <div class="col-md-3">
                                <nop-label asp-for="StaffNotes" />
                            </div>
                            <div class="col-md-9">
                                @if (Model.ReturnRequestStatusId != (int)ReturnRequestStatus.Pending)
                                {
                                    <div class="form-text-row">@Model.StaffNotes</div>
                                }
                                else
                                {
                                    <nop-textarea asp-for="StaffNotes" />
                                    <span asp-validation-for="StaffNotes"></span>
                                }
                            </div>
                        </div>
                        <div class="form-group row">
                            <div class="col-md-3">
                                <nop-label asp-for="CreatedOn" />
                            </div>
                            <div class="col-md-9">
                                <div class="form-text-row">@Model.CreatedOn</div>
                            </div>
                        </div>
                        @if (Model.IsNexportWholesalePurchase)
                        {
                            <div class="form-group row">
                                <div class="col-md-3">
                                    <nop-label asp-for="RefundOption" />
                                </div>
                                <div class="col-md-9">
                                    @if (Model.ReturnRequestStatusId != (int)ReturnRequestStatus.Pending)
                                    {
                                        <nop-select asp-for="RefundOption" asp-items="@(await ((NexportRefundOptionEnums)Model.RefundOption).ToSelectListAsync())" disabled />
                                    }
                                    else
                                    {
                                        <nop-select asp-for="RefundOption" asp-items="@(await ((NexportRefundOptionEnums)Model.RefundOption).ToSelectListAsync())" class="disabled" />
                                        <span asp-validation-for="RefundOption"></span>
                                    }
                                </div>
                            </div>
                        }
                        @if (Model.HasPaymentMethod)
                        {
                            <div class="form-group">
                                <div class="col-md-3">
                                </div>
                                <div class="col-md-9 offset-md-3">
                                    <div class="form-text-row text-warning">
                                        @T("Plugins.Misc.Nexport.InvoiceItemRefund.Request.ExternalSystemWarning")
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
                @await Component.InvokeAsync(typeof(AdminWidgetViewComponent), new { widgetZone = AdminWidgetZones.ReturnRequestDetailsBottom, additionalData = Model })
            </div>
        </div>
    </div>
</section>