@model Nop.Plugin.Misc.Nexport.Models.ProductMappings.DuplicateNexportProductMappingModel

@{
    Layout = "_AdminPopupLayout";

    ViewBag.Title = "Duplicate product mappings";
}

@if (ViewBag.RefreshPage == true)
{
    <script>
        try {
            window.opener.$("#@(Context.Request.Query["containerId"]) #@(Context.Request.Query["btnId"])").click();
        }
        catch (e) { }
    </script>
}

@if (ViewBag.ClosePage == true)
{
    <script>
        window.close();
    </script>
}

@if (Model != null)
{
    <form id="add-customer-registration-fields-form" method="post"
      asp-action="DuplicateProductMapping"
      asp-controller="NexportIntegration"
      asp-route-productId="@Context.Request.Query["productId"]"
      asp-route-containerId="@Context.Request.Query["containerId"]"
      asp-route-btnId="@Context.Request.Query["btnId"]">
        <div class="content-header clearfix">
            <div class="pull-right">
                <button type="submit" name="save" class="btn bg-blue">
                    <i class="fa fa-floppy-o"></i>
                    @T("Admin.Common.Save")
                </button>
            </div>
        </div>
        <div class="content">
            <div class="form-horizontal">
                <div class="panel-group">
                    <div class="panel panel-default panel-popup">
                        <div class="panel-body">
                            <p style="color: red;">
                                * Note: The duplication process will only copy the current product mapping information as well as the group memberships associated with
                                that mapping. Any other information (Supplemental question mapping, etc.) will not be copied over.
                            </p>
                            <div class="form-group">
                                <div class="col-xs-12 col-sm-3">
                                    <nop-label asp-for="SourceStoreId" />
                                </div>
                                <div class="col-xs-12 col-sm-9">
                                    <nop-select asp-for="SourceStoreId" asp-items="Model.AvailableStores" asp-multiple="false" />
                                </div>
                            </div>
                            <div class="form-group">
                                <div class="col-xs-12 col-sm-3">
                                    <nop-label asp-for="DestinationStoreIds" />
                                </div>
                                <div class="col-xs-12 col-sm-9">
                                    <nop-select asp-for="DestinationStoreIds" asp-items="Model.DestinationStores" asp-multiple="true" />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
}