@using Nop.Plugin.Misc.Nexport.Areas.Admin.Models.Orders
@model NextportWholesaleOrderCreationResponse

<section class="content">
    <section class="container-fluid">
        <div class="form-horizontal">
            <div class="cards-group">
                <div class="card card-default card-search">
                    <div class="card-body">
                        <div class="col-md-8">
                            <a class="btn bg-green" asp-controller="Wholesale" asp-action="Create" asp-route-id="@Model.Id">@T("Plugins.Misc.Nexport.Wholesale.Create")</a>
                        </div>
                        <div class="col-md-8">
                            <a class="btn bg-green" asp-controller="Order" asp-action="List" asp-route-id="@Model.Id">@T("Admin.Dashboard.LatestOrders.ViewAll")</a>
                        </div>
                        <div class="col-md-8">
                            <a class="btn bg-green" asp-controller="Order" asp-action="Edit" asp-route-id="@Model.Id">@T("Plugins.Misc.Nexport.Wholesale.Go")</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</section>
