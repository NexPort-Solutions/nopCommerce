@using Nop.Plugin.Misc.Nexport.Areas.Admin.Controllers
@using Nop.Plugin.Misc.Nexport.Areas.Admin.Models.Orders
@using Nop.Plugin.Misc.Nexport.Areas.Admin.Models.Wholesale
@using Nop.Plugin.Misc.Nexport.Extensions
@using Nop.Services.Catalog

@inject IProductService product

@model WholesaleCreateModel

@{
    var currentProduct = await product.GetProductByIdAsync(Model.ProductId);
    var productName = currentProduct.Name;
}

<div asp-validation-summary="All"></div>
@* <input asp-for="Id" type="hidden" /> *@

<div class="content">
    <div class="form-horizontal">
        <div class="card-group">
            <div class="card card-default">
                <div class="card-body">
                    <div class="form-group row">
                        <div class="col-md-4">
                            <nop-label asp-for="StoreId"></nop-label>
                        </div>
                        <div class="col-md-8">
                            <input id="search-store-friendly" type="text" autocomplete="on" class="form-control" />
                            @Html.TextBoxFor(model => model.StoreId, new { style = "display:none" })
                            <script>
                                $(document).ready(function () {
                                    $('#search-store-friendly').autocomplete({
                                        delay: 0,
                                        minLength: 0,
                                        source: '@Url.Action(nameof(WholesaleController.SearchStores), ViewUtilities.GetControllerName<WholesaleController>())',
                                        select: function (event, ui) {
                                            console.log(ui);
                                            $('#search-store-friendly').val(ui.item.label);
                                            $('#@Html.IdFor(model => model.StoreId)').val(ui.item.value);
                                            return false;
                                        }
                                    });
                                });
                            </script>
                        </div>
                    </div>
                    <div class="form-group row">
                        <div class="col-md-4">
                            <nop-label asp-for="ProductId"></nop-label>
                        </div>
                        <div class="col-md-8">
                            <input id="search-product-friendly" type="text" autocomplete="on" class="form-control" required="" value="@productName" />
                            @Html.TextBoxFor(model => model.ProductId, new { style = "display:none" })
                            <script>
                                $(document).ready(function () {
                                    $('#search-product-friendly').autocomplete({
                                        delay: 0,
                                        minLength: 0,
                                        source: '@Url.Action(nameof(WholesaleController.SearchProducts), ViewUtilities.GetControllerName<WholesaleController>())',
                                        select: function (event, ui) {
                                            console.log(ui);
                                            $('#search-product-friendly').val(ui.item.label);
                                            $('#@Html.IdFor(model => model.ProductId)').val(ui.item.value);
                                            return false;
                                        }
                                    });
                                });
                            </script>
                        </div>
                    </div>
                    <div class="form-group row">
                        <div class="col-md-4">
                            <nop-label asp-for="RedeemByUtc"></nop-label>
                        </div>
                        <div class="col-md-8">
                            <nop-editor style="display: inline;" asp-for="RedeemByUtc" asp-required="" html-attributes="@(new { value = DateTime.UtcNow.Date.ToShortDateString() })" />
                        </div>
                    </div>
                    <div class="form-group row">
                        <div class="col-md-4">
                            <nop-label asp-for="IsRedemptionPeriodUnlimited"></nop-label>
                        </div>
                        <div class="col-md-8">
                            @Html.CheckBoxFor(model => model.IsRedemptionPeriodUnlimited,  new { onchange = " onRedeemByCheckboxValueChanged();" })
                        </div>
                    </div>
                    <div class="form-group row">
                        <div class="col-md-4">
                            <nop-label asp-for="FundingPoolId"></nop-label>
                        </div>
                        <div class="col-md-8">
                            <input id="search-funding-pool-friendly" type="text" autocomplete="on" class="form-control" required="" />
                            @Html.TextBoxFor(model => model.FundingPoolId, new { style = "display:none" })
                            <script>
                                $(document).ready(function () {
                                    $('#search-funding-pool-friendly').autocomplete({
                                        delay: 0,
                                        minLength: 0,
                                        source: '@Url.Action(nameof(FundingPoolController.Search), ViewUtilities.GetControllerName<FundingPoolController>())',
                                        select: function (event, ui) {
                                            console.log(ui);
                                            $('#search-funding-pool-friendly').val(ui.item.label);
                                            $('#@Html.IdFor(model => model.FundingPoolId)').val(ui.item.value);
                                            return false;
                                        }
                                    });
                                });
                            </script>
                        </div>
                    </div>
                    <div class="form-group row">
                        <div class="col-md-4">
                            <nop-label asp-for="AgentId"></nop-label>
                        </div>
                        <div class="col-md-8">
                            <input id="search-agent-friendly" type="text" autocomplete="on" class="form-control" disabled />
                            @Html.TextBoxFor(model => model.AgentId, new { style = "display:none" })
                            <script>
                                $(document).ready(function () {
                                    $('#search-agent-friendly').autocomplete({
                                        delay: 0,
                                        minLength: 0,
                                        source: '@Url.Action(nameof(WholesaleController.SearchPurchasingAgents), ViewUtilities.GetControllerName<WholesaleController>())',
                                        select: function (event, ui) {
                                            console.log(ui);
                                            $('#search-agent-friendly').val(ui.item.label);
                                            $('#@Html.IdFor(model => model.AgentId)').val(ui.item.value);
                                            return false;
                                        }
                                    });
                                });
                            </script>
                        </div>
                    </div>
                    <div class="form-group row">
                        <div class="col-md-4">
                            <nop-label asp-for="GroupId"></nop-label>
                        </div>
                        <div class="col-md-8">
                            <input id="search-group-friendly" type="text" autocomplete="on" class="form-control" />
                            @Html.TextBoxFor(model => model.GroupId, new { style = "display:none" })
                            <script>
                                $(document).ready(function () {
                                    $('#search-group-friendly').autocomplete({
                                        delay: 0,
                                        minLength: 0,
                                        source: '@Url.Action(nameof(WholesaleController.SearchOrganizations), ViewUtilities.GetControllerName<WholesaleController>())',
                                        select: function (event, ui) {
                                            console.log(ui);
                                            $('#search-group-friendly').val(ui.item.label);
                                            $('#@Html.IdFor(model => model.GroupId)').val(ui.item.value);
                                            return false;
                                        }
                                    });
                                });
                            </script>
                        </div>
                    </div>
                    <div class="form-group row">
                        <div class="col-md-4">
                            <nop-label asp-for="Quantity"></nop-label>
                        </div>
                        <div class="col-md-8">
                            <nop-editor style="display: inline;" asp-for="Quantity"/>
                        </div>
                    </div>
                    <div class="form-group row">
                        <div class="col-md-4">
                            <nop-label asp-for="PaymentMethod"></nop-label>
                        </div>
                        <div class="col-md-8">
                            <input id="search-payment-friendly" type="text" autocomplete="on" class="form-control" />
                            @Html.TextBoxFor(model => model.PaymentMethod, new { style = "display:none" })
                            <script>
                                $(document).ready(function () {
                                    $('#search-payment-friendly').autocomplete({
                                        delay: 0,
                                        minLength: 0,
                                        source: '@Url.Action(nameof(WholesaleController.SearchPurchasingAgents), ViewUtilities.GetControllerName<WholesaleController>())',
                                        select: function (event, ui) {
                                            console.log(ui);
                                            $('#search-payment-friendly').val(ui.item.label);
                                            $('#@Html.IdFor(model => model.PaymentMethod)').val(ui.item.value);
                                            return false;
                                        }
                                    });
                                });
                            </script>
                        </div>
                    </div>
                    <button class="bg-green btn float-left" id="create-submit" type="submit" disabled onclick="this.disabled = true;">Place Order</button>
                    <script type="text/javascript">
                        const storeInput = $('#@Html.IdFor(model => model.StoreId)');
                        const productInput = $('#@Html.IdFor(model => model.ProductId)');
                        const redeemByInput = $('#@Html.IdFor(model => model.RedeemByUtc)');
                        const redeemByCheckboxInput = $('#@Html.IdFor(model => model.IsRedemptionPeriodUnlimited)');
                        const agentInput = $('#@Html.IdFor(model => model.AgentId)');
                        const groupInput = $('#@Html.IdFor(model => model.GroupId)');
                        const quantityInput = $('#@Html.IdFor(model => model.Quantity)');
                        const paymentMethodInput = $('#@Html.IdFor(model => model.PaymentMethod)');
                        const submitButton = $('#create-submit')
                                        
                        function onRedeemByCheckboxValueChanged() {
                            var isChecked = !redeemByCheckboxInput.is(':checked');
                            redeemByInput.data("kendoDatePicker").enable(isChecked);
                            if (isChecked)
                                redeemByInput.val(null);
                        }
                                        
                        function checkValidForm() {
                            var isValid = (storeInput.val() != ""
                                && productInput.val() != ""
                                && (redeemByInput.val() != 0 || redeemByCheckboxInput.val() != "off")
                                && agentInput.val() != ""
                                && groupInput.val() != ""
                                && quantityInput.val() != 0
                                && paymentMethodInput.val() != 0);
                            submitButton.prop("disabled", !isValid);
                            var isReadyToChooseAgent = (storeInput.val() != ""
                                && productInput.val() != "");
                            $('#search-agent-friendly').prop("disabled", !isReadyToChooseAgent);
                        }
                    </script>
                </div>
            </div>
        </div>
    </div>
</div>