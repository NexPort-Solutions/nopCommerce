@using Nop.Web.Framework.Models.DataTables
@using Nop.Web.Areas.Admin.Models.Customers

@model Nop.Plugin.Sale.PurchaseForCustomer.Models.PurchaseForCustomerOrderModel

@inject IProductService productService

@{
    Layout = "_AdminPopupLayout";

    ViewBag.PageTitle = "Purchase product for customers";

    var product = await productService.GetProductByIdAsync(Model.ProductId);

    var purchaseForCustomersColumns = new List<ColumnProperty>
    {
        new(nameof(CustomerModel.Id))
        {
            Width = "30",
            Render = new RenderCustom("customerDelBtn")
        },
        new(nameof(CustomerModel.FullName))
        {
            Title = "Purchase for Customers",
            Render = new RenderCustom("nameAndEmail")
        }
    };

    var purchaseForCustomersTable = new DataTablesModel
    {
        Name = "purchase-for-customers-grid",
        ServerSide = false,
        Paging = true,
        Length = 5,
        Data = "local_available_customers",
        ColumnCollection = purchaseForCustomersColumns
    };
}

@if (ViewBag.RefreshPage == true)
{
    var orderMessage = ViewBag.OrderResultMessage as string;
    <script>
        @if (!string.IsNullOrWhiteSpace(orderMessage))
        {
            <text>alert("@orderMessage"); </text>
        }

        window.close();
    </script>
}
else
{
    <form asp-controller="PurchaseForCustomer" asp-action="PurchaseForCustomer"
          asp-route-productId="@Context.Request.Query["productId"]">
        <div class="content-header clearfix">
            <h1 class="float-left">
                Purchase for customers
            </h1>
            <div class="float-right">
                <button type="submit" name="purchase" class="btn bg-blue">
                    <i class="far fa-save"></i>
                    Purchase
                </button>
            </div>
        </div>

        <div class="content">
            <div class="form-horizontal">
                <div class="cards-group">
                    <div class="card card-default card-search card-popup">
                        <div class="card-body">
                            <div>
                                <div class="form-group row">
                                    <div class="col-sm-3 col-md-3">
                                        <nop-label asp-for="CustomerIds" />
                                    </div>
                                    <div class="col-sm-9 col-md-9">
                                        <input type="text" id="search-customer-name-email" autocomplete="off" class="form-control" />
                                        <div id="purchasing_customer_list_container">
                                            @await Html.PartialAsync("Table", purchaseForCustomersTable)
                                        </div>
                                    </div>
                                </div>
                                <div class="form-group row">
                                    <div class="col-sm-3">
                                        <nop-label asp-for="StoreId" />
                                    </div>
                                    <div class="col-sm-9">
                                        <nop-select asp-for="StoreId" asp-items="Model.AvailableStores" asp-required="true" />
                                        <span asp-validation-for="StoreId"></span>
                                    </div>
                                </div>
                                @if (product.Price > 0.0M)
                                {
                                    <div class="form-group row">
                                        <div class="col-sm-3">
                                            <nop-label asp-for="MarkOrderAsPaid" />
                                        </div>
                                        <div class="col-sm-9">
                                            <nop-editor asp-for="MarkOrderAsPaid" />
                                            <span asp-validation-for="MarkOrderAsPaid"></span>
                                        </div>
                                    </div>
                                }
                                <div class="form-group row">
                                    <div class="col-sm-3">
                                        <nop-label asp-for="StartDate" />
                                    </div>
                                    <div class="col-sm-9">
                                        <nop-editor asp-for="StartDate" />
                                        <span asp-validation-for="StartDate"></span>
                                    </div>
                                </div>
                                <div class="form-group row">
                                    <div class="col-sm-3">
                                        <nop-label asp-for="NotifyCustomer" />
                                    </div>
                                    <div class="col-sm-9">
                                        <nop-editor asp-for="NotifyCustomer" />
                                        <span asp-validation-for="NotifyCustomer"></span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
    <script>
        var local_available_customers = [];

        function nameAndEmail(data, type, row, meta) {
            if (!data)
                return "";

            return data + " (" + row.Email + ")" + '<input name="CustomerIds" value="' + row.Id + '" hidden/>';
        }

        function customerDelBtn(data, type, row, meta) {
            if (!data)
                return "";

            var delBtn = '<button id="customer_del_' + row.Id + '" data-customer-id="' + row.Id + '" class="btn btn-default del-btn" type="button"><i style="padding-right:0px;color:red" class="fas fa-trash"></i></button>';
            return delBtn;
        }

        $(document).ready(function () {
            $("#purchasing_customer_list_container").hide();

            $("#purchase-for-customers-grid").on("click", ".del-btn", function () {
                var purchaseForCustomersDataTable = $("#purchase-for-customers-grid").DataTable();
                var purchaseForCustomersRow = purchaseForCustomersDataTable.row($(this).parents("tr"));

                purchaseForCustomersDataTable.row(purchaseForCustomersRow).remove().draw();

                if ($("#purchase-for-customers-grid td.dataTables_empty").length) {
                    $("#purchasing_customer_list_container").hide();
                }
            });

            $('#search-customer-name-email').autocomplete({
                delay: 500,
                minLength: 3,
                source: '@Url.Action("SearchCustomers", "PurchaseForCustomer")',
                select: function (event, ui) {
                    if (!$("#customer_del_" + ui.item.customer.Id).length) {
                        //local_available_customers.push(ui.item.customer);

                        if ($("#purchasing_customer_list_container").is(":hidden"))
                            $("#purchasing_customer_list_container").show();

                        var purchaseForCustomersDataTable = $("#purchase-for-customers-grid").DataTable();
                        purchaseForCustomersDataTable.row.add(ui.item.customer).columns.adjust().draw();
                    }
                    $("#search-customer-name-email").val("");
                    event.preventDefault();
                }
            });
        });
    </script>
}